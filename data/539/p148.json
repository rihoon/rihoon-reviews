,"s":"6792477094","p":["https://phinf.pstatic.net/checkout.phinf/20220802_181/1659449702853g9UQq_JPEG/1659449688398.jpg"]},{"r":5,"d":"2022-08-02","a":"llza*****","t":"운동하거나 공부할때 쓰기 좋은거 같아요","h":0,"b":false,"s":"6792477094","p":["https://phinf.pstatic.net/checkout.phinf/20220802_112/1659450112826f1WG1_JPEG/1659450078015.jpg"]},{"r":5,"d":"2022-08-02","a":"ice9*****","t":"좋아요～～～～～～～","h":0,"b":false,"s":"6792477094"}]