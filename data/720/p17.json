[{"r":5,"d":"2025-11-28","a":"legn*****","t":"아이 선물로 줬는데 참 좋아해요 받자마자 바로 열심히 해보네요","h":0,"b":false,"s":"10215142360","p":["photos/720/945cf5adb2e1.jpg"]},{"r":5,"d":"2025-11-25","a":"fhfp*****","t":"재구매 상품입니다.","h":0,"b":false,"s":"10215142360","p":["photos/720/0b85b1805845.jpg"]},{"r":5,"d":"2025-11-24","a":"momf*****","t":"내감정돌아보기용으로 주문했어요\n날짜가표기되어있지않아서 쓰고싶은날쓰면되니 좋네요","h":0,"b":false,"s":"10215142360","p":["photos/720/cf9cff754f15.jpg"]},{"r":5,"d":"2025-11-23","a":"gy****","t":"엄마가 잘쓰고있어욜ㄹ","h":0,"b":false,"s":"10215142360","p":["photos/720/9ab6460a2336.jpg"]},{"r":5,"d":"2025-11-21","a":"bani****","t":"기대이상이에요! 상담 받다가 상담사 선생님께서 감정 읽기 작성을 추천해주셔서 구매했습니다.\n\n여기저기 알아봤지만 생각보다 고를 수 있는 선택지가 많지 않았는데 여기 제품 가장 구성이 알면서도 한 섹션의 양이 너무적지 않아서(100일 분량) 이 제품으로 고르게 되었어요. \n\n제품 디자인도 선택을 하는데 영향을 미쳤는데 약간 네이버페이 감성의 색감(ㅋㅋㅋ)으로 세련되었어요. 또 검은색 표지가 묘하게 프라이빗한 느낌을 줘서 마음에 들었습니다. 동봉된 감정스티커도 잘 쓸게요!","h":0,"b":true,"s":"10215142360","p":["photos/720/ce245853a2a1.jpg","photos/720/69975d94c7e4.jpg"]},{"r":5,"d":"2025-11-19","a":"smyo*****","t":"선물용으로 구매했어요","h":0,"b":false,"s":"10215142360","p":["photos/720/ffa71ef161a8.jpg"]},{"r":5,"d":"2025-11-16","a":"ejqm********","t":"내용 알차거 너무 좋습니다.","h":0,"b":false,"s":"10215142360"},{"r":5,"d":"2025-11-15","a":"boli******","t":"아이가 좋아합니다. 무엇보다 배송이 빨라 좋았습니다. 감사합니다. 저도  흥미가 생깁니다.","h":0,"b":false,"s":"10215142360"},{"r":5,"d":"2025-11-11","a":"kkj1****","t":"우울증 치료 1년째 인데요\n이 일기장 아주 좋을거 같아요\n내 감정을 하루하루 작성하규\n또 한달 두달을 쉽게 돌아볼수 있는 그런 장점이 있는거 같아요","h":0,"b":false,"s":"10215142360","p":["photos/720/ad785d01a515.jpg"]},{"r":5,"d":"2025-11-11","a":"aust***","t":"좋지 뭐여 그까이꺼 대충 뭐시기 거시기","h":0,"b":false,"s":"10215142360"}]