[{"r":5,"d":"2025-07-23","a":"3527******","t":"🤍감정기록이 주는 위로와 힐링🤍\n\n요즘 하루가 정신없이 흘러가다 보니 ‘내가 오늘 어떤 감정을 느꼈더라?’ 하고 되돌아볼 겨를도 없더라고요.\n작은 기록이 큰 위로가 된다는 말, ‘리훈 오늘기억 감정일기’를 사용하면서 많이 느끼게 되었어요✨️👍\n\n화이트 컬러를 선택했는데, 코팅 표지도 너무 깔끔한 디자인이라 맘에들더라고요ㅎ\n그날의 나를 고르고, 감정 컬러코드에 맞춰 하루를 채워가는 구성이라 감정을 들여다보고 다스리는 데 정말 큰 도움이 되었어요!\n\n🤍추천대상\n- 감정을 다스리고 싶은 분\n- 감정기복이 심한 시기를 겪고 있는 분\n- 꾸준한 기록 습관을 만들고 싶은 분\n- 아이나 가족과 감정을 나누고 싶은 분\n- 감성적인 다이어리를 찾고 계신 분","h":1,"b":true,"s":"10215142360","p":["photos/720/2b16ba28dd71.jpg","photos/720/fca57c08037e.jpg","photos/720/f5e4c59426e5.jpg","photos/720/8919b3bcbf29.jpg","photos/720/894fc430e427.jpg","photos/720/c58fdfe03277.jpg"]},{"r":5,"d":"2025-07-21","a":"joar***","t":"오~~. 좋아요 잘 써볼게요ㅎㅎ","h":0,"b":true,"s":"10215142360","p":["photos/720/7cc683e4cdcb.jpg"]},{"r":5,"d":"2025-07-21","a":"ddal******","t":"배송도 빠르고 만족합니다.","h":0,"b":false,"s":"10215142360"},{"r":5,"d":"2025-07-21","a":"soon*****","t":"동생 선물 했는데 동생이 아직까지 잘 쓰고 있다고해서 좋아요~","h":0,"b":false,"s":"10215142360"},{"r":5,"d":"2025-07-20","a":"eude****","t":"감정일기만 따로 작성해보려 아이디어 수집 차원에서 구매.","h":0,"b":false,"s":"10215142360"},{"r":5,"d":"2025-07-19","a":"oasi*****","t":"딸아이와 하나씩 다꾸하듯 한번 해보려구요.","h":0,"b":true,"s":"10215142360","p":["photos/720/d3835842da6f.jpg"]},{"r":5,"d":"2025-07-19","a":"oasi*****","t":"선물하나 개인적으로 하나.\n모두만족입니다","h":0,"b":true,"s":"10215142360","p":["photos/720/2976f9786013.jpg"]},{"r":3,"d":"2025-07-18","a":"jeen******","t":"제본상태가 좋지 않아 속지가 부착이 약해보입니다. 겉표지가 고급지고, 무광에 고무 느낌이라 먼지가 묻을까 아까워서~~^^;; 막 쓰기 어렵네요.ㅋ","h":0,"b":false,"s":"10215142360"},{"r":5,"d":"2025-07-17","a":"thdu******","t":"디자인도 예쁘고 좋아요","h":0,"b":true,"s":"10215142360","p":["photos/720/2cbb1d3706bf.jpg"]},{"r":5,"d":"2025-07-16","a":"sion****","t":"색도 예쁘고 좋습니다!!","h":0,"b":false,"s":"10215142360"}]