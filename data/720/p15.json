[{"r":5,"d":"2025-12-24","a":"ken0******","t":"색감이 은은한 초록톤이라 보기만 해도 마음이 차분해져요. 전체적으로 디자인이 과하지 않고 깔끔해서 매일 꺼내 쓰기 부담 없어요. 구성도 생각보다 굉장히 알차서 기록할 공간이 충분하고, 페이지마다 흐름이 잘 짜여 있어서 자연스럽게 감정을 정리하게 됩니다.\n특히 좋았던 점은 감정 단어가 함께 표기되어 있다는 것이에요. 막연하게 “기분이 안 좋다”에서 끝나는 게 아니라, 감정 단어들을 보면서 아 지금 내가 느끼는 게 이거구나 하고 인지하게 도와줘서 감정 정리에 큰 도움이 됐어요. 감정 표현이 서툰 사람이나 하루를 돌아보는 연습을 하고 싶은 분들께 정말 잘 맞을 것 같아요.\n색감, 구성, 실용성까지 다 갖춘 감정 기록 노트라 꾸준히 써보고 싶다는 생각이 들었습니다.","h":0,"b":false,"s":"10215142360","p":["photos/720/18b654292b02.jpg","photos/720/8fc536458b15.jpg","photos/720/0ea94d3e3915.jpg","photos/720/3abdd443ca1e.jpg","photos/720/be9bf8e3966d.jpg","photos/720/988e446af309.jpg"]},{"r":5,"d":"2025-12-20","a":"mimi******","t":"배송도빠르고 예뻐요 잘쓰도록할게요","h":0,"b":false,"s":"10215142360"},{"r":5,"d":"2025-12-18","a":"dana****","t":"스터디플래너 구입하면서 함께 구입했어요\n아이가 너무 좋아하네요","h":0,"b":false,"s":"10215142360","p":["photos/720/d86c8ea67db9.jpg"]},{"r":5,"d":"2025-12-11","a":"blue********","t":"이쁩니다 이뻐요 그리고 재밌어요","h":0,"b":false,"s":"10215142360","p":["photos/720/13bfa1020821.jpg"]},{"r":5,"d":"2025-12-11","a":"happ****","t":"5년일기장 구입하고 맘에 들어 이 제픔도 구입했어요~ 잘 시용해볼게요.","h":0,"b":false,"s":"10215142360","p":["photos/720/dfd8f895c289.jpg"]},{"r":5,"d":"2025-12-11","a":"happ****","t":"5년일기장 구입하고 맘에 들어 이 제픔도 구입했어요~ 잘 시용해볼게요.","h":0,"b":false,"s":"10215142360","p":["photos/720/62f429a00f1c.jpg"]},{"r":5,"d":"2025-12-10","a":"devi*****","t":"가격에 비해 아주좋아요","h":0,"b":false,"s":"10215142360"},{"r":5,"d":"2025-12-10","a":"hyun******","t":"100일동안 열심히 한번 써 볼려구요~~","h":0,"b":false,"s":"10215142360","p":["photos/720/e408de6574b6.jpg"]},{"r":4,"d":"2025-12-07","a":"dusw*****","t":"감정 컨트롤 하고싶어서 사봤습니다. 열심히 작성해볼게요","h":0,"b":false,"s":"10215142360"},{"r":3,"d":"2025-12-06","a":"qtbo******","t":"사이즈는 생각보다 크네요^^\n꾸준히 써보려합니다~~","h":0,"b":false,"s":"10215142360","p":["photos/720/ca30860d3c48.jpg","photos/720/852b69dd5739.jpg","photos/720/da7c0146284c.jpg"]}]