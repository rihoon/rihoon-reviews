[{"r":4,"d":"2026-05-10","a":"rini***","t":"아들 사용하려고샀는데 구성은 알찬데 잘 안써져서 속상하네요 부지런히 노력해야겠어요","h":0,"b":false,"s":"12926797827"},{"r":5,"d":"2026-05-10","a":"funn****","t":"초저 유치원생 다가능합니다 유치원생은 조금 어려워하네요","h":0,"b":false,"s":"12926797827"},{"r":5,"d":"2026-05-08","a":"vh****","t":"아이가 흥미를 갖게 해주는 것같아요","h":0,"b":false,"s":"12926797827"},{"r":5,"d":"2026-05-07","a":"jh37***","t":"아이랑 고르고 구매하게 되었는데 저도 아이도 마음에 들어요. 다양한구성이라 아이가 할때마다 새롭게 하는 기분이 들어서 재미있어하더라고요. 첫 독서록 정착하기에 좋은것같아요!","h":0,"b":true,"s":"12926797827","p":["photos/1536/8d607dc43608.jpg"]},{"r":4,"d":"2026-05-06","a":"daeb****","t":"구성이좋고.아이들 습관잡아주기 좋을거같아요~","h":0,"b":false,"s":"12926797827"},{"r":5,"d":"2026-05-04","a":"seoh******","t":"동생과 함께 독서습관을 길러주기 위해 구매했어요~ 구성이 다양하게 되어있어서 지루하지않을거 같아요~","h":0,"b":true,"s":"12926797827","p":["photos/1536/188cf80baad7.jpg"]},{"r":5,"d":"2026-05-04","a":"gusl***","t":"책 읽고 항상 무언가 허전하기도 하고..\n알아서 이런 저런 질문을 하기에도 한계가 있어서 찾아보다가 구매했어요!\n구성 좋아서 보고 있었는데 마침 세일까지ㅎㅎ\n아이가 책 읽고 독후 활동 잘 해서 아이에게 많은 게 남았으면 좋겠어요~","h":0,"b":false,"s":"12926797827","p":["photos/1536/04bdd6e9849c.jpg","photos/1536/3bf1b772ae32.jpg"]},{"r":5,"d":"2026-05-03","a":"de****","t":"아이가 좋아해요. 바로 책 해치우네요","h":0,"b":false,"s":"12926797827","p":["photos/1536/27baeee4fc30.jpg"]},{"r":5,"d":"2026-05-01","a":"dkfl*******","t":"아이랑 재미있게 해보고싶어 구매했어요","h":0,"b":false,"s":"12926797827","p":["photos/1536/cac18772b774.jpg"]},{"r":5,"d":"2026-05-01","a":"alsl***","t":"바로 배송되서 너무 좋네요!\n\n요즘 이런저런 다양한 책을 보는데\n기록하면 좋을것같아서 구매했습니다\n\n크기가 넉넉하고 속지도 다양해서 \n아이가 사용하기 너무 좋네요!","h":0,"b":true,"s":"12926797827","p":["photos/1536/c44bdd594482.jpg","photos/1536/4cb02e38481e.jpg","photos/1536/a36de5d5665d.jpg","photos/1536/029a4b00cede.jpg","photos/1536/4ea2f589c4a2.jpg"]}]