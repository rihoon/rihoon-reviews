[{"r":5,"d":"2026-02-03","a":"xn****","t":"조금 더 어릴때 알았다면 좋았겠다 싶어요.이제라도  사용해  볼 수 있어 좋아요. 구성이 새롭네요","h":0,"b":false,"s":"12926797827","p":["photos/1536/61b067d5cb29.jpg"]},{"r":5,"d":"2026-02-03","a":"dayu******","t":"구성이 여러가지라 제가 더 하고싶어요.\n쓰기싫은 독후감보다 기억에 남는 독서활동이 될 것 같아요.","h":0,"b":false,"s":"12926797827"},{"r":5,"d":"2026-02-02","a":"angl*****","t":"재질도 좋고 장수도 많고. 내용도 참 좋네요.\n아이만^^; 좋아해주면 참 좋겠네요.","h":0,"b":false,"s":"12926797827","p":["photos/1536/0a1bd9357f40.jpg","photos/1536/a7fe2fad8913.jpg"]},{"r":5,"d":"2026-02-01","a":"trud***","t":"사이즈가 커서 좋아요","h":0,"b":false,"s":"12926797827"},{"r":5,"d":"2026-02-01","a":"shy8***","t":"저학년용이랑 칸 폭만 다르고 구성(내용)은 똑같아서 아쉬웠어요. 고학년은 질문이나 좀더 상세한 팁이 있으면 좋을것같아요","h":0,"b":false,"s":"12926797827"},{"r":5,"d":"2026-02-01","a":"shy8***","t":"구성이 맘에들어요. 좀더 다양한 질문들이 있으면 더 좋을것같아요","h":0,"b":false,"s":"12926797827"},{"r":5,"d":"2026-02-01","a":"qqhh***","t":"생각보다 괜찮네요\n매번 아이가 책만 읽고 끝나는게\n뭔가 아쉬웠는데 이렇게 생각을 남기는 경험으로 바꾸어 준다는게 너무 좋은 거 있죠\n저학년 고학년 나눠지는것도 좋고 우리 아이 책을 읽고 얼마나 많은 생각을 말과 글로 표현할 수 있을지 기대되는데생각의 폭이 많이 넓어지길 기대해요","h":0,"b":false,"s":"12926797827","p":["photos/1536/84cd92b559a2.jpg","photos/1536/c3263d56e0e7.jpg","photos/1536/790d994905b3.jpg","photos/1536/cb40a1fc8ffd.jpg","photos/1536/00ddeb535a0c.jpg","photos/1536/b229a20c87cb.jpg","photos/1536/46b750f6845f.jpg","https://phinf.pstatic.net/checkout.phinf/20260201_50/1769952936368W3Fo1_JPEG/20260131_234813.jpg","https://phinf.pstatic.net/checkout.phinf/20260201_65/1769952936408vBHnF_JPEG/20260131_234816.jpg"]},{"r":5,"d":"2026-02-01","a":"dear***","t":"독서 습관 만들기 좋은 독서장이에요.\n칸을 체우는게 눈에 보이니까 아이도 책 읽는 재미에 빠졌어요","h":0,"b":false,"s":"12926797827","p":["photos/1536/4d05af46ba77.jpg"]},{"r":5,"d":"2026-01-31","a":"mkjy***","t":"아이랑 책읽고 함께 활동해보려고 샀어요","h":0,"b":false,"s":"12926797827","p":["https://phinf.pstatic.net/checkout.phinf/20260131_150/1769819514266cVY4B_JPEG/image.jpg"]},{"r":5,"d":"2026-01-31","a":"the_*******","t":"일기장에 늘 쓰다가 다양하게 기록할 수 있을거 같아 구매했어요","h":0,"b":false,"s":"12926797827","p":["https://phinf.pstatic.net/checkout.phinf/20260131_88/1769844707345taTHL_JPEG/1000053334.jpg"]}]