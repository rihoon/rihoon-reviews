[{"r":5,"d":"2026-07-03","a":"7opq****","t":"감사합니다 수고하세요","h":0,"b":false,"s":"12926797827","p":["photos/1536/c88dd4dfb50e.jpg"]},{"r":4,"d":"2026-07-03","a":"up****","t":"여름방학때 아이들과 해보려고 구매했어요","h":0,"b":false,"s":"12926797827","p":["photos/1536/76ec078d560b.jpg"]},{"r":5,"d":"2026-07-03","a":"rlar*****","t":"아이가 잘썼으면 좋겠어요 ㅋ","h":0,"b":false,"s":"12926797827"},{"r":5,"d":"2026-07-03","a":"rlar*****","t":"아이가 잘썼으면 좋겠네요 ㅋㅋ","h":0,"b":false,"s":"12926797827"},{"r":5,"d":"2026-07-01","a":"jwh7***","t":"독서기입장 쓰는 취미가 생겼음 해용","h":0,"b":false,"s":"12926797827","p":["photos/1536/6bd415f83473.jpg"]},{"r":5,"d":"2026-07-01","a":"bies***","t":"한 달 정도 사용해 보니 정말 만족스러운 독서기록장이에요. 아이가 부담 없이 꾸준히 독서 기록을 남길 수 있도록 구성이 잘 되어 있고, 글씨 쓰는 칸도 적당해서 사용하기 편합니다. 디자인도 깔끔하고 종이 재질도 좋아 오래 사용해도 불편함이 없었어요. 독서 습관을 들이는 데 도움이 되는 것 같아 만족하며 사용 중입니다. 다음에도 재구매하고 싶은 제품이에요. 😊","h":1,"b":true,"s":"12926797827","p":["photos/1536/7843c893b1eb.jpg","photos/1536/84959e961657.jpg","photos/1536/a796e59404bf.jpg"]},{"r":5,"d":"2026-06-30","a":"ramo*****","t":"방학동안 해볼려고 주문했어요~","h":0,"b":false,"s":"12926797827"},{"r":5,"d":"2026-06-30","a":"ramo*****","t":"방학기간 동안 같이 해보려구요.","h":0,"b":false,"s":"12926797827"},{"r":5,"d":"2026-06-29","a":"toay*****","t":"시작을 한번 해봅니다","h":0,"b":false,"s":"12926797827","p":["photos/1536/dfcbc72f8cd4.jpg"]},{"r":4,"d":"2026-06-26","a":"hyun*****","t":"한 책을 읽고 그 책에 대한 내용이 아니라, 독서쓰기 양식별 구성으로 되어있어요.\n\n예를 들면 새로운 캐릭터 그려보기 페이지가 계속 있고 하나의 묶음으로 존재합니다. 저는 한장씩 껴있어서 한 책을 읽도 다양한 활동을 할 수 있는 줄 알았어요. 아쉬웠지만 워크지 구성 자체는 정말 마음에 듭니다","h":0,"b":false,"s":"12926797827"}]