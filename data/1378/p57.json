[{"r":5,"d":"2025-07-07","a":"2lov*******","t":"업무일지로 사용하려고 구매했습니다 만족해요","h":0,"b":false,"s":"11663635822"},{"r":5,"d":"2025-07-06","a":"seun*****","t":"스케줄 정리하는데 좋네요","h":0,"b":false,"s":"11663635822"},{"r":5,"d":"2025-07-05","a":"ssem***","t":"몇 번 구매했던 제품이에요! 주변 지인들에게도 선물해 줄 정도로 만족스럽습니다. 딱 업무에만 집중해서 사용하기 좋아요^^","h":0,"b":true,"s":"11663635822","p":["https://phinf.pstatic.net/checkout.phinf/20250706_257/1751752151889hhkNL_JPEG/KakaoTalk_20250706_064850454.jpg"]},{"r":5,"d":"2025-07-04","a":"dlrk*********","t":"일단 날짜를 직접 적을 수 있어서 일정이 없는 날은 건너 뛸 수 있는게 가장 마음에 들었습니다. 다이어리나 스케줄러에 빈 페이지가 있으면 나중에 돌아봤을 때 마음에 안들어서 끝까지 쓰기가 어려웠는데 날짜도 마음대로 조정 가능 하고 스티커로 월을 나눌 수 있어서 보기에도 편했는게 가장 큰 장점 같습니다. \n 커버가 부드러운 가죽이라 쉽게 질리지도 않고 착한 가격에 비해 퀄리티가 전혀 떨어져 보이지도 않았습니다. \n 이번 스케줄러를 다 쓰면 또 재구매를 희망할 정도로 아주 만족스럽습니다. 감사합니다.","h":0,"b":false,"s":"11663635822"},{"r":5,"d":"2025-07-03","a":"taxs*******","t":"굿 잘쓰겠습니다. 띄지 아이디어 좋았어요~","h":0,"b":false,"s":"11663635822"},{"r":5,"d":"2025-07-02","a":"chel*******","t":"잘쓸게요 감사해요 ㅇ","h":0,"b":false,"s":"11663635822"},{"r":5,"d":"2025-07-02","a":"umic***","t":"회사에서 사용하기 너무 좋아요","h":0,"b":false,"s":"11663635822"},{"r":4,"d":"2025-07-02","a":"rbgm*****","t":"개인적으로 속지가 약간 너무 밋밋한거 같아서 선이나 글씨가 조금더 진하게 인쇄되어있으면 더 좋았을것같아요. \n깔끔하고 사이즈가 큰편이라 쓸 공간이 여유있어서 좋아요.","h":1,"b":false,"s":"11663635822","p":["https://phinf.pstatic.net/checkout.phinf/20250702_275/1751433125773olNdj_JPEG/image.jpg","https://phinf.pstatic.net/checkout.phinf/20250702_101/17514331473395GxOL_JPEG/image.jpg"]},{"r":5,"d":"2025-06-30","a":"dlsl****","t":"처음 여기에서 사봤는데, 계속 살 것 같아요 너무 만족합니다","h":0,"b":false,"s":"11663635822"},{"r":5,"d":"2025-06-30","a":"somi*****","t":"생각보다 쓸수있는공간이많아서 공부하거나 회사에 회의기록 쓰기가 너무 좋았어용","h":0,"b":false,"s":"11663635822","p":["https://phinf.pstatic.net/checkout.phinf/20250630_9/1751285756378V4yvL_JPEG/IMG_7044.jpeg"]}]