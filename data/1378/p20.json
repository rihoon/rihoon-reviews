[{"r":4,"d":"2025-12-19","a":"melo****","t":"편하게 잘쓸것같아요","h":0,"b":false,"s":"11663635822"},{"r":5,"d":"2025-12-19","a":"knig******","t":"내년 다이어리 용으로 구입했는데 좋네요👍","h":0,"b":false,"s":"11663635822","p":["photos/1378/e470021bb380.jpg"]},{"r":5,"d":"2025-12-19","a":"jl****","t":"좋은상품 잘 받았어요.!!","h":0,"b":false,"s":"11663635822","p":["photos/1378/50068ed2a1d7.jpg"]},{"r":5,"d":"2025-12-19","a":"ssos****","t":"너무좋은거같네요 ㅋㅋ 이쁨","h":0,"b":false,"s":"11663635822"},{"r":5,"d":"2025-12-18","a":"wlrh******","t":"처음 써보지만  구성이며 색이며 너무 맘에들어요","h":0,"b":false,"s":"11663635822"},{"r":5,"d":"2025-12-18","a":"drea*****","t":"리훈 다이어리 처음 써보는데 확실히 회사생활을 하는 사용자의 의견을 꾸준히 반영한 티가 납니다. 디자인이나 내부에 있는 컨텐츠 등 모두 ~~~\n\n그리고 무엇보다 연차 반차 스티커는 너무 맘에 들구요.\n나의 연차 사용현황까지 볼 수 있게 고려하여 만든 다이어리는 난생 처음입니다.\n\n인사 업무 담당자라 더욱 공감가는 부분이였습니다.\n각 월마다 위클리 내용 작성에 부족하지 않도록 세심하게 5주씩 만들어 놔서 또 감탄했습니다.","h":0,"b":false,"s":"11663635822","p":["photos/1378/33103b9f4625.jpg","photos/1378/d705d302eca0.jpg","photos/1378/05e5e246b231.jpg"]},{"r":5,"d":"2025-12-17","a":"0mir******","t":"매번 컴퓨터로 문서화해왔는데 확실히 수기로 작성하니 보기 편하네요!\n색상이 많이 없어서 아쉽더라구요 색상을 많이 늘려주시면 좋겠어요","h":0,"b":false,"s":"11663635822"},{"r":2,"d":"2025-12-17","a":"craz****","t":"제가 원하는 디자인과 달라서 아쉽. 월과 날짜를 수동 기입해야 하고, 주간 플랜 기록칸이 좁아 아쉽고, 책갈피 기능의 끈이 안달려있음.","h":1,"b":false,"s":"11663635822"},{"r":5,"d":"2025-12-17","a":"gywj*****","t":"배송빠르고좋아요 ~~","h":0,"b":false,"s":"11663635822","p":["photos/1378/5f3351e4bf25.jpg"]},{"r":5,"d":"2025-12-17","a":"gywj*****","t":"배송빠르고좋아요 ~~","h":0,"b":false,"s":"11663635822","p":["photos/1378/fbb9b8b8f853.jpg"]}]