[{"r":4,"d":"2025-07-13","a":"jt****","t":"독서후 남긴다는 행동이 은근히 기분이 좋네요","h":0,"b":false,"s":"5482012680"},{"r":4,"d":"2025-07-13","a":"jt****","t":"독서후 나긴다는 행동이 재밌어요","h":0,"b":false,"s":"5482012680"},{"r":5,"d":"2025-07-11","a":"song******","t":"책 읽고, 독서기록장 쓰기\n1년간 성인 독서량 4.5권인데 저는 미달이었네요..\n여러가지 챕터는 물론 50권까지 독서기록을 할 수 있어서 너무 좋았어요!\n글씨도 편하게 쓸 수 있도록 모눈 형식으로 제작되어있어서 더더욱 만족 좋은 제품 감사합니다!","h":0,"b":true,"s":"5482012680","p":["photos/419/7e1e12133dbd.jpg","photos/419/9ea4825207e3.jpg","photos/419/7dfce8a5a2f7.jpg","photos/419/861d834d7165.jpg","photos/419/3e98ce866706.jpg","photos/419/9dea436057d7.jpg"]},{"r":5,"d":"2025-07-09","a":"ddor*******","t":"디자인이랑 컬러 고급지고 예뻐요. 50권까지 기록가능한데, 끝까지 해보려고요 ㅎㅎㅎ","h":0,"b":true,"s":"5482012680","p":["photos/419/37a0207f6e6e.jpg"]},{"r":5,"d":"2025-07-08","a":"gams********","t":"아직 사용전입니니다. 무엇보다 표지 디자인이 마음에 들어서 구매했습니다.","h":0,"b":false,"s":"5482012680"},{"r":5,"d":"2025-07-06","a":"yj_y****","t":"책을 잘 읽어보려고 구매했어요 3일차 아직까진 잘 쓰고 있습니다:)","h":0,"b":false,"s":"5482012680","p":["photos/419/094639aafefc.jpg"]},{"r":5,"d":"2025-07-02","a":"skym*****","t":"내용이 알차요!\n생활에 묻어나는 독서 생활이 될것 같아요!","h":0,"b":true,"s":"5482012680","p":["photos/419/5423b1fe9918.jpg","photos/419/307fcba27224.jpg","photos/419/24bd3942dee2.jpg"]},{"r":5,"d":"2025-06-30","a":"si****","t":"제가 책이 많아서 기록장으로 샀는데 진짜 꼼꼼하게 잘 구성 되어있어요. 서점 위치, 책 제목, 책 독서 기간 이런것도 기재 할 수 있게 한게 너무 좋아요.","h":0,"b":false,"s":"5482012680"},{"r":5,"d":"2025-06-28","a":"djfl***","t":"독서노트 잘쓸께요.","h":0,"b":false,"s":"5482012680","p":["photos/419/e23fac40d625.jpg"]},{"r":5,"d":"2025-06-22","a":"bimi*****","t":"책 구성도 다양하고 양장이라 고급스러워 보이고 좋은데, 양장이라 무겁긴해요\n그리고 본격적으로 책 기록하는 부분이 180도로 잘 안펴지더라구요 \n이건 뽑기 문제인거 같아서 그냥 쓰려구요","h":0,"b":false,"s":"5482012680","p":["photos/419/66d583ed529a.jpg","photos/419/a3669ab934f5.jpg"]}]