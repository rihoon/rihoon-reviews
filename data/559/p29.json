[{"r":5,"d":"2025-02-03","a":"ae****","t":"잘 사용하겠습니다 잘만들어졌습니다","h":0,"b":false,"s":"7402685369"},{"r":5,"d":"2025-02-02","a":"lsr4***","t":"사줬더니 잘 쓰고 잇네요","h":0,"b":false,"s":"7402685369","p":["photos/559/8f92f9ad1f56.jpg"]},{"r":5,"d":"2025-01-31","a":"llso*****","t":"일주일 단위로 투두리스트를 한눈에 볼 수 있어 좋고 그날 공부 달성량에 따라 스티커로 표시하기 좋습니다. 무엇보다 달력처럼 세워놓을 수 있어서 책상에 놓기 좋네요!","h":0,"b":false,"s":"7402685369"},{"r":5,"d":"2025-01-30","a":"soon****","t":"계획하면서 실천하려고 노력하고 있어요.\n잘 활용하겠습니다.","h":0,"b":false,"s":"7402685369"},{"r":5,"d":"2025-01-28","a":"beau******","t":"디자인도 구성도 마음에 들어요","h":0,"b":false,"s":"7402685369"},{"r":4,"d":"2025-01-26","a":"es****","t":"제가 원하던 구성이예요. (+귀여움) 그런데 검정색은 지문이 묻는 재질이라 아쉬워요ㅠ 내년엔 다른 색상도 출시 되었음 좋겠네요. 다른 스티커 사면 쓰잘데기 없는 구성으로 되어있는데 곰부 스티커는 계절별로 되어 있는게 너무 센스있어요.","h":0,"b":false,"s":"7402685369"},{"r":5,"d":"2025-01-25","a":"wldl*****","t":"너무 좋아요 빠른 배송 감사합니다","h":0,"b":false,"s":"7402685369"},{"r":5,"d":"2025-01-22","a":"jb****","t":"위클리 플래너 찾고 있었는데 구성이 깔끔하고 마음에 들어요 한눈에 보기도 편하고 책상위에 세워두니 수시로 체크해서 볼 수 있고 디자인도 너무 귀여워요","h":0,"b":false,"s":"7402685369","p":["photos/559/9b05cf2eb16f.jpg"]},{"r":5,"d":"2025-01-22","a":"lebe*****","t":"아이 스케줄 관리해 주기 좋네요","h":0,"b":false,"s":"7402685369","p":["photos/559/9e90605c147a.jpg"]},{"r":5,"d":"2025-01-22","a":"ljar*****","t":"스케쥴 쓰기 편해요. 저같은 경우는 주말에도 스케쥴이 있는데 주말 칸도 넓어서 좋습니다.","h":0,"b":false,"s":"7402685369","p":["photos/559/c88695ee5c16.jpg"]}]