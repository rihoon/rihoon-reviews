[{"r":5,"d":"2026-09-25","a":"pigl*****","t":"색이 예쁘게 잘나오고 부드럽고 좋아요","h":0,"b":false,"s":"13674587358","p":["photos/1571/5d42a7e53a1e.jpg"]},{"r":3,"d":"2026-09-23","a":"youn*****","t":"찐하게 나오는색도 있고, 연두랑, 주황은 잘 표가 안나네요.","h":0,"b":false,"s":"13674587358","p":["photos/1571/6af749193ba2.jpg"]},{"r":5,"d":"2026-09-21","a":"wj****","t":"너무 마음에 들어요.ㅎㅎ","h":0,"b":false,"s":"13674587358","p":["photos/1571/048121eb64a0.jpg"]},{"r":5,"d":"2026-09-17","a":"ioko****","t":"부드럽게 잘써지고 색이 선명해서 좋아요","h":0,"b":false,"s":"13674587358","p":["photos/1571/c4d3ab9aa1d8.jpg"]},{"r":5,"d":"2026-09-17","a":"fl****","t":"리훈제품은 언제나 만족스럽네요~","h":0,"b":false,"s":"13674587358"},{"r":5,"d":"2026-09-16","a":"nana*******","t":"타사 아크릴펜보다 저렴해서 한번 사봤습니다\n일단 검은색 종이에 써봤을때 차폐력 괜찮고요 마르면서 매트해지며 색이 밝아집니다\n잉크가 콸콸 나오는 타입은 아니라서 신경써서 손에 힘을 빼고 종이 위에 올린다는 느낌으로 쓰면 예쁘고 얇게 나옵니다\n마스킹 테이프에도 그럭저럭 잘 올라가고... 빈곳은 마른뒤에 다시 채워주면 되니까요 요령이 약간 필요합니다\n가격이 최강점이죠 잉크양도 많고 색도 대중적이라서 좋은 것 같아요 \n색다르게 쓰기 좋습니다\n번지는 타입이 아니라서 체감상 잉크펜 0.5 보다 좀 얇은 느낌이에요","h":0,"b":false,"s":"13674587358","p":["photos/1571/303a9c9b4a78.jpg","photos/1571/96fe51e88d31.jpg","photos/1571/414eb98d476e.jpg","photos/1571/ebd52d4a974d.jpg","photos/1571/83c7e0f05ff5.jpg"]},{"r":5,"d":"2026-09-15","a":"nmlo******","t":"부들부들하니 잘 써지네요","h":0,"b":false,"s":"13674587358"},{"r":5,"d":"2026-09-12","a":"hiph*****","t":"사진에 예쁜 색감이 다 안 담겨서 아쉬워요\n\n노랑은 형광끼가 있어서 강조할 때 쓰면 좋겠어요 \n민트색도 예뻐요 \n분홍색은 쨍하지 않고 부드러운 색감입니다\n개인적으로 제일 마음에 드는 색은 커피색? 갈색? 이에요 차분하고 은은한 색이라 계속 손이 갑니다","h":0,"b":false,"s":"13674587358","p":["photos/1571/33c9b723c324.jpg"]},{"r":5,"d":"2026-09-11","a":"blue******","t":"요거 물건이네여~^^\n특히 흰색은 흰종이만\n아니면 제일 눈에 들어오는 색깔입니다","h":0,"b":false,"s":"13674587358","p":["photos/1571/d55af4022505.jpg","photos/1571/6685ff406f3b.jpg"]},{"r":5,"d":"2026-09-10","a":"jeen****","t":"필기감도 좋고, 색상도 마음에 들어요.","h":0,"b":false,"s":"13674587358"}]