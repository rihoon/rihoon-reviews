[{"r":5,"d":"2023-08-15","a":"wlgn*****","t":"색깔도 맘에 들고 구성도 좋아요 잘쓰고 있어요","h":0,"b":true,"s":"4960363460","p":["https://phinf.pstatic.net/checkout.phinf/20230815_61/1692081417315OIrtz_JPEG/KakaoTalk_20230815_153634038.jpg"]},{"r":5,"d":"2023-08-15","a":"jiah****","t":"실용적이고 좋아요~","h":0,"b":false,"s":"4960363460"},{"r":5,"d":"2023-08-14","a":"cksr********","t":"3년째 쓰고있는 다이어리입니다. 내구성도 좋고 볼펜도 좋아용","h":0,"b":false,"s":"4960363460"},{"r":5,"d":"2023-08-14","a":"ahyo*******","t":"색상도 좋고 쓰기 편합니다\n같이 주신 봉인된 저에겐 얇다 생각했는데\n써보니 깔끔해서 좋네요\n일이 많았는데 다이어리 덕을 많이봤네요 ^^","h":0,"b":false,"s":"4960363460","p":["https://phinf.pstatic.net/checkout.phinf/20230814_235/1691981726589OJH3x_JPEG/1000011885.jpg"]},{"r":5,"d":"2023-08-14","a":"yeun****","t":"잘 쓰고있습니다!!","h":0,"b":false,"s":"4960363460"},{"r":5,"d":"2023-08-13","a":"nutw****","t":"스케줄 정리하기좋고 사이즈도 마음에 들어요 펜도 얇아서 글자쓰기 좋아요","h":0,"b":false,"s":"4960363460"},{"r":5,"d":"2023-08-13","a":"mira*****","t":"좋아요좋아요좋아요좋아요좋아요좋아요","h":0,"b":false,"s":"4960363460"},{"r":5,"d":"2023-08-12","a":"tobe******","t":"다이어리 너무 마음에 듭니다. 크기와 두께가 적당해서 들고다니기도 좋고 구성도 실속 있어요. 그리고 가죽 표지가 감촉도 좋고 다른 다이어리들보다 고급져보여서 소장욕구와 사용 시 만족감을 충족해주어서 너무 마음에 듭니다. 그런데 제 실수로 가방 안에서 커피가 새는 바람에 다이어리가 커피로 얼룩졌어요ㅠㅠ 새 걸로 다시 사고 싶었는데 품절이네요ㅠ 안타깝지만 이렇게 써야 하나 봅니다. 아무튼 내년에도 이 다이어리 살 겁니다. 단종시키지 말고 계속 내주세요.","h":0,"b":false,"s":"4960363460"},{"r":5,"d":"2023-08-12","a":"silk****","t":"구성도 좋고 펜은 기대안했는데 기대이상이에요","h":0,"b":false,"s":"4960363460"},{"r":4,"d":"2023-08-11","a":"gusw*******","t":"잘 쓰고 있습니다. 감사합니다.","h":0,"b":false,"s":"4960363460"}]