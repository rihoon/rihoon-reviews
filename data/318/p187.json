57284om7MY_JPEG/review-attachment-d4060aec-21fa-4f6c-a5aa-e65c0674a19c.jpeg","https://phinf.pstatic.net/checkout.phinf/20220616_167/16553647050273AFsm_JPEG/review-attachment-bbf59af3-74bf-4f44-a561-d1dd1a6d4ae7.jpeg","https://phinf.pstatic.net/checkout.phinf/20220616_38/1655364759701Dveh7_JPEG/review-attachment-4169bed7-9b16-4895-bef3-d5b6c113a085.jpeg"]},{"r":5,"d":"2022-06-16","a":"qy****","t":"가방에 넣어도 부담스럽지 않는 사이즈라 좋아요. 같이 오는 펜은 너무 얇은 거 좋아하지 않으시는 분들은 추가로 안 사셔도 될거 같아요. 펜촉이 얇아서 잉크 뭉침이나 번짐은 확실히 적어요","h":0,"b":false,"s":"4960363460"},{"r":4,"d":"2022-06-16","a":"love*******","t":"노란색 주문한건데 도착해서 뜯어보니 손에 노랑색 염색 색이 다 묻고 손에도 물들어요","h":0,"b":false,"s":"4960363460","p":["https://phinf.pstatic.net/checkout.phinf/20220616_198/1655368199782evvGK_JPEG/review-attachment-c3794888-e40c-4f94-a4d6-d187b0218bd9.jpeg"]},{"r":5,"d":"2022-06-15","a":"jun6***","t":"지난번에도 쓰고 맘에들어서\n다시재주문했어요","h":0,"b":false,"s":"4960363460"},{"r":5,"d":"2022-06-15","a":"yusu****","t":"색상 맘에 쏙 들고 펜 스티커도 맘에 들어요","h":0,"b":false,"s":"4960363460","p":["https://phinf.pstatic.net/checkout.phinf/20220615_113/16552706770433WHQQ_JPEG/review-attachment-38b760c1-eedc-4a92-8858-c67783cac0f6.jpeg"]},{"r":4,"d":"2022-06-15","a":"park****","t":"원하던 디자인 이예요.\n맘에 들어요.\n잘사요 할께요.","h":0,"b":false,"s":"4960363460"}]