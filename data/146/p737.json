[{"r":4,"d":"2018-11-20","a":"best*******","t":"생각했던것처럼 크기도좋고\n스프링으로 되어있어서 \n편해요ㅎ","h":1,"b":false,"s":"2475098505"},{"r":5,"d":"2018-11-18","a":"redf*****","t":"하드커버인것도 예쁘고 마음에 들어요. 앱으로만 쭉 가계부를 쓰다가 좀 더 눈에 잘 들어오는 방식으로 써보고 싶어 구매했어요. 마음에 들면 다음번엔 6개월 짜리로도 써보고 싶어요.","h":1,"b":false,"s":"2475098505"},{"r":5,"d":"2018-11-16","a":"dbsa*****","t":"너무좋아요 딱 필요한것들만들어가잇고\n1년잘쓰고 또 구매하고싶어요!!","h":1,"b":false,"s":"2475098505"},{"r":5,"d":"2018-11-11","a":"gowl*****","t":"이번달부터 바로 쓰고 싶어서 두개 구매 했는데 \n안에 내용도 너무 좋고 편하게 되어있네용 내후년에도 구매예정이에용","h":1,"b":false,"s":"2475098505"},{"r":5,"d":"2018-11-09","a":"2000***","t":"이쁘고 구성도 괜찮은것 같아요","h":1,"b":false,"s":"2475098505"},{"r":5,"d":"2018-11-09","a":"lily***","t":"배송빨라요","h":1,"b":false,"s":"2475098505"},{"r":5,"d":"2018-11-09","a":"minj********","t":"11월부터 쓰고싶어서 2019말고 1년 가계부 샀는데 디테일하고 너무 좋네요>.<","h":1,"b":false,"s":"2475098505"},{"r":5,"d":"2018-11-06","a":"n100****","t":"날짜써있는버전도 있으면 좋겠어요\n\n넘좋아요","h":1,"b":false,"s":"2475098505"},{"r":5,"d":"2018-11-01","a":"ryui*******","t":"이뻐요! 완전 빠른배송","h":1,"b":false,"s":"2475098505"},{"r":5,"d":"2018-11-01","a":"ryui*******","t":"이뻐요 문구센터?같은 곳 아무리 가도 촌스럽고 안예쁜 가계부만 있어서 인터넷 검색후 오늘쓰임 구매했어요.\n6개월용도 스프링으로 되어있다면 그걸 샀을텐데..\n1년동안 열심히 써보려구요. \n디자인이 정말 예쁘고 깔끔해요.0","h":1,"b":false,"s":"2475098505","p":["https://phinf.pstatic.net/checkout.phinf/20181101_17/1541045161502oqAqb_JPEG/PRREW_8539110115362360176.jpeg"]}]