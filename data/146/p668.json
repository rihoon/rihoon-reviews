[{"r":5,"d":"2019-12-31","a":"flag***","t":"일단.. 그동안 가계부에 돈을 들여야 하나 하는 생각에 매번 저렴한 가계부를 사용하다가, 올해는 예쁜걸 써보고 싶어서 예쁘고 쓰기 편한 가계부를 찾아보다가 주문했습니다.\n\n결론은 깔끔하고 너무 마음에 들어요.\n표지가 예뻐서 만년형으로 사기는 했는데 내년에는 그냥 날짜 표시 되있는걸 살까봐요...ㅎ\n\n타 사이트에서 뻑뻑해서 잘 넘겨지지 않는다는 후기를 보고 조금 고민했었는데, 잘 산 것 같습니다 ㅎ\n잘 넘겨지구요 크게 불편한 점은 아직까지 없습니다.\n\n잉크펜을 쓰고있는데 막 비치거나 그런것도 딱히 없구요. 형광펜은 많이 뭉치는 부분은 어쩔 수 없기는 하지만 전체적으로 만족해요!","h":0,"b":false,"s":"2475098505","p":["https://phinf.pstatic.net/checkout.phinf/20191231_244/1577757508562YLlVb_JPEG/074AB971-081B-49CB-8E89-114EAD411443.jpeg","https://phinf.pstatic.net/checkout.phinf/20191231_139/1577757508639tDMLj_JPEG/6FEC9E29-66AF-423A-8308-338A1FC75560.jpeg","https://phinf.pstatic.net/checkout.phinf/20191231_4/1577757784052WCRw0_JPEG/image.jpg"]},{"r":4,"d":"2019-12-30","a":"minj*****","t":"몇일 써보지않았는데 만족합니다","h":0,"b":false,"s":"2475098505"},{"r":4,"d":"2019-12-30","a":"kjj5***","t":"첨사보는데 넘좋아요 잘쓰고있네요","h":0,"b":false,"s":"2475098505"},{"r":5,"d":"2019-12-30","a":"lyj2***","t":"색깔과 구성 마음에 듭니당","h":0,"b":false,"s":"2475098505"},{"r":5,"d":"2019-12-30","a":"himi****","t":"예쁘고 깔끔하고 필요한 기입내역이 잘 되어있어서 좋어요 스프링이라 안접어도 돼서 고른건데 맘에 드네요","h":0,"b":false,"s":"2475098505"},{"r":4,"d":"2019-12-30","a":"hom5***","t":"디자인도이쁘고 좋아요♡~~","h":0,"b":false,"s":"2475098505"},{"r":3,"d":"2019-12-29","a":"hyl0***","t":"좋아요~~~~~~~~~^^","h":0,"b":false,"s":"2475098505"},{"r":4,"d":"2019-12-29","a":"newh*****","t":"깔끔하니좋네요 ㅎㅎ","h":0,"b":false,"s":"2475098505"},{"r":5,"d":"2019-12-29","a":"un****","t":"가계부를 원하는 친구에게 선물로 주었더니 너무 좋아했어요. 새해 선물로 최고인 것 같습니다","h":0,"b":false,"s":"2475098505"},{"r":4,"d":"2019-12-29","a":"tbc1***","t":"자세하게 돈관리할 수 있을거같아서 좋아요","h":0,"b":false,"s":"2475098505","p":["https://phinf.pstatic.net/checkout.phinf/20191229_264/1577603230277LSCxs_JPEG/20191224_153033.jpg"]}]