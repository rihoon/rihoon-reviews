[{"r":5,"d":"2019-01-03","a":"aptn***","t":"가계부 구성도 알차고 내지도 좋고 튼튼해요! 다이어트 플래너도 마름에 들어요\n스티커도 유용해요! 감사합니다~","h":1,"b":true,"s":"2006874908","p":["https://phinf.pstatic.net/checkout.phinf/20190103_213/15465250494697SOe9_JPEG/DF964835-6AC6-4BB0-9985-68BE261F367A.jpeg"]},{"r":5,"d":"2019-01-02","a":"nnhh****","t":"좋아요정말... 올핸꼭 다욧성공","h":2,"b":false,"s":"2006874908","p":["https://phinf.pstatic.net/checkout.phinf/20190102_155/1546406826435ue7rE_JPEG/52E22F20-278D-4365-B8AA-F00290DE2F16.jpeg"]},{"r":5,"d":"2019-01-01","a":"jkhh****","t":"매번 다이어리에 기록했는데 이번에는 전용플래너에 작성해보려고 샀어요, 기대되요","h":1,"b":false,"s":"2006874908"},{"r":5,"d":"2018-12-25","a":"hj20***","t":"심플하면서도 흔하지 않은듯한 느낌이 좋네요\n마테는 좀만 더 저렴했으면좋겠어요~","h":1,"b":false,"s":"2006874908"},{"r":5,"d":"2018-12-21","a":"cand****","t":"다이어리는 예쁘고 잘산거같은데 추가로구매한 스티커가 2018년꺼네요 올해 10일남았는데 ..","h":0,"b":false,"s":"2006874908"},{"r":5,"d":"2018-12-18","a":"osl4***","t":"심플하니 이뻐요 새해맞이 다이어트 하려규 샀는데 구성도 알차고 다이어트에 도움될 것 같아요!!","h":1,"b":false,"s":"2006874908"},{"r":4,"d":"2018-12-17","a":"ksy8****","t":"뭐, 사는게 다가 아니라 쓰면서 다이어트가 되어야겟지여 칼로리가 나와잇어서 좋지만 잘 안찾게 되는게 문제 ㅎ 수분 체크하는게 잇어서 유용해요","h":1,"b":false,"s":"2006874908","p":["https://phinf.pstatic.net/checkout.phinf/20181217_248/1545014536167skqHm_JPEG/image.jpg"]},{"r":5,"d":"2018-12-14","a":"tngu*****","t":"저 이번에 진짜 다이어트 할거예요!\n진짜라구요!!! 그래서 마음먹고 구매했어요!~\n다이어리에 기록하면서 저의 몸을 관리해보려고 해요!\n저는 모바일이나 앱으로 기록하는것보다 글로 써서 기록하는걸 더 좋아하고 제가 보기도 편한 스타일이예요~~!\n그래서 1월부터 헬스장에서 패키지로 요가랑 다이어트반을 신청할건데 몸의 변화를 지켜보려고 하거든요!\n구성이 너무 마음에 드네요!!ㅎ\n여러분들도 한 번 도전해보세요!!!","h":2,"b":true,"s":"2006874908","p":["https://phinf.pstatic.net/checkout.phinf/20181214_300/1544751962540Vrdzb_JPEG/KakaoTalk_20181214_101820426.jpg","https://phinf.pstatic.net/checkout.phinf/20181214_248/1544751962647HXj3y_JPEG/KakaoTalk_20181214_101820890.jpg","https://phinf.pstatic.net/checkout.phinf/20181214_158/15447519626980ltsd_JPEG/KakaoTalk_20181214_101821298.jpg","https://phinf.pstatic.net/checkout.phinf/20181214_211/1544751962794DEoYc_JPEG/KakaoTalk_20181214_101821717.jpg","https://phinf.pstatic.net/checkout.phinf/20181214_104/1544751962921x2FkB_JPEG/KakaoTalk_20181214_101822117.jpg"]},{"r":5,"d":"2018-11-28","a":"holi*****","t":"칼로리 계산은 안하지만\n뒤에 칼로리 계산표도 있고\n속에 디데이 백일 꾸준히 다 써보는게\n목표입니다 그전에 쳐박히지 않아야할텐데","h":1,"b":false,"s":"2006874908","p":["https://phinf.pstatic.net/checkout.phinf/20181128_1/1543409405747Vr8dU_JPEG/5882C72B-3047-491F-9F54-1BBD109831B5.jpeg"]},{"r":5,"d":"2018-11-24","a":"ham0***","t":"다이어터에겐 일기가 필수라는데 꾸준히 써야겠어요 ㅋㅋㅋ 좋아요","h":1,"b":false,"s":"2006874908"}]