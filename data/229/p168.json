[{"r":5,"d":"2023-10-25","a":"je****","t":"색감도 좋고 구성도 디자인도 좋아요","h":0,"b":false,"s":"4521948451","p":["https://phinf.pstatic.net/checkout.phinf/20231025_115/1698233489058FywIv_JPEG/IMG_4454.jpeg"]},{"r":5,"d":"2023-10-24","a":"cama********","t":"첫째때쓰던거라또구입했어요","h":0,"b":false,"s":"4521948451","p":["https://phinf.pstatic.net/checkout.phinf/20231024_90/1698123414246zgyTS_JPEG/1698123403754.jpg"]},{"r":5,"d":"2023-10-24","a":"tpwl*******","t":"조리원에서 나와서 지금까지 정말 잘 쓰고 있어요!\n핸드폰 어플로 하는 것보다 손으로 쓰는게 더 좋네요","h":0,"b":false,"s":"4521948451"},{"r":5,"d":"2023-10-24","a":"yeri*******","t":"쓰기 편리하게 구분되어 있어서 좋아여😊","h":0,"b":false,"s":"4521948451"},{"r":5,"d":"2023-10-24","a":"egg_****","t":"딱 필요한 구성이에요.","h":0,"b":false,"s":"4521948451","p":["https://phinf.pstatic.net/checkout.phinf/20231025_99/1698190515146ve6W8_JPEG/image.jpg"]},{"r":5,"d":"2023-10-23","a":"beeb****","t":"좋아요좋아요좋아요좋아요","h":0,"b":false,"s":"4521948451"},{"r":5,"d":"2023-10-21","a":"bbka***","t":"네번째 구입입니다^^","h":0,"b":false,"s":"4521948451","p":["https://phinf.pstatic.net/checkout.phinf/20231021_88/1697862652469T8O3A_JPEG/9DF2B838-717E-44F2-8C4B-97487432AE3B.jpeg"]},{"r":5,"d":"2023-10-21","a":"jins*******","t":"출산 용품 준비 중이시라면 꼭 사세요.\n출산하고 민트색 사서 6개월동안 하루도 빠짐없이 아기 얼마나 먹고, 얼마나 자고, 얼마나 쌌는지 기록했어요. \n아기들은 하루 수유량과 자는 시간의 적정량이 있으니 기록을 해야 알 수 있는데, 산후도우미 이모님, 남편과 같이 기록할 수 있어서 좋았어요. \n\n그리고 제가 다이어리 쓰는거 진짜 못하는데, 하루 하루마다 밑에 쓰는 칸이 작아서 아기 발달 위주로 처음하는 행동들, 나아지는 행동들, 좋았던 일, 힘들었던 일 등등 굵직한것들울 짧게 쓰니까 쉽게 자주 쓰게되고 발달 기록도 되서 좋아요.  \n\n나중에 아들이 크면 보여주려구요.\n너가 이렇게 먹고 자고 싸고 자랐다ㅎㅎ \n\n정신없이 육아하다보니 벌써 6개월이 다 되어가서 이번엔 보라색으로 구매해봤어요. \n민트색도 보라색도 다 너무 이뻐요. \n\n알파벳 스티커를 서비스로 주셔서 다이어리 표지에 아들에게 하고싶은 말을 써봤어요. \n한층 더 이뻐진거 같아요. 감사합니다☺️","h":3,"b":true,"s":"4521948451","p":["https://phinf.pstatic.net/checkout.phinf/20231021_243/1697889629469S4AFP_JPEG/20231021_205531.jpg","https://phinf.pstatic.net/checkout.phinf/20231021_255/16978896298462NIdY_JPEG/20231021_205803.jpg","https://phinf.pstatic.net/checkout.phinf/20231021_36/1697889630330t9BDg_JPEG/20231021_205918.jpg","https://phinf.pstatic.net/checkout.phinf/20231021_200/1697889630663ueoQp_JPEG/20231021_205945.jpg","https://phinf.pstatic.net/checkout.phinf/20231021_82/1697889630900iKjaR_JPEG/20231021_205726.jpg","https://phinf.pstatic.net/image.nmv/shopnbuyer_2023_10_21_0/793e338d-7009-11ee-8f91-505dac8c3721_03.jpg"]},{"r":5,"d":"2023-10-18","a":"na****","t":"자주 필요한것들을 놓치고 빼먹고 임기응변으로 3n년을 살았어요\n\n아기가 태어나면 수유시간이랑 용량이랑 귀저기 가는 횟수, 잠자는 시간 체크등등 할게 많은데 내가 과연 잘 할 수 있을까 걱정이 앞섰어요\n\n원래는 플래너나 다이어리를 쓰려고 문구류를 써칭하다가 이렇게 좋은게 세상에 있다는걸 알아버렸네요!\n\n너무나 꼼꼼하고 세세하게 아기에 대한 모든것을 기록할 수 있어요. 잘차려진 밥상이니까 나만 눈 크게뜨고 노트를 자주 들춰보고 기록하는\n습관을 들이면 될것 같아요\n\n디자이너님도 이 노트 내용 구성하는데 정말 고민많이 하셨을것 같아요. 어떻게 이런것까지 구성을 하셨나 싶어요. \n\n아직 예정일이 많이 남아서 사용하기까지 시간이 좀 남았지만 아기 낳고나서 초반에는 정신없을거니까 미리 구성을 보고 익혀놓는것도 좋을것 같아요","h":1,"b":true,"s":"4521948451","p":["https://phinf.pstatic.net/checkout.phinf/20231018_65/1697611968158XXhNy_JPEG/image.jpg","https://phinf.pstatic.net/checkout.phinf/20231018_218/1697611993645UUNGP_JPEG/image.jpg","https://phinf.pstatic.net/checkout.phinf/20231018_183/1697612009484k89Qa_JPEG/image.jpg","https://phinf.pstatic.net/checkout.phinf/20231018_131/1697612030315CdiP3_JPEG/image.jpg","https://phinf.pstatic.net/checkout.phinf/20231018_146/16976120482332gULj_JPEG/image.jpg","https://phinf.pstatic.net/checkout.phinf/20231018_17/1697612060528xKqff_JPEG/image.jpg"]},{"r":5,"d":"2023-10-17","a":"sjih*****","t":"알바 하던곳 사장님이 임신하셔서 구매했어요\n잘 사용 하시면 좋겠네용 ㅎㅎ","h":0,"b":false,"s":"4521948451"}]