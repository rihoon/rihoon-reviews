[{"r":5,"d":"2025-03-08","a":"juin*******","t":"개인교습소를 운영하고 있습니다. 학교 선생님은 아니지만 적당한 수첩을 찾지 못해 헤매다 구입해봤는데 수강생 관리와 수업진도 일정괸리하기도 좋고 괜찮네요 \n디자인도 재질도 너무 마음에듭니다 재구매율100프로!","h":0,"b":true,"s":"9615254308","p":["photos/669/c4d40c86942b.jpg"]},{"r":5,"d":"2025-03-08","a":"wisd******","t":"필요했었는데 세일기간에 잘 샀어요~","h":0,"b":false,"s":"9615254308","p":["photos/669/059fcdbaa887.jpg"]},{"r":5,"d":"2025-03-08","a":"lyes*****","t":"배송 빠르게 잘 받았어요~~","h":0,"b":false,"s":"9615254308","p":["photos/669/118904d8a32c.jpg"]},{"r":5,"d":"2025-03-08","a":"ja17****","t":"교무수첩으로 사용하기 좋네요. 디자인도 넘 예뻐요!","h":0,"b":false,"s":"9615254308"},{"r":5,"d":"2025-03-08","a":"hl****","t":"누가기록 체크리스트회의일지 이런거 빼고 그냥 모눈페이지로 조금 넉넉히 주시고 \n나머진 일일학급일지를 한바닥으로 하면 좋을듯해요~~~ 퀄이랑 만족해요!","h":1,"b":false,"s":"9615254308","p":["photos/669/3a28061d45f9.jpg"]},{"r":5,"d":"2025-03-08","a":"sooz*****","t":"배송도 빠르고 너무 예뻐요:)","h":0,"b":false,"s":"9615254308","p":["photos/669/790a866f36d5.jpg"]},{"r":3,"d":"2025-03-07","a":"wldm*****","t":"매년 리훈 다이어리 썼는데 교사용 다이어리 나왔다고 해서 구매했어요. 다이어리 자체는 나쁘지 않은데, 구성이 아쉬워요. 만년형이라 날짜 하나하나 다 써야하는 것도 그렇고 필요없는 페이지도 너무 많습니다. 다이어리라는 기본 내용에 충실하면서 뒷편에 부수적으로 교사를 위한 카테고리를 넣어주는 것도 좋을 것 같아요.","h":0,"b":false,"s":"9615254308"},{"r":5,"d":"2025-03-07","a":"mk****","t":"좋아요 좋아요 좋아요 좋아요","h":0,"b":false,"s":"9615254308","p":["photos/669/28ac2a727cd9.jpg"]},{"r":5,"d":"2025-03-06","a":"cher********","t":"매년 구매합니다\n구성도 잘되어있어서 좋어요","h":0,"b":false,"s":"9615254308","p":["photos/669/53f7883dc055.jpg"]},{"r":5,"d":"2025-03-06","a":"gues******","t":"담임 업무 및 기타 업무와 교과 수업에 굉장히 효율적입니다","h":0,"b":false,"s":"9615254308"}]