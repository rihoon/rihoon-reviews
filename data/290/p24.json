[{"r":3,"d":"2025-01-03","a":"yb****","t":"펜 두께도 얇고 다 좋은데 몇개빼고 나머지는 스무스하게 안나와요;ㅠㅠ","h":1,"b":false,"s":"4779164609","p":["photos/290/adffff74f17f.jpg"]},{"r":5,"d":"2025-01-02","a":"skyd****","t":"필기감도 좋고 사용하기 좋아요ㅎㄹ","h":0,"b":false,"s":"4779164609","p":["photos/290/d17b54e80dc6.jpg"]},{"r":5,"d":"2024-12-26","a":"kkka****","t":"가늘고색도이쁜데 번지지않아너무좋아요~","h":0,"b":false,"s":"4779164609","p":["photos/290/45ec936274a4.jpg"]},{"r":5,"d":"2024-12-23","a":"cad1***","t":"아직 사용전이지만 좋을거 같아요~ 열심히 다꾸해보려구요~","h":0,"b":false,"s":"4779164609"},{"r":5,"d":"2024-12-21","a":"latt*******","t":"펜 잘 나와서 좋아요","h":0,"b":false,"s":"4779164609"},{"r":5,"d":"2024-12-21","a":"mmer********","t":"사진은 기본카메라입니다.\n(확대샷/제품사진 보이는것도 올린거에용)\n\n색상 펜 살까말까 고민하다 구매했는데. 깔끔하니 좋네요. 개별판매 안되는것 같지만 포인트로만 쓰는지라 꽤 오래 쓸것같긴해서 좋네요:) 색상도 만족합니다. 사용감은 볼펜의 느낌이라기보단 물처럼 종이에 스며든다해야하나...? 질감이 볼펜이랑은 달라서 필기감도 살짝 다릅니다! 그래서그런지 필기 중에 끝에 얇게  길어지는 선이 없이 깔끔하고 예쁘게 써지는것같네요. 잘 사용하겠습니다.","h":0,"b":false,"s":"4779164609","p":["photos/290/d518a0948479.jpg","photos/290/7f1c10ea8c74.jpg"]},{"r":5,"d":"2024-12-21","a":"gydu*****","t":"색상도 여러가지에 잘써지고좋아요ㅎㅎ","h":0,"b":false,"s":"4779164609"},{"r":4,"d":"2024-12-20","a":"kyur******","t":"생각보다 부드러운 느낌은 아니네욤","h":1,"b":false,"s":"4779164609","p":["photos/290/8cfba3557300.jpg"]},{"r":5,"d":"2024-12-20","a":"pal1***","t":"얇고 간편하게 쓰기 좋아요!","h":0,"b":false,"s":"4779164609","p":["photos/290/01ae4bc99e91.jpg","photos/290/fc155f0e50ff.jpg"]},{"r":5,"d":"2024-12-18","a":"jkm0****","t":"여러 사이트 다 찾아봤는데 제일 속지 구성이 마음에 들어 구매했습니다 나중에 추억용도로 짧게 하루 일기로 기록해보려고 구매했는데 정말 만족합니다 너무 이쁘고 펜이며 스티커며 마음에들어요!","h":0,"b":false,"s":"4779164609","p":["photos/290/92cdf8346623.jpg"]}]