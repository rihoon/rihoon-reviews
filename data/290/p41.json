[{"r":5,"d":"2023-11-23","a":"tasi****","t":"색이 진짜 풍성하고 너무 너무 마음에 듭니다 부드럽게 써져서 좋고 똥이 안나와 좋네요","h":0,"b":false,"s":"4779164609"},{"r":5,"d":"2023-11-23","a":"beck*****","t":"믿고 쓰는 리훈입니다","h":1,"b":false,"s":"4779164609","p":["photos/290/bfd5246adf83.jpg"]},{"r":5,"d":"2023-11-23","a":"twee******","t":"아주잘써집니다...","h":0,"b":false,"s":"4779164609"},{"r":5,"d":"2023-11-23","a":"educ****","t":"집에 펜이 백개있는데 너무 갖고싶어서 또샀어요\n후회안해요 이뻐요 ㅋㅋㅋ","h":0,"b":false,"s":"4779164609","p":["photos/290/ac2af709b92c.jpg"]},{"r":5,"d":"2023-11-21","a":"love******","t":"항상 잘 사용하고있어요..ㅎ","h":0,"b":false,"s":"4779164609"},{"r":4,"d":"2023-11-19","a":"wngu*****","t":"한번씩 색이 잘 안나와요ㅠㅠ 그래서 두번써야할 경우가 있어요ㅠㅠ","h":0,"b":false,"s":"4779164609"},{"r":5,"d":"2023-11-15","a":"kiwi***","t":"다이어리에 사용하려고 같이 구입했어요\n0.38의 얇은 선이 써지고 잉크똥이나 글씨 쓸 때 끊김이 없어서 사용하기 편합니다\n얇은데도 색상이 선명해서 작은 공간에 쓰기 좋은데 악필은 흘려쓰는게 그대로 보여서 글씨연습해야겠단 생각이 먼저 들었어요ㅋㅋㅋ\n펜이 얇아서 손에 힘이 많이 들어가긴 하는데 잘 써져서 앞으로도 자주 쓸 듯 합니다\n아쉬운건 노랑색이 너무나 노랑이라 글을 쓰면 잘 안 보여요 진노랑 색이었음 좋았겠단 생각이 드네요 \n그리고 은은한 갈색이라던지 오묘한 회색 등 한 20가지 정도로 색상이 늘어났으면 좋겠어요\n케이스도 있어서 다이어리랑 함께 놔두고 쓰기 좋네요 앞으로 잘 써 봐야겠어요!","h":1,"b":false,"s":"4779164609","p":["photos/290/78ec3c46eb3e.jpg","photos/290/04cedc17b813.jpg","photos/290/b9e1f1d36e83.jpg","photos/290/b551246c23f8.jpg"]},{"r":5,"d":"2023-11-14","a":"aiam****","t":"다이어리주문하면서 같이주문했오요!","h":0,"b":false,"s":"4779164609","p":["photos/290/763f40974043.jpg"]},{"r":5,"d":"2023-11-13","a":"coco****","t":"젤펜 얇고 너무 좋아요","h":0,"b":false,"s":"4779164609","p":["photos/290/95f8b1fd1672.jpg"]},{"r":5,"d":"2023-11-12","a":"welc******","t":"펜 얇고 부드럽게 잘 써지네요~\n색이 다양해서 좋아요","h":0,"b":false,"s":"4779164609","p":["https://phinf.pstatic.net/checkout.phinf/20231112_272/1699793525550DItwJ_JPEG/20231109_214447.jpg"]}]