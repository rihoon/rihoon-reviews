[{"r":5,"d":"2026-02-07","a":"kkyc*******","t":"초등아이가 간단히 쓰기 편해요~","h":0,"b":false,"s":"8694232849","p":["photos/625/e9c7aeaba159.jpg"]},{"r":5,"d":"2026-02-04","a":"smil*******","t":"저학년 아이가 쓰기 좋아요","h":0,"b":false,"s":"8694232849"},{"r":5,"d":"2026-02-03","a":"gues*****","t":"계속 잘 쓰면 정착하려구요","h":0,"b":false,"s":"8694232849"},{"r":5,"d":"2026-01-31","a":"bell*******","t":"아이가 스스로 계획을 세우고 실천할 수 있어서 좋습니다\n배송도 빨랐어요","h":0,"b":false,"s":"8694232849"},{"r":5,"d":"2026-01-23","a":"youi***","t":"진짜... 제작자님 어디 계신가요? 그쪽 방향으로 절이라도 올리고 싶은 심정입니다. 초등학생 아이 공부 습관 잡아주려고 안 써본 플래너가 없는데, **'곰부 세우는 스터디플래너'**는 정말 차원이 다르네요.\n​아이들 눈높이에 딱 맞춘 구성은 말할 것도 없고, 디자인이 너무 귀엽고 예뻐서 아이가 먼저 책상에 앉아 플래너부터 펼칩니다. (이게 꿈인가요 생시인가요?) 구성 하나하나에 아이들을 향한 깊은 고민과 애정이 느껴져서 감동했어요.\n​이건 단순한 플래너가 아니라 **'자기주도학습의 마법 지팡이'**입니다. 이런 완벽한 제품 만들어주셔서 정말 감사합니다. 적게 일하고 많이 버세요... 아니, 평생 이 플래너만 만들어주세요! 제 지갑은 이미 열려있습니다!","h":1,"b":true,"s":"8694232849","p":["photos/625/4dd2e455c0a9.jpg","photos/625/335b285a58e3.jpg","photos/625/1a9971862ada.jpg","photos/625/62cb99027323.jpg"]},{"r":5,"d":"2026-01-21","a":"a_re******","t":"아이들 스스로 공부 하기 좋아요","h":0,"b":false,"s":"8694232849"},{"r":5,"d":"2026-01-21","a":"a_re******","t":"스스로 공부를 위해 필수","h":0,"b":false,"s":"8694232849"},{"r":5,"d":"2026-01-20","a":"gjl0***","t":"초등학생 아이 이번 방학에 잘 활용하고 있어요!","h":0,"b":false,"s":"8694232849","p":["photos/625/ef784148e21c.jpg"]},{"r":5,"d":"2026-01-20","a":"gjl0***","t":"공부습관 재정비를 위해 구매했어요. 잘 사용해보겠습니다.","h":0,"b":true,"s":"8694232849","p":["photos/625/27e40cc5679c.jpg"]},{"r":5,"d":"2026-01-20","a":"why1***","t":"아이 스스로 적어보고 계획해보게하는데 좋아요.","h":0,"b":true,"s":"8694232849","p":["photos/625/a893139f66f8.jpg"]}]