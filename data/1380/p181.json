[{"r":5,"d":"2025-07-02","a":"budd******","t":"종이 두께도 괜찮고 사용하기 편해요~\n너무 마음에 들어요~~","h":0,"b":false,"s":"11749306657","p":["https://phinf.pstatic.net/checkout.phinf/20250702_109/1751424123767moapK_JPEG/1000013023.jpg","https://phinf.pstatic.net/checkout.phinf/20250702_280/1751424123666kQAuV_JPEG/1000013024.jpg"]},{"r":5,"d":"2025-07-01","a":"ekf4***","t":"가계부중에 원탑이아닐까싶네요","h":0,"b":false,"s":"11749306657"},{"r":5,"d":"2025-07-01","a":"juso******","t":"이걸 쓰면서 가계부의 신이 되기 위해 노력하겟습니다\n그리고 안에 내용물 구성 보면\n제대로 열심히 사용망 하면은 돈관리의 신이 될 수 있을 것 같습니다","h":0,"b":false,"s":"11749306657"},{"r":5,"d":"2025-07-01","a":"doom***","t":"가계부쓰기 도전하려고 구매했습니다","h":0,"b":false,"s":"11749306657","p":["https://phinf.pstatic.net/checkout.phinf/20250701_47/17513800196218wpEW_JPEG/image.jpg"]},{"r":5,"d":"2025-06-30","a":"miss***","t":"잘쓰고있어요 ㅎㅎ 카테고리별로나눠져있어서 좋아요","h":0,"b":true,"s":"11749306657","p":["https://phinf.pstatic.net/checkout.phinf/20250630_104/1751243760288m71tU_JPEG/1751243732553.jpg"]},{"r":5,"d":"2025-06-30","a":"skfk****","t":"한참동안 고민하다가 큰맘먹고 가계부적기 도전해보기위해 구매하였습니다.\n아이들이 있다보니 생각하지 못한 지출이 자꾸 생겨서 좀 더 계획적으로 사용하기 위해 가계부쓰기 해보려고해요.\n이전에도 몇 번은 책으로 된 가계부를 장만해서 써보려고 했지만, 날짜별로 칸이 나눠져 있는게 조금 아깝다는 생각이 들었던 적이 있습니다( 소비를 안하면 그 칸은 공란이 되니까요^^;).\n그런데, 이 제품은 일주일정도 기간으로 나눠져 있어서 소비가 없는 날에도 공란이 생길 걱정이 없겠어요^^\n품목도 자신이 사용한 용도에 따라서 나눌 수 있다는 점도 편할것 같아요.\n자신은 예적금 관리 페이지와 보험 관련 정리 페이지가 있는데, 한번씩 적어보면서 되새길 수 있는 시간을 갖을 수 있어서 좋았습니다.\n남은 반년 잘 써보고  연말에 지인분들께 선물하고 싶을정도에요^^\n\n많이 파시고, 좋은 상품 더 많이 만들어주세요^^","h":0,"b":true,"s":"11749306657","p":["https://phinf.pstatic.net/checkout.phinf/20250630_221/1751245582592ai799_JPEG/20250630_095101.jpg","https://phinf.pstatic.net/checkout.phinf/20250630_224/1751245582783aXUz6_JPEG/20250630_095128.jpg","https://phinf.pstatic.net/checkout.phinf/20250630_61/1751245582623naTXg_JPEG/20250630_095135.jpg"]},{"r":5,"d":"2025-06-30","a":"rkdd*******","t":"가계부 써보자 해서 삿는데 합리적인 거 같아 조아요.. 잘 써볼게유","h":0,"b":true,"s":"11749306657","p":["https://phinf.pstatic.net/checkout.phinf/20250630_85/17512539519448h13T_JPEG/image.jpg","https://phinf.pstatic.net/checkout.phinf/20250630_121/1751253964299Mlzzz_JPEG/image.jpg"]},{"r":5,"d":"2025-06-30","a":"dkfu*******","t":"돈을 너무 많이 쓰는 것 같아서 어떤 항목에 얼마만큼 쓰는지 확인하고 싶었는데 좋았어요","h":0,"b":false,"s":"11749306657"},{"r":5,"d":"2025-06-29","a":"khk1******","t":"아주 좋습니다 구성도 좋고 내구성도 좋고 지퍼백 스타일의 커버가 맘에 듭니다","h":0,"b":false,"s":"11749306657"},{"r":5,"d":"2025-06-29","a":"tang*****","t":"수기로 쓰니 지출을 줄여야겠다는 인식이 생겨 좋습니다\n칸이 좀 좁아서 작게 써도 좁아요 ㅠㅠ","h":0,"b":false,"s":"11749306657"}]