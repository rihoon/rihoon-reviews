[{"r":5,"d":"2026-02-22","a":"kcel*******","t":"조금 때가 탄게 왔네용~ 하지만 괜찮아요 ㅋㅋ 성격상 일주일내로 때탈것을 알고있기때문에 이정도는 괜찮습니다~~ 어두운걸 사고싶엇으나 핑크밖에 안남아서 이걸삿는데 예뻐요 \n아그리고… 지난번에도 아쉬웠는데 \n내지가 다음년도 2월까지있음 얼마나 좋을까 아쉽네요 ㅠㅠ","h":0,"b":false,"s":"12598575631","p":["photos/1467/b8b7390d0096.jpg","photos/1467/3f242647fddd.jpg"]},{"r":5,"d":"2026-02-22","a":"redb******","t":"다이어리 구성이 너무 좋아요.","h":0,"b":false,"s":"12598575631"},{"r":5,"d":"2026-02-21","a":"tkdg******","t":"표지구성이 마음에들고 색감이 좋아요.","h":0,"b":false,"s":"12598575631","p":["photos/1467/1251d67d9002.jpg"]},{"r":5,"d":"2026-02-21","a":"hyoj*******","t":"잘 쓰고 있습니다.","h":0,"b":false,"s":"12598575631"},{"r":5,"d":"2026-02-21","a":"rldj****","t":"좋아요 ㄴㅐ년에도 구입할거에요","h":0,"b":false,"s":"12598575631"},{"r":5,"d":"2026-02-20","a":"hwan*****","t":"이 색이 너무 갖고싶어서 고민하다 이 구성으로 주문했는데 색이 잘나왔어요.\n업무일지로 가지고 다니기엔 좀 크고 무겁긴한데 안에 펜 꽂을데가 있어서 좋아요.\n근데 왜 목표 쓰는부분에 로고가 있는지는 이해를 못하겠더라고요.\n\n가름끈은 마무리가 조금 엉성하긴했는데 커버랑 색이 맞아서 예뻤습니다. 안구겨지고 와서 좋았고요.\n\n근데 월 단위 목표나 계획 적는 페이지가 있었으면, 진행도 체크페이지가 있었으면, 더 좋을거 같긴 합니다.\n프리노트는 별로 필요없는데 프리랜서나 상사 입장에서는 저 두가지가 필수라서요.","h":0,"b":false,"s":"12598575631","p":["photos/1467/87307e526ea3.jpg","photos/1467/b73e71f6f071.jpg","photos/1467/867168d7c545.jpg","photos/1467/c77c2711be41.jpg","photos/1467/0578cdbbf22c.jpg"]},{"r":5,"d":"2026-02-20","a":"ioco***","t":"너무 만족합니다.잘 쓸게요.","h":0,"b":false,"s":"12598575631"},{"r":5,"d":"2026-02-20","a":"op****","t":"다이어리가 고급스럽고 내지도 유용해요","h":0,"b":false,"s":"12598575631"},{"r":5,"d":"2026-02-19","a":"lmh1***","t":"원하는 구성으로 되어 있어서 좋습니다^^","h":0,"b":true,"s":"12598575631","p":["photos/1467/13b775488456.jpg","photos/1467/d72007cc7c6f.jpg","photos/1467/410393863c7f.jpg"]},{"r":5,"d":"2026-02-19","a":"dntj*****","t":"잘 사용하겠습니다!!","h":0,"b":false,"s":"12598575631","p":["photos/1467/ba2ad2ad0289.jpg"]}]