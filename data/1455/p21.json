[{"r":5,"d":"2025-10-28","a":"regs*****","t":"달력형으로 되어져 있고 2026년형으로 되어져 있어서 내년에  공부계획세우고 성립 할때 도움이 많이 될것 같아요","h":0,"b":true,"s":"12498884627","p":["photos/1455/886307ccd96b.jpg"]},{"r":5,"d":"2025-10-27","a":"hdj0***","t":"마음에 들어요 빠른 배송 감사합니다:D","h":0,"b":false,"s":"12498884627"},{"r":5,"d":"2025-10-26","a":"dltp****","t":"좋아요~ 다쓰고 또 주문할게요","h":0,"b":false,"s":"12498884627"},{"r":5,"d":"2025-10-25","a":"mikk*****","t":"나를 위해 시간가질수 있는 스터디플래너 진짜 잘 선택한것같아요. \n\n책상 위에 펼치면 마음도 차분해지고,\n조금이라도 기록하면 뿌듯함. 이게 수기로 쓰는 매력이지요\n\n이 플래너는 누구보다 바쁘지만 ‘나’를 돌보고 싶은 사람에게 꼭 맞는것같아요.\n\n2026년엔 이 작은 노트 위에서 작은습관 기록해보려해요. \n\n기록이 공부가 되고, 그 기록이 다시 나를 다독여주는 느낌 그럼 전 좀 성장하겠죠😘\n\n거창한 목표보다 ‘오늘 조금이라도 배웠다’는 그 마음이면 새해에도 전 뿌듯할것 같아요.\n\n내 시간을 다시 찾고 싶은 분들께,\n이 플래너를 꼭 추천하고 싶어요.","h":0,"b":false,"s":"12498884627","p":["photos/1455/2b090fe48197.jpg","photos/1455/45675bcca6fa.jpg","photos/1455/12d7fe3e4aa1.jpg","photos/1455/ffb9ffc24155.jpg","photos/1455/eeaf3f042145.jpg","photos/1455/9ccc6e698aae.jpg","photos/1455/e3c46f3d927a.jpg","photos/1455/2ed52f07d0a2.jpg"]},{"r":5,"d":"2025-10-25","a":"smil*****","t":"커버보호도 되어있고 센스있는 스터디플래너에여!\n이번에 자격증 준비 및 어학공부를 위해 샀는데 넘 좋아요\n내년에 좋은 소식 들고 다시 재리뷰하러올게요!","h":0,"b":true,"s":"12498884627","p":["photos/1455/82e8814ad1f1.jpg"]},{"r":5,"d":"2025-10-22","a":"ash1***","t":"좋아요.만족합니다.","h":0,"b":false,"s":"12498884627","p":["photos/1455/d483eafb04d9.jpg"]},{"r":5,"d":"2025-10-21","a":"rndu*****","t":"포장 잘 되고와서 상품 잘받았습니다 잘쓸게요!","h":0,"b":false,"s":"12498884627","p":["photos/1455/58d0ab7d268f.jpg"]},{"r":5,"d":"2025-10-20","a":"sujj*******","t":"성인이지만 따로 공부하는 것들을 계획있게 해보려고 구매했어요ㅎ 두권이라서 더 좋네요☺️","h":0,"b":false,"s":"12498884627","p":["photos/1455/92219c8960e2.jpg"]},{"r":5,"d":"2025-10-20","a":"drea*****","t":"아이가 사용하기에 편하게 되어있어서 만족합니다.","h":0,"b":false,"s":"12498884627","p":["photos/1455/ef9d0bbe5bf3.jpg"]},{"r":5,"d":"2025-10-20","a":"0320***","t":"1 +1행사로 구매해서 너무 좋아요\n열심히 체계적으로 공부해서 목표로 하는 자격증에 합격했으면 좋겠어요","h":0,"b":false,"s":"12498884627","p":["photos/1455/de380493c079.jpg"]}]