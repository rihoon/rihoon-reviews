[{"r":5,"d":"2026-04-20","a":"js****","t":"초등학교 3학년때부터 사용하여 현재 4학년인데 \n잔소리 안하고싶은 엄마들 무조건 사세요 ㅎ \n보상 및 칭찬스티커도 있어서 함께 목표도 설정해보고 스스로 할일을 생각해보는 계기가 되서 잔소리가 반으로 줍니다\n스트레스도 반으로 줄어요 ㅎㅎ 구성도 간편하고 좋아요","h":0,"b":false,"s":"7992212314"},{"r":5,"d":"2026-04-19","a":"sira******","t":"잘 사용하고 있습니다.","h":0,"b":false,"s":"7992212314","p":["photos/1548/13fff33e2a79.jpg"]},{"r":4,"d":"2026-04-16","a":"good****","t":"1학년 때부터 아이가 사용하고 있어요.\n좋은 가격에 구매했어요!!","h":0,"b":false,"s":"7992212314","p":["photos/1548/4b343b6b6820.jpg"]},{"r":5,"d":"2026-04-15","a":"sook*******","t":"기록남기면서 매일 숙제하면 좋을것같아서 샀어요","h":0,"b":false,"s":"7992212314"},{"r":5,"d":"2026-04-15","a":"poro****","t":"스터디 플래너를 사용하고 싶어해서 처음 주문해봤어요. 흠집 제품이라 되어 있지만 일부러 찾지 않으면 모를 정도인데 좋은 가격에 구입하게 되어 정말 만족스러워요. 이번에 2권 샀는데 더 쟁이고 싶은 마음이에요.","h":0,"b":false,"s":"7992212314","p":["photos/1548/dea7e6552496.jpg","photos/1548/b10e5ee82796.jpg","photos/1548/ad4d52beb349.jpg","photos/1548/e020f61e9fad.jpg","photos/1548/b8f117d7b134.jpg","photos/1548/2299c61ac0ec.jpg","photos/1548/a6417bb461f3.jpg","photos/1548/9c621852198d.jpg","photos/1548/2dbb4fab5841.jpg","photos/1548/04b18f0f518b.jpg"]},{"r":5,"d":"2026-04-15","a":"msj1***","t":"사길 잘한거 같아요 고학년이면 알아서 잘쓸것같아요","h":0,"b":false,"s":"7992212314","p":["photos/1548/62d4f9423225.jpg"]},{"r":4,"d":"2026-04-13","a":"glor***","t":"흠집제품이라 저렴하게 구매했는데 표지에 스프링 자국 조금 있고 나머지는 깨끗해요. 아이가 스스로 공부계획 세우고 할 일 빠뜨리지않게 점검하는 용도로 적당합니다.","h":0,"b":false,"s":"7992212314","p":["photos/1548/9931cbe9e7be.jpg"]},{"r":5,"d":"2026-04-13","a":"nama****","t":"아이 플래너로 구매합니다","h":0,"b":false,"s":"7992212314"},{"r":4,"d":"2026-04-13","a":"jesu*****","t":"초등아이 스케쥴관리해보려고\n구매했어요. 좋아요 ^^\n흠집제품이라는데 찾을수 없어요 ㅎ","h":0,"b":false,"s":"7992212314","p":["photos/1548/58d07086a3c0.jpg"]},{"r":5,"d":"2026-04-09","a":"dusd*****","t":"흠집있어 할인한다지만 크게 못느낄정도예요.","h":0,"b":false,"s":"7992212314"}]