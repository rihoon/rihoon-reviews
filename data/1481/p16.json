[{"r":5,"d":"2026-02-07","a":"foxb****","t":"이제 한달 조금 더 사용했네요. 사실 유행하던 5년후 나에게 라는 도서를 사서 2번이나 실패했어요. 그래서 망설이다 5년 다이어리는 놓쳤고,  10년과 3년 중 고민하다 결국 3년 다이어리를 샀는데 맘에 들어요. 질문에 답하는 형식은 1년 후에도 답이 똑같은 경우가 많아서 이게 의미가 있나 싶었는데 자유롭게 쓰니까 오히려 더 열심히 쓰게 되요 ^^  \n3년 열심히 쓰고 나면 다시 또 도전할 수 있게 꾸준히 상품이 나와주길!","h":0,"b":false,"s":"12697165202"},{"r":5,"d":"2026-02-06","a":"pcm0****","t":"배송도 빠르고 너무 좋아요😆👍","h":0,"b":false,"s":"12697165202"},{"r":5,"d":"2026-02-05","a":"cell*****","t":"해당일내용을\n 한눈에 10년기록을 볼스있으니좋아요","h":0,"b":false,"s":"12697165202"},{"r":5,"d":"2026-02-05","a":"gkwo****","t":"육아일기 쓰려고 구입했어요! 좋아요","h":0,"b":false,"s":"12697165202","p":["photos/1481/ac800b584698.jpg"]},{"r":5,"d":"2026-02-05","a":"yumi*****","t":"색감과 내지아주 마음에 들어요","h":0,"b":false,"s":"12697165202","p":["photos/1481/436d0d60a0bb.jpg"]},{"r":5,"d":"2026-02-04","a":"oh99****","t":"매년 1년짜리 다이어리만 썼는데 할인하길래 처음 사봤어요-!!\n적당한 칸이라 생각 되고 일상보다는 그 때의 생각을 적고 싶어서 샀는데 만족합니다\n만년필로 사용해도 안 비치고 맨 처음에 취향모음집 부분도 한눈에 볼 수 있게 되어있어서 너무 마음에 들어요!!","h":0,"b":true,"s":"12697165202","p":["photos/1481/a3caeff55a05.jpg","photos/1481/3c18aa3cc79b.jpg"]},{"r":5,"d":"2026-02-04","a":"chlo******","t":"생각보다 두꺼웠지만 종이질이 좋네요. 5년을 사려고 했는데 품절이라 10년을 구매했는데,, 잘 기록 해보겠습니다","h":0,"b":false,"s":"12697165202","p":["photos/1481/4e48a62f76c0.jpg"]},{"r":5,"d":"2026-02-04","a":"lsde******","t":"잘사용하겠습니다\n감사삽니다","h":0,"b":false,"s":"12697165202"},{"r":5,"d":"2026-02-04","a":"iamj***","t":"예쁘고 좋아요..다만 모서리 파손이네요..","h":0,"b":false,"s":"12697165202","p":["photos/1481/129ab32edba6.jpg","photos/1481/9649df208237.jpg"]},{"r":5,"d":"2026-02-04","a":"wooy*****","t":"10년 다이어리가 있는걸 알고 바로 검색해서 요 제품 찾았어요\n받아보니 커버도 보들보들하고 너무 기분이 좋았어요\n받자마자 1월부터 가득 채워넣었네요","h":0,"b":true,"s":"12697165202","p":["photos/1481/3c7f4e5428b5.jpg","photos/1481/5aedbb16d354.jpg","photos/1481/f13447e575b4.jpg","photos/1481/4cbab9c75eea.jpg"]}]