[{"r":5,"d":"2022-10-27","a":"khj9****","t":"1년 동안 공부할 생각으로 구매했는데 구성도 좋고 공부 의지가 생깁니다!!","h":0,"b":false,"s":"2474700759"},{"r":4,"d":"2022-10-25","a":"yi****","t":"공시생에게 최적화된 플래너입니다.\n좋아요! 과목 쓰는 칸이 줄로 나누어져있으면 더 좋을 것 같습니다.\n1년용이라 무거운편이긴하지만, 비침도 없고 한권에 모두 기록 할 수 있어서 좋아요.\n\n일주일 목록에\n잘한점, 못한 점, 고쳐야할 점이 있는 칸이 있으면 한 눈에 확인하기 더 좋을 것 같습니다.\n\n종이질 좋아 비침이 적고, 앞면이 구겨질 위험이 없습니다. 일주일을 한 눈에 볼 수 있어서 좋습니다. 크기도 적당하여 책 가방에 잘 들어갑니다. 1년용 플래너가 필요하신다면 만족하실꺼라 봅니다. :-)","h":0,"b":false,"s":"2474700759"},{"r":5,"d":"2022-10-24","a":"aa****","t":"이쁘고 내년에 잘 활용할꺼 같아요!!","h":0,"b":false,"s":"2474700759"},{"r":5,"d":"2022-10-24","a":"aa****","t":"이쁘고 잘 사용할 수 있을꺼 같아요","h":0,"b":false,"s":"2474700759"},{"r":5,"d":"2022-10-24","a":"aa****","t":"이쁘고 잘 사용할 수 있을꺼 같아요","h":0,"b":false,"s":"2474700759"},{"r":5,"d":"2022-10-24","a":"aa****","t":"이쁘고 잘 사용할 수 있을꺼 같아요","h":0,"b":false,"s":"2474700759"},{"r":5,"d":"2022-10-21","a":"snow***","t":"너무 맘에 쏙 들어요","h":0,"b":true,"s":"2474700759","p":["https://phinf.pstatic.net/checkout.phinf/20221021_277/16663519391133BdFo_JPEG/image.jpg"]},{"r":4,"d":"2022-10-16","a":"sing****","t":"플래너 여러종류 써봤는데 제일 좋아요, 계획세우기에 딱이에요","h":0,"b":false,"s":"2474700759","p":["https://phinf.pstatic.net/checkout.phinf/20221016_175/1665897683755X6Wta_JPEG/20221016_141512.jpg","https://phinf.pstatic.net/checkout.phinf/20221016_267/1665897695752aE8XL_JPEG/20221016_141518.jpg"]},{"r":5,"d":"2022-10-14","a":"rook***","t":"디자인도 좋고 깔끔합니다","h":0,"b":true,"s":"2474700759","p":["https://phinf.pstatic.net/checkout.phinf/20221015_247/1665759881575eyf2E_JPEG/1665759874606.jpg"]},{"r":4,"d":"2022-10-11","a":"tjgu******","t":"1년용이라 그런지 큼직하고 무거워요. 다만 데일리보다 위클리 형식을 좋아해서 마음에 드네요 잘 쓰겠습니다","h":0,"b":false,"s":"2474700759","p":["https://phinf.pstatic.net/checkout.phinf/20221011_289/1665492909903W3GDo_JPEG/20221011_215038.jpg"]}]