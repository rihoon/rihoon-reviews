[{"r":3,"d":"2024-01-04","a":"bobo******","t":"작년에 날짜 표기된 제품으로 사서 너무 잘썼는데...\n아무리 봐도 같은 제품이 없어 찾다보니\n올해는 날짜 미표기만 나오네요 ㅜㅜ\n\n불편해요. \n\n달력 다시 봐야하고. \n일일이 써 넣어야하고... ㅜㅜ\n\n전 스케쥴러로 진짜 잘 쓰는데. 날짜 표기도 내년에는 꼭 만들어주시면 좋겠어요.\n\n사진은 작년제품과 비교해서 찍었어요.","h":5,"b":false,"s":"2474700759","p":["photos/147/40094d7f5fbc.jpg"]},{"r":4,"d":"2024-01-04","a":"alli*******","t":"이뻐서 샀는데 생각보다 큰 사이즈에 비해 일일 공부계획 쓰는 칸이 너무 작아서 눈이 피로해요ㅜㅜ 칸이 조금 더 넓고 하루 돌아보는 칸이 있으면 좋겠어요","h":1,"b":false,"s":"2474700759"},{"r":5,"d":"2024-01-03","a":"kimy*****","t":"이거사용해보고 아이공부습관을 좀 구체적으로 볼수있어서 매우 좋네요 하루 공부일기가 되니 문제점 파악이 빨라서 괜찮습니다","h":0,"b":false,"s":"2474700759"},{"r":5,"d":"2024-01-03","a":"kimy*****","t":"공부일기가 가능하니 나뿐습관 찾는것도 좋으네요","h":0,"b":false,"s":"2474700759"},{"r":4,"d":"2024-01-03","a":"yeon********","t":"색깔도 너무 예쁘고 같이 보내주신 스티커도 너무 귀엽네요 ㅋㅋㅋ 감사해요~ 열심히 공부할게요!!","h":0,"b":false,"s":"2474700759","p":["photos/147/2c6d7a882616.jpg"]},{"r":3,"d":"2024-01-03","a":"hsoo****","t":"플래너 디자인 예뻐요","h":0,"b":false,"s":"2474700759"},{"r":5,"d":"2023-12-31","a":"gyh1***","t":"빠른 배송 화면과 같아요","h":0,"b":false,"s":"2474700759","p":["photos/147/cfc1de417f01.jpg"]},{"r":5,"d":"2023-12-31","a":"gyh1***","t":"매년 씁니다 좋아요","h":0,"b":false,"s":"2474700759","p":["photos/147/5e5a6b52daf1.jpg"]},{"r":4,"d":"2023-12-31","a":"yuna*********","t":"플래너 잘 쓰겠습니다","h":0,"b":false,"s":"2474700759"},{"r":4,"d":"2023-12-20","a":"lees*****","t":"수험생전용인가요;;\n다른시험준비중인사람들도 쓸수있었으면;;","h":0,"b":false,"s":"2474700759"}]