[{"r":5,"d":"2024-02-22","a":"qlfb****","t":"아직도 이쁘게 잘쓰고 있습니다","h":0,"b":false,"s":"9159740580"},{"r":4,"d":"2024-02-22","a":"rlaw*******","t":"다이어리를 샀는데 주변에서도 다 같은걸 구매했더라구요\n레이아웃은 항상 넘 맘에 들어요!\n표지가 때가 잘 타는게 좀 아쉽습니다","h":0,"b":false,"s":"9159740580"},{"r":5,"d":"2024-02-22","a":"babo***","t":"예전과 다르게 모든 업무를 컴퓨터나 노트북으로 해결하는 시대가 되었는데요.\n\n​하지만.. 저도 그렇지만 제가 저장 한 파일을 못 찾는 경우도 있고 다이어리처럼 매일 안 보다가 잊어버리는 경우도 많아요.\n\n​그래서 계획이나 스케쥴 플래너와 같은 경우는 매일 들고 다니는 휴대폰에도 저장을 하지만 다이어리 하나 있으며 좋겠다는 생각이 들더라고요.\n\n안그래도 다이어리 하나 구매할려고 알아보다가 정말 좋은 기회로 2024다이어리 데일리플래너 디자인 맛집 리훈 제품을 사용해보았는데 진짜 너무너무 이쁜 디자인에 구성까지 완벽한 다이어리를 알게 된거 같아서 이건 꼭 추천해드리고 싶어서 이렇게 후기를 남겨봅니다.","h":0,"b":false,"s":"9159740580","p":["https://phinf.pstatic.net/checkout.phinf/20240222_199/1708613641227BG4X8_JPEG/KakaoTalk_20240222_201907216_12.jpg","https://phinf.pstatic.net/checkout.phinf/20240222_110/1708613641113N0xoT_JPEG/KakaoTalk_20240222_201907216_06.jpg","https://phinf.pstatic.net/checkout.phinf/20240222_137/170861364116040RA1_JPEG/KakaoTalk_20240222_201907216_08.jpg","https://phinf.pstatic.net/checkout.phinf/20240222_279/1708613641239uUv7E_JPEG/KakaoTalk_20240222_201907216_13.jpg","https://phinf.pstatic.net/checkout.phinf/20240222_180/1708613641785RHuPT_JPEG/KakaoTalk_20240222_201907216_15.jpg","https://phinf.pstatic.net/checkout.phinf/20240222_134/1708613641092Yxrqo_JPEG/KakaoTalk_20240222_201907216_05.jpg","https://phinf.pstatic.net/checkout.phinf/20240222_61/1708613641865sqBVl_JPEG/KakaoTalk_20240222_201907216_19.jpg","https://phinf.pstatic.net/checkout.phinf/20240222_2/1708613641877IRqtv_JPEG/KakaoTalk_20240222_201907216_22.jpg","https://phinf.pstatic.net/checkout.phinf/20240222_104/1708613641201NuYAr_JPEG/KakaoTalk_20240222_201907216_11.jpg","https://phinf.pstatic.net/checkout.phinf/20240222_272/1708613641938UOXAI_JPEG/KakaoTalk_20240222_201907216_23.jpg"]},{"r":5,"d":"2024-02-22","a":"whmo***","t":"마음에 들어요 마음에 들어요","h":0,"b":false,"s":"9159740580"},{"r":5,"d":"2024-02-22","a":"whmo***","t":"마음에 들어요 마음에 들어요","h":0,"b":false,"s":"9159740580"},{"r":5,"d":"2024-02-22","a":"medi*****","t":"새해 목표로 다이어리를 꾸준히 쓰자였는데\n하루하루 칸이 넓어 기록하기도 편하고 표지도 예뻐서\n계속 진행중 입니다!","h":0,"b":false,"s":"9159740580"},{"r":5,"d":"2024-02-21","a":"3724***","t":"구성이 너무 알차고\n중간중간 내용문구가 너무 가슴에 와닿습니다","h":0,"b":true,"s":"9159740580","p":["https://phinf.pstatic.net/checkout.phinf/20240221_274/170848292699848v6O_JPEG/IMG_4159.jpeg"]},{"r":5,"d":"2024-02-21","a":"sins******","t":"종이의질이 좋고 디자인이 심플해 좋아요","h":0,"b":true,"s":"9159740580","p":["https://phinf.pstatic.net/checkout.phinf/20240221_272/1708484495756CTmLB_JPEG/image.jpg"]},{"r":5,"d":"2024-02-21","a":"suye******","t":"매일매일 일기쓰기 너무 좋아요. 만년형으로 구입해서 불편함없이 잘 사용하고있습니다. :)","h":0,"b":false,"s":"9159740580"},{"r":5,"d":"2024-02-21","a":"kuyp****","t":"작은 사이즈라 한 손에 쏙 잡을 수 있고요.\n내부는 깔끔하게 메모할 수 있도록 만들어진 다이어리입니다.\n가장 최적화된 다이어리 날짜형으로 되어 있어 일기장으로 사용할 수 있어서 좋네요.\n전 영어공부하는데요. \n이제부터 영어 일기 써보려고요.","h":0,"b":true,"s":"9159740580","p":["https://phinf.pstatic.net/checkout.phinf/20240221_25/17085039148015FoTE_JPEG/DSC06540.JPG"]}]