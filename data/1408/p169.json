[{"r":5,"d":"2025-10-10","a":"vmfh******","t":"색상도 이뿌고 마음에들어요","h":0,"b":false,"s":"12343772396"},{"r":5,"d":"2025-10-10","a":"sedo***","t":"벌써 5년째 쓰고있는 다이어리에요!\n항상 잘 쓰고있습니다~~","h":0,"b":false,"s":"12343772396"},{"r":5,"d":"2025-10-10","a":"gmgm****","t":"매년 리훈다이어리로 일기 쓴 지 5년은 넘은 것 같네요.\n내년 다이어리 제가 좋아하는 핑크색이 예쁘네요\n펜도 작년과는 달라졌고요 그립감은 올해 산 게 더 좋은 것 같네요.","h":0,"b":false,"s":"12343772396","p":["https://phinf.pstatic.net/checkout.phinf/20251010_5/1760091183710iLyBd_JPEG/1000124897.jpg"]},{"r":5,"d":"2025-10-10","a":"guk0***","t":"작아서 편리할것 같아요","h":0,"b":false,"s":"12343772396","p":["https://phinf.pstatic.net/checkout.phinf/20251010_76/1760092222417ti6WA_JPEG/1760092212848.jpg"]},{"r":5,"d":"2025-10-10","a":"pink*******","t":"친구들에게 1년을 선물하려고 여러권 구매 했습니다.\n두슨두근 기대되는 26년 좋은 일들로 가득채울\n리훈과 함께.","h":0,"b":false,"s":"12343772396"},{"r":5,"d":"2025-10-10","a":"shin*****","t":"색상도 너무이뿌고 내년 2026년이 너무 기대됩니다","h":0,"b":true,"s":"12343772396","p":["https://phinf.pstatic.net/checkout.phinf/20251010_4/176009440800570h2G_JPEG/25215.jpg"]},{"r":5,"d":"2025-10-10","a":"daip****","t":"표지 문구가 귀여웠는데 매일 못쓸것같아서 만년으로 사봤어요.","h":0,"b":false,"s":"12343772396","p":["https://phinf.pstatic.net/checkout.phinf/20251010_239/1760095874466j8B3W_JPEG/20251010_193352.jpg"]},{"r":5,"d":"2025-10-10","a":"ji****","t":"리훈 다이어리는 이번에 처음 접해봤는데 2026 다이어리 디자인이 깔끔하고 예뻐 보여서 구매해봤습니다.\n\n실물로 받아보니 확실히 겉이 단단하고 각이 잡혀있어서 편해 보이더라고요. 모서리가 둥글어서 찔릴 일이 없어 보이고, 가름 끈도 색이 예쁘고 판판한 느낌이라 잘 어울렸습니다. 그래서인지 내부는 딱딱하게 펴지려나 했는데 다행히 부드럽게 모든 편이 잘 펼쳐져서 좋더라고요. 맨 뒤에 있는 수납 봉투도 흐물거리지 않고 넓게 펼치게 되어 있어서 다이어리 들고 다닐 때 유용하게 쓸 것 같아요.\n\n내지 디자인은 애초에 이 다이어리를 선택한 이유였던 만큼 선이 진하지도 않고 깔끔한 느낌 + 적당히 다양한 레이아웃이 있어서 만족스러웠습니다. 종이는 전혀 얇지 않고 적당한 느낌이라 비침도 없어 보여서 본문대로 만년필 말고는 다 괜찮을 것 같습니다. 어서 내년이 되어서 써보고 싶네요!","h":2,"b":true,"s":"12343772396","p":["https://phinf.pstatic.net/checkout.phinf/20251010_260/1760096948957FVCkc_GIF/1.gif","https://phinf.pstatic.net/checkout.phinf/20251010_147/1760096952825A2lJ4_JPEG/2.jpg","https://phinf.pstatic.net/checkout.phinf/20251010_229/1760096958342Q0sQk_JPEG/3.jpg","https://phinf.pstatic.net/checkout.phinf/20251010_70/1760096962545GS7b2_JPEG/4.jpg","https://phinf.pstatic.net/checkout.phinf/20251010_261/1760096966966ih6Rx_JPEG/5.jpg"]},{"r":3,"d":"2025-10-10","a":"jm****","t":"내년 다이어리를 미리 구매했어요 \n너무 이쁘고 괜찮아서 펜과 스티커도 같이 주문 했어요\n넘. 마음에 들고 내년이 기다려지네요^^","h":0,"b":false,"s":"12343772396","p":["https://phinf.pstatic.net/checkout.phinf/20251010_215/17600982763483XrH4_JPEG/IMG_1787.jpeg"]},{"r":5,"d":"2025-10-10","a":"ha****","t":"보이는 그대로 알차네요- 만족스럽습니다!","h":0,"b":false,"s":"12343772396"}]