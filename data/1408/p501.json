[{"r":5,"d":"2024-01-11","a":"bums****","t":"깔끔하고 딱찾던 다이어리","h":0,"b":false,"s":"9159740580"},{"r":5,"d":"2024-01-11","a":"chee*****","t":"고급지고 아주 만족합니다.예쁘고 튼튼해 보여서 만족합니다.번창하세요~","h":0,"b":false,"s":"9159740580"},{"r":5,"d":"2024-01-11","a":"kang******","t":"재질도 질리지않게 짜여진 패턴이고 부드럽고 튼튼한거 같아요. 실속있고 완전 만족이요^^","h":0,"b":false,"s":"9159740580"},{"r":5,"d":"2024-01-11","a":"kht1***","t":"고급스러워 보이고 좋은 것 같네요~! 유행타지 않으면서 지겨워질 것 같지 않고, 크기도 좋고!!","h":0,"b":false,"s":"9159740580"},{"r":5,"d":"2024-01-11","a":"nene***","t":"회사에서 나온 수첩이 너무 커서 구매하게 되었는데, 느낌이나 종이재질도 좋고, 일단 크기가 딱 좋네요.","h":0,"b":false,"s":"9159740580"},{"r":5,"d":"2024-01-11","a":"vs****","t":"괜찮네요 가격대비 짱입니다 깔끔 하고 좋네요 빠질염려도없어서 잘쓰고있습니다^^*","h":0,"b":false,"s":"9159740580"},{"r":5,"d":"2024-01-11","a":"tkdd******","t":"잘 사용하고 있습니다. 다이어리 색상도 맘에들고 자잘자잘한 편의성에 신경을 많이 썼네요ㅎㅎ","h":0,"b":false,"s":"9159740580"},{"r":5,"d":"2024-01-11","a":"lulu***","t":"데일리로 사서 잘 쓰고있어요. 종이가 손기름을 너무 잘먹어서 글쓸때 책받침이 필수인건 좀 슬프지만 그래도 만년필도 잘 견디고 좋아요","h":0,"b":false,"s":"9159740580","p":["https://phinf.pstatic.net/checkout.phinf/20240111_41/1704973379649AEd3U_JPEG/KakaoTalk_20240109_212825590.jpg"]},{"r":5,"d":"2024-01-11","a":"gun2*****","t":"크기도 적당하고 두께도 적당하니 좋아요~ 저는 민트로 구했는데 색상도 이쁘고 문구도 마음에 드네요~","h":0,"b":false,"s":"9159740580"},{"r":5,"d":"2024-01-11","a":"skaz*****","t":"만년다이어리로 굳굳\n종이재질도 좋아서 또구먀했네요","h":0,"b":false,"s":"9159740580","p":["https://phinf.pstatic.net/checkout.phinf/20240111_300/1704978084396HGIhx_JPEG/1704978066326.jpg"]}]