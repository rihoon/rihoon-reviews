[{"r":5,"d":"2025-09-10","a":"leee********","t":"속지두 맘에들구 색상이 이뻐서 같은색으루 \n날짜형, 만년형 골랐어요\n일일 날짜에 선 있는거 완전 좋아요","h":0,"b":false,"s":"12343772396","p":["https://phinf.pstatic.net/checkout.phinf/20250911_91/17575241019658nDDf_JPEG/1000082628.jpg","https://phinf.pstatic.net/checkout.phinf/20250911_98/1757524102670yamsQ_JPEG/1000082627.jpg"]},{"r":5,"d":"2025-09-10","a":"3avr****","t":"2013년도부터 쓴 일기는 어디서 받은 노트나 필사본으로 언 노트 등이 있어요\n\n내년에 쓸 일기 사봣어요\n생각보다 작지만 그래도 구성이 아주 좋아여\n저는 그냥 그때마다 쓰는 스타일이라 매일 쓰진 않아서 뭔가 일이 있을 때 서왓어요\n\n여태 다이어리를 구매 한 적이 없는 제게 첨 구매가 리훈 다이어리 인데 리훈의 다른 걸로 살까하다 고민하다가 오늘배송에 솔깃해서 구매했어요\n\n매달마다 적힌 문구들이 맘에 드네요내년엔 다른직종 변경 성공 하길 바라며 \n무리하지 않아도 돼.","h":0,"b":false,"s":"12343772396","p":["https://phinf.pstatic.net/checkout.phinf/20250911_116/1757543252833fVOt5_JPEG/1000013773.jpg","https://phinf.pstatic.net/checkout.phinf/20250911_101/1757543252974rRa76_JPEG/1000013771.jpg","https://phinf.pstatic.net/checkout.phinf/20250911_85/17575432534636iOy8_JPEG/1000013772.jpg","https://phinf.pstatic.net/checkout.phinf/20250911_249/1757543251029espNt_JPEG/1000013774.jpg","https://phinf.pstatic.net/checkout.phinf/20250911_248/1757543250907wvMGG_JPEG/1000013770.jpg","https://phinf.pstatic.net/checkout.phinf/20250911_54/1757543250696AXbUs_JPEG/1000013775.jpg"]},{"r":5,"d":"2025-09-10","a":"genn*****","t":"항상 리훈을 구매하는데 50프로나 세일하길래 또 쟁였습니당🩷🩷🩷","h":0,"b":false,"s":"12343772396","p":["https://phinf.pstatic.net/checkout.phinf/20250911_62/1757545186011w4wa8_JPEG/1000026756.jpg"]},{"r":5,"d":"2025-09-10","a":"genn*****","t":"항상 리훈을 구매하는데 50프로나 세일하길래 또 쟁였습니당🩷🩷🩷","h":0,"b":false,"s":"12343772396","p":["https://phinf.pstatic.net/checkout.phinf/20250911_290/1757545234169APuI6_JPEG/1000026756.jpg"]},{"r":5,"d":"2025-09-09","a":"suns*******","t":"살까 말까 망설이다가 세일 한다고 해서 후다닥 샀어요. 벌써 내년이 기대되요.","h":0,"b":false,"s":"12343772396"},{"r":5,"d":"2025-09-09","a":"cute********","t":"리훈 다이어리는 4년째 사용중이에요 \n구성도 필요한것만 알차게 채워져있고 종이 질도 좋아서 번짐도 없고 매년 더 조금이라도 업그레이드 해서 \n좋은품질의 다이어리를 만들기위해 고민하시는모습이 보여서 좋았어요 \n올해는 어떤 색을 고를까 하다가 제일 먼저 눈에 들어온 핑크를 골랐습니다~!  색상이 밝고 화사하니 기분까지 맑아지는것 같아요 \n50%세일 덕분에 너무나 저렴한 가격에 득템해서\n더 기쁩니다~ \n딱하나 아쉬운점은 미리미리 내년 내후년 계획을 세울때도 많아서 제일 앞페이지 달력/주요행사 에 2년치 달력이 한장만 더 추가 되면 좋겠다 싶은 개인적인 바램이 있어요~^^ (예 2026년 2027년 달력)","h":0,"b":false,"s":"12343772396","p":["https://phinf.pstatic.net/checkout.phinf/20250909_262/1757382213547qdJXv_JPEG/1000036465.jpg","https://phinf.pstatic.net/checkout.phinf/20250909_245/1757382213601xjr4F_JPEG/1000036464.jpg"]},{"r":5,"d":"2025-09-09","a":"kate****","t":"일단 청록색의 커버가 마음에 들었고요. 사이즈도 적당한 크기인 것 같아요. 매일매일 기록할 수 있는 구성이 좋았고 내년 다이어리로 적당한 것 같습니다.","h":0,"b":false,"s":"12343772396"},{"r":5,"d":"2025-09-09","a":"yk****","t":"깔끔하고 마음에 들어요^^","h":0,"b":false,"s":"12343772396","p":["https://phinf.pstatic.net/checkout.phinf/20250909_2/1757400854846xuxsj_JPEG/520.jpg"]},{"r":5,"d":"2025-09-09","a":"ddar****","t":"리훈 다이어리는 처음 사봤는데 깔끔하니 너무 이쁘네요. 배송도 진짜 빨라요","h":0,"b":false,"s":"12343772396","p":["https://phinf.pstatic.net/checkout.phinf/20250909_14/1757410642850TNM7E_JPEG/20250909_183652.jpg"]},{"r":5,"d":"2025-09-09","a":"kuon******","t":"내년부터 잘 써보려규요 행사때 잘 구매했어요","h":0,"b":false,"s":"12343772396","p":["https://phinf.pstatic.net/checkout.phinf/20250909_37/1757412574387iAiFX_JPEG/IMG_5112.jpeg"]}]