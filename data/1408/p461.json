[{"r":5,"d":"2024-02-13","a":"shei*******","t":"갓생목표로 사용중인 리훈 다이어리 구성도 좋고 같이산 스티커도 잼있게 사용중입니다","h":0,"b":false,"s":"9159740580"},{"r":5,"d":"2024-02-13","a":"blue********","t":"'협찬' 만년필로 쓰는데 뒷장에 비치지 않아서 좋아요. 번진다는 이야기에 걱정했는데, 건조시간만 주면 아무 문제가 없네요. 짜임도 좋고, 마음에 들어요.","h":0,"b":false,"s":"9159740580","p":["https://phinf.pstatic.net/checkout.phinf/20240213_94/1707784867025J6pmY_JPEG/KakaoTalk_20240213_093958235.jpg"]},{"r":5,"d":"2024-02-13","a":"rami****","t":"협찬) 초등학생 되는 아이 스케줄러로 구매했어요 스케줄 관리 잘 할 수 있고 무엇보다 아이가 핑크색이라 좋아해요 구성이 풍성 해서 공부 학원 스케줄 다 쓸 수 있어요. 완전 마음에 들어요","h":0,"b":false,"s":"9159740580","p":["https://phinf.pstatic.net/checkout.phinf/20240213_77/1707787409191Muqod_JPEG/IMG_1402.jpeg","https://phinf.pstatic.net/checkout.phinf/20240213_124/1707787407732YIFF7_JPEG/IMG_1415.jpeg","https://phinf.pstatic.net/checkout.phinf/20240213_18/17077874108349Hg84_JPEG/IMG_1413.jpeg"]},{"r":5,"d":"2024-02-13","a":"kimm*********","t":"기본에 충실해서 더욱 좋은 리훈 다이어리에요!\n다꾸 하시는 분들도 좋아할거 같고, \n깔끔한 맛에 쓰는 직장인 분들도 많을 거 같아요. \n데일리, 위클리 다 사용해봤는데 \n위클리는 들고 다니면서 일정 정리하기에도 좋고 \n일기용으로 쓰기에도 좋을 거 같아요. \n\n저는 다꾸하는 걸 좋아해서 기본에 충실한 속지에\n깔끔한 스타일을 좋아하는 데 리훈이 딱 그런거 같아요. \n겉 표지도 예쁘고 문구도 너무 마음에 들어요. \n매년 모아서 열심히 책꽂이에 저장해도 좋을 거 같아요.","h":0,"b":true,"s":"9159740580","p":["https://phinf.pstatic.net/checkout.phinf/20240213_116/1707790294847vSM4h_JPEG/KakaoTalk_20240213_092001424.jpg","https://phinf.pstatic.net/checkout.phinf/20240213_264/1707790299858z1HMt_JPEG/KakaoTalk_20240213_092001424_01.jpg","https://phinf.pstatic.net/checkout.phinf/20240213_206/1707790303992ARFae_JPEG/KakaoTalk_20240213_092001424_02.jpg","https://phinf.pstatic.net/checkout.phinf/20240213_183/1707790308022YAY8y_JPEG/KakaoTalk_20240213_092001424_03.jpg","https://phinf.pstatic.net/checkout.phinf/20240213_51/1707790311595K2mAE_JPEG/KakaoTalk_20240213_092001424_04.jpg","https://phinf.pstatic.net/checkout.phinf/20240213_287/1707790316043b5fds_JPEG/KakaoTalk_20240213_092001424_05.jpg"]},{"r":5,"d":"2024-02-13","a":"1020****","t":"잘쓰고있어요\n색상이 좀더 파스텔이었으면좋겠어요","h":0,"b":false,"s":"9159740580","p":["https://phinf.pstatic.net/checkout.phinf/20240213_126/17078056292246aNbE_JPEG/1707805615727.jpg"]},{"r":5,"d":"2024-02-13","a":"leeu*****","t":"하루 조용히 돌아볼수있는기회를 갖게되 너무너무 좋습니다 아주 잘 사용하고있습니다","h":0,"b":false,"s":"9159740580"},{"r":4,"d":"2024-02-12","a":"03rl*******","t":"두께가 얇아진건 괜찮은데 볼펜으로 쓰면 번져요..\n작년 내지가 더 좋은것 같아요","h":0,"b":false,"s":"9159740580"},{"r":5,"d":"2024-02-12","a":"wd10***","t":"구구절절쓰기좋아요~","h":0,"b":false,"s":"9159740580","p":["https://phinf.pstatic.net/checkout.phinf/20240212_204/1707708347619TUhHo_JPEG/1000043073.jpg"]},{"r":5,"d":"2024-02-12","a":"whit*******","t":"협찬. 일기장으로 쓰면 좋을 구성이지만 업무용으로도 쓸 생각이었는데 크기도 적당하고 무겁지 않아서 들고다니면서 일하기에도 좋아요. \n 모든 내지에 줄이 그어져 있는거 정말 마음에 들어요. 특히 간격도 글자 적어서 간격이 이쁜 크기라서 더 좋아요.\n 내지가 부드러우면서도 매끄럽고 고급스러워서 글자도 부드럽게 잘 적히는 편이에요. 주로 사용하는 펜이 제트스트림 0.5랑 마일드라이너인데 둘다 번짐없고 크게 비침없이 잘 써져서 좋아요.","h":0,"b":false,"s":"9159740580","p":["https://phinf.pstatic.net/checkout.phinf/20240212_231/1707711572259A4tYi_JPEG/KakaoTalk_20240212_131858082_01.jpg","https://phinf.pstatic.net/checkout.phinf/20240212_99/1707711572369NQ96a_JPEG/KakaoTalk_20240212_131858082_02.jpg","https://phinf.pstatic.net/checkout.phinf/20240212_150/1707711572288n0Q6B_JPEG/KakaoTalk_20240212_131858082.jpg"]},{"r":5,"d":"2024-02-12","a":"ma****","t":"짧게 길게 하루를 정리 할 수 있어 좋습니다.\n열심히 쓰고 있어요.","h":0,"b":false,"s":"9159740580"}]