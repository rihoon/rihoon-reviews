[{"r":3,"d":"2025-12-24","a":"tm****","t":"노트 울퉁불퉁한 부분 때문에 글 쓰기가 불편해서 구매했는데 너무 얇아서 별 효과가 없네요. 물가가 많이 오르긴 했나봐요. 이게 2천 원이라니..","h":0,"b":false,"s":"10494818494"},{"r":5,"d":"2025-12-24","a":"zyeo***","t":"독서노트 쓸 때 무지노트에 일정하게 줄 지키면서 쓰고 싶어서 구매했어요. 겸사겸사 책갈피로도 활용 가능해서 하나쯤 가지고 계시길 추천 드려요!","h":0,"b":false,"s":"10494818494","p":["photos/724/d0a79fb8e7bc.jpg"]},{"r":5,"d":"2025-12-24","a":"zyeo***","t":"신년에는 좀 더 계획적으로 일상을 기록하고, 손으로 쓰는 시간을 늘리고자 책받침 겸용으로 구매했습니다. 무지노트에 줄 예쁘게 지켜가면서 쓸 수 있어서 기록 생활이 더 즐거워질 것 같습니다.","h":0,"b":false,"s":"10494818494","p":["photos/724/800a5b5daff4.jpg","photos/724/4f5bce188756.jpg"]},{"r":5,"d":"2025-12-23","a":"nu****","t":"책가도 시리즈 진짜 너무 좋아요 이뻐요","h":0,"b":false,"s":"10494818494"},{"r":5,"d":"2025-12-23","a":"abus******","t":"디자인 예쁘고 품질 좋고\n배송빠릅니다.","h":0,"b":false,"s":"10494818494"},{"r":5,"d":"2025-12-22","a":"jee9***","t":"가격이 저럼해서 좋아요","h":0,"b":false,"s":"10494818494"},{"r":5,"d":"2025-12-22","a":"jee9***","t":"좋은가격으로 잘 구매한것 같아요","h":0,"b":false,"s":"10494818494"},{"r":5,"d":"2025-12-22","a":"dl****","t":"원하던 사이즈와 재질 넘 좋네여 배송빨라요","h":0,"b":false,"s":"10494818494","p":["photos/724/6df49d5af376.jpg"]},{"r":5,"d":"2025-12-22","a":"mint***","t":"네이버배송이라 엄청 빠르게 받았고, 종이재질 아니라 잉크 떨궈서 울 걱정 없어 좋아요 잉크발색용으로 잘라서 받쳐서 씁니다!","h":0,"b":false,"s":"10494818494","p":["photos/724/186a1780bad6.jpg"]},{"r":5,"d":"2025-12-22","a":"mint***","t":"잘라서 펜코보드랑 쓰고있습니당","h":0,"b":false,"s":"10494818494","p":["photos/724/548502747245.jpg"]}]