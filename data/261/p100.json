[{"r":5,"d":"2022-11-03","a":"ssun****","t":"컬러와 사이즈 모두 좋습니다!! 지인에게 이야기했더니 이뿌다고 지인도 삿도라구요! 너무 만족스러워서 구라 조금 보태서 내년이 빨리 왔으면 좋겠어요","h":0,"b":false,"s":"4701111434"},{"r":5,"d":"2022-11-02","a":"alsw*****","t":"좋아요 좋아요 좋아요","h":0,"b":false,"s":"4701111434"},{"r":5,"d":"2022-11-02","a":"alsw*****","t":"빠른 배송 감사합니다","h":0,"b":false,"s":"4701111434"},{"r":5,"d":"2022-10-30","a":"amin***","t":"컬러도 예쁘고 필기감도 부드럽게 잘 써지고 좋아요.","h":0,"b":false,"s":"4701111434"},{"r":5,"d":"2022-10-29","a":"sr****","t":"펜도 얇아서 좋아요!","h":0,"b":false,"s":"4701111434"},{"r":5,"d":"2022-10-28","a":"tjsd*****","t":"이야기 파우치 사면서 추가로 구매했습니다.\n리훈 제품 구매할때 꼭 한 개 이상은 구매하게되는 필수템입니다.\n필기감 아주 만족스럽고 리훈펜으로 정착한지 꽤됐습니다 누구한테나 추천하고 싶은 펜이에요!","h":0,"b":true,"s":"4701111434","p":["https://phinf.pstatic.net/checkout.phinf/20221028_175/1666959907640B9Vxq_JPEG/20221028_212409.jpg"]},{"r":5,"d":"2022-10-26","a":"mh01***","t":"필기감이 완전 좋아요 감사합니다~~~","h":0,"b":false,"s":"4701111434"},{"r":5,"d":"2022-10-21","a":"pliw***","t":"펜까지 세트인줄 모르고 더샀지만 여분으로 두고 잘쓰려합니다.","h":0,"b":false,"s":"4701111434","p":["https://phinf.pstatic.net/checkout.phinf/20221021_243/16663212328368kclQ_JPEG/20221021_115737.jpg"]},{"r":5,"d":"2022-10-21","a":"pliw***","t":"부드럽게 잘써지고 적당히 얇아서 좋아요","h":0,"b":false,"s":"4701111434","p":["https://phinf.pstatic.net/checkout.phinf/20221021_51/1666321280453IRq1R_JPEG/20221021_115737.jpg"]},{"r":5,"d":"2022-10-21","a":"poli******","t":"얇고 선명한 글씨를 원한다면 좋은 펜입니다. 다이어리 쓸 때 비칠 거 걱정 없습니다.","h":0,"b":false,"s":"4701111434","p":["https://phinf.pstatic.net/checkout.phinf/20221021_219/1666353535781Erhif_JPEG/KakaoTalk_20221021_205408777_01.jpg"]}]