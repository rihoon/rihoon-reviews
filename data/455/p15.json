[{"r":5,"d":"2025-12-28","a":"sm****","t":"동생이 잘써서 형것도 주문해봅니다","h":0,"b":false,"s":"5754786426"},{"r":5,"d":"2025-12-27","a":"deuk***","t":"제 다이어리 보러 왔다가 아이들 스터디 플래너 구입하게 되었어요. 받아보니 디자인도 예쁘고 구성이 잘 되어있네요.\n\n플래너에 아이들이 할 일을 직접 계획하고 실행 후에 직접 체크하니 성취감을 더 느끼는 것 같아요. 스티커 붙여주고 리워드까지 주니 더 만족해하네요.\n\n꾸준히 한다면 시간 관리나 자기주도 학습 능력 향상에 도움이 될 것 같아요. 스터디 플래너 추천합니다~^^","h":0,"b":false,"s":"5754786426","p":["photos/455/8219eaacf425.jpg","photos/455/d180fd59e482.jpg","photos/455/9ceedc7f77c1.jpg"]},{"r":5,"d":"2025-12-25","a":"hij2***","t":"빠른 배송 합리적 가격, 초5남아가 벌써 2년째 발 사용하고 있어요.","h":0,"b":false,"s":"5754786426","p":["photos/455/e7dd5e2e2e06.jpg"]},{"r":5,"d":"2025-12-25","a":"naya*****","t":"속지도 이쁘고 아이가 좋아하네요~~","h":0,"b":false,"s":"5754786426","p":["photos/455/14c84e7ae8bc.jpg"]},{"r":5,"d":"2025-12-22","a":"8hye****","t":"아이 저학년때 구매해서 잘 사용했었는데..  \n이제는 고학년이되서  방학때 사용하려고 구매했습니다. 너무 만족하고있습니다.","h":0,"b":false,"s":"5754786426"},{"r":5,"d":"2025-12-22","a":"gent********","t":"귀엽고 알차요^^ 아이가 좋아할거같아요","h":0,"b":false,"s":"5754786426","p":["photos/455/2d54ff6b7a2a.jpg"]},{"r":5,"d":"2025-12-22","a":"eu****","t":"아이가 마음에 들어해요^^","h":0,"b":false,"s":"5754786426","p":["photos/455/9c5babbf2e0c.jpg"]},{"r":5,"d":"2025-12-22","a":"eu****","t":"아이가 마음에 들어해요","h":0,"b":false,"s":"5754786426","p":["photos/455/099217b2324e.jpg"]},{"r":5,"d":"2025-12-20","a":"qlcs*******","t":"저학년용 써보고 좋아서 고학년용으로 구매했어요","h":0,"b":false,"s":"5754786426"},{"r":5,"d":"2025-12-18","a":"shot****","t":"아이 계획표를 사주려고 알아보다가 너무 괜찮아보여 관심을 갖던 중 라이브방송을 보고 바로 그매했습니다. 친절하고 꼼꼼한 설명도 좋고 무엇보다 다양한 제품들 모두 괜찮더라고요. 다른 것도 꼭 구매해보고 싶어요 ㅎㅎ 우선 요것들 예쁘게 알차게 잘 사용하겠습니다!!","h":0,"b":false,"s":"5754786426","p":["photos/455/9441be28a38f.jpg","photos/455/3dde84ba0cd4.jpg"]}]