[{"r":5,"d":"2025-06-02","a":"pakk***","t":"또 주문 했어요 잘 쓰고 있습니다","h":0,"b":false,"s":"10408167229","p":["photos/722/e30d41d0addc.jpg"]},{"r":5,"d":"2025-05-28","a":"park*****","t":"노트와 함께온 책받침이 휘어져 있어서 리뷰 남겼더니 따로 연락주시고 새걸로 보내주시고 같이 보내주신 메모지도 잘쓰겠습니다. 사후 관리가 엄청 잘 되어서 기분이 좋네요. 번창하시고 노트 다 쓰면 다시 구매할께요.","h":0,"b":false,"s":"10408167229","p":["photos/722/29f09a249eef.jpg","photos/722/f7cbf2b93426.jpg"]},{"r":5,"d":"2025-05-23","a":"ky****","t":"배송이 빨라서 좋아요.","h":0,"b":false,"s":"10408167229","p":["photos/722/dba271c3466a.jpg"]},{"r":5,"d":"2025-05-21","a":"wotm*******","t":"심플하고 깔끔한 디자인이 마음에 들어요.\n종이가 부드럽고 얇아요","h":0,"b":false,"s":"10408167229","p":["photos/722/c3ec7dcd3d3e.jpg","photos/722/dac2aed4409d.jpg","photos/722/af14675af115.jpg"]},{"r":5,"d":"2025-05-19","a":"md****","t":"쓰기 좋네요. 만년필용으로 샀어요","h":0,"b":false,"s":"10408167229","p":["photos/722/34acfbad84c3.jpg"]},{"r":5,"d":"2025-05-19","a":"md****","t":"쓰기좋아요 토모에리버","h":0,"b":false,"s":"10408167229","p":["photos/722/26f673950cc4.jpg"]},{"r":5,"d":"2025-05-15","a":"coco****","t":"배송도빠르고 제품도 좋습니다","h":0,"b":false,"s":"10408167229"},{"r":5,"d":"2025-05-06","a":"qhru*****","t":"안녕하세요~ 만년필에 푹 빠져 살고 있는 일인입니다. 그래서 리훈 만년필 필사 노트를 구매했었고 정말 잘 쓰고 있습니다. 그래도 토모에리버의 발색이 너무 좋아서 낱장으로 쓰거나 패드를 사용하고 있었는데 이렇게 착한 가격에 노트를 만들어 주셔서 얼릉 구매했습니다. 그런데 제가 무지를 잘 안쓰는 게 필기할 때 삐툴삐툴하게 써져서 피하게 되는데 그걸 방지하기 위한 책받침도 주시고 너무 유용한 구성인 것 같습니다!\n그리고 요즘 끄적끄적 그림도 그리고 있어 무지도 나름 좋은 것 같구요! 토모에리버 용지에 이렇게 착한 가격으로 리훈만의 감성이 들어간 예쁜 디자인으로 가볍게 노트를 만들어 주셔서 너무 좋습니다~ 나중에 조금만 더 큰 크기로 만들어 주시면 냉큼 살 것 같네요 ㅎㅎㅎ \n발색이랑 비침 테스트는 사진으로 올리겠습니다.","h":3,"b":true,"s":"10408167229","p":["photos/722/9c8fd806e7ec.jpg","photos/722/ac40fbe9405e.jpg","photos/722/f198d76ce500.jpg","photos/722/968adc5fb20e.jpg","photos/722/ab080dd008df.jpg","photos/722/a669392caced.jpg","photos/722/604de9cecdd1.jpg","photos/722/943cd086cd3c.jpg","photos/722/58b70d8810fa.jpg","photos/722/bcbbcd57fc67.jpg","photos/722/430cf294d16a.jpg","photos/722/2d8db51410df.jpg","photos/722/c2eac9c47918.jpg"]},{"r":5,"d":"2025-05-01","a":"tnrm*****","t":"감사합니다 또 구매했어용 그림용으로 굿!!","h":1,"b":false,"s":"10408167229","p":["photos/722/c4b20bfd0f4b.jpg"]},{"r":5,"d":"2025-04-27","a":"123e*******","t":"필기감이 너무 좋아요","h":0,"b":false,"s":"10408167229"}]