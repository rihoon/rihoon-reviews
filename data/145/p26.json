[{"r":5,"d":"2023-12-20","a":"limh*****","t":"배송 매우 빨라요 잘 슬게요","h":0,"b":false,"s":"2475185136","p":["photos/145/babd83c6d1fa.jpg"]},{"r":5,"d":"2023-12-20","a":"vera****","t":"딸래미 공부한다고 샀어요. 잘 활용하길요.","h":0,"b":false,"s":"2475185136","p":["photos/145/f16e698f9c10.jpg"]},{"r":5,"d":"2023-12-19","a":"vnfm****","t":"칸을 여유롭게 작성하기 좋아요","h":0,"b":false,"s":"2475185136"},{"r":5,"d":"2023-12-17","a":"heea****","t":"오배송으로 연락드리자마자 바로 다시 제품 보내주셨어요👍스티커도 덤으로 주셔서 감사합니다:)\n리훈 제품 쓰다가 다른 제품도 써봤는데 링으로 제본된 경우는 가끔 페이지가 매끄럽게 잘 넘어가지 않는데 리훈은 걸리는곳 없이 잘 넘어가서 좋아요!\n그리고 뒷면 비침도 타 제품에 비해 덜 비치는 편이에요! 앞으로 리훈에 정착할 예정입니다ㅎㅎ","h":0,"b":false,"s":"2475185136","p":["photos/145/a00c3e35a0eb.jpg"]},{"r":5,"d":"2023-12-15","a":"eoji***","t":"배송이 빠르고 좋아요","h":0,"b":false,"s":"2475185136","p":["photos/145/c22bb0a0aeb9.jpg"]},{"r":5,"d":"2023-12-09","a":"poro******","t":"n번째 재구매하고있습니다\n마니 파세요","h":0,"b":false,"s":"2475185136","p":["photos/145/9e7969a16f77.jpg"]},{"r":5,"d":"2023-12-08","a":"cjae*******","t":"색깔도 예쁘고 마음에 들어요.","h":0,"b":false,"s":"2475185136"},{"r":5,"d":"2023-12-08","a":"jju5***","t":"벌써 네번째 구매하는 상품입니다. \n하나는 예전에 제가 쓰고, 두개는 조카와 아내에게 선물하였습니다. 이번에 다시 공부하면서 다시 구매하게 되었습니다. \n일정 정리도 깔끔하게 할 수 있고, 순 공부시간도 체크할 수 있어서 너무나도 좋습니다. \n리훈 공부노트를 사용하고 공무원 시험도 합격하였는데, 이번에도 잘 사용하면 준비하는 시험에 \"척\" 붙을 것 같습니다.","h":0,"b":false,"s":"2475185136","p":["photos/145/5ee851972adc.jpg"]},{"r":5,"d":"2023-12-06","a":"hur9***","t":"플래너가 구성도 알차고 예뻐서 좋아요!\n앞으로도 열심히 공부해서 플래너를 예쁘게 꽉 채우는 하루하루들로 보내겠습니다!✨ 파이팅!","h":0,"b":false,"s":"2475185136","p":["photos/145/f6771585529c.jpg"]},{"r":5,"d":"2023-12-04","a":"hitp***","t":"꾸준히 사용하고 있어요","h":0,"b":false,"s":"2475185136"}]