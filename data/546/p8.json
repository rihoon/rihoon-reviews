[{"r":5,"d":"2024-10-27","a":"omyd*****","t":"초음파 사진 정리하고 내용 정리하는데 이만한게 없네요. 나중에 아이 보여줄 생각에 두근두근합니다.","h":0,"b":false,"s":"6958144331","p":["photos/546/2eeb444b0d10.jpg"]},{"r":5,"d":"2024-10-16","a":"dlqm***","t":"임신중 예쁘게 꾸며보려구요","h":0,"b":false,"s":"6958144331"},{"r":5,"d":"2024-10-11","a":"hida****","t":"평소 다이어리 쓰고 사진.글로 기록을 남기는 걸 좋아하는 엄마는 처음 초음파 진료를 다녀오자마자\n다이어리와 초음파 앨범을 구매했습니다💕\n구성이 다양하고 디자인이 예뻐요\n마음을 담아 작성하고 나중에 아기에게 선물해줄거예요:)","h":0,"b":false,"s":"6958144331","p":["photos/546/1673e89bcd33.jpg"]},{"r":5,"d":"2024-10-10","a":"seoy*******","t":"임신다이어리  구매해봐요","h":0,"b":false,"s":"6958144331","p":["photos/546/e431e3c230ff.jpg"]},{"r":5,"d":"2024-10-06","a":"o_oa*******","t":"예쁘게 잘 기록해볼게요 :)","h":0,"b":false,"s":"6958144331","p":["photos/546/5c710d497316.jpg"]},{"r":4,"d":"2024-10-01","a":"ak****","t":"잘사용하고있습니다. 굿굿","h":0,"b":false,"s":"6958144331"},{"r":4,"d":"2024-09-24","a":"yoje*******","t":"임신과정 전체를 담을 수 있을것같아요. 세권 구성 아주 알차네요! 임신기간 이 다이어리에 적힌 질문들 하나씩 답해가면 시간도 잘갈 것 같습니다. 초보 산모에게 유용한 리스트나 정보들도 있어요","h":0,"b":false,"s":"6958144331","p":["photos/546/2affcdf08116.jpg","photos/546/2c0351495936.jpg"]},{"r":5,"d":"2024-09-20","a":"lisa****","t":"임신 사실을 알게 되어 구매했습니다.💝\n남들과는 다른 차별화된 다이어리를 써보고 싶어서 구매한  다이어리인데 완전 만족합니다!🎁💐💝\n아무래도 아기가 태어나기 전에 시간이 여유있을때 쓸 것이 많은데🫶\n출산 전 쓰는 페이지가 많은 점이 만족스럽습니다.😍\n나중에 아기에게도 가보로 물려주고 싶어요!😍❤️😆😀🙋‍♀️","h":0,"b":true,"s":"6958144331","p":["photos/546/d110b399609d.jpg","photos/546/c37276f8361a.jpg"]},{"r":5,"d":"2024-09-20","a":"habs*****","t":"조금 비싼거같았는데 막상 받고나니 잘산거같아요","h":0,"b":false,"s":"6958144331","p":["photos/546/fc805635c1f5.jpg"]},{"r":5,"d":"2024-09-16","a":"wjda********","t":"구성도 좋고 색감도 노랑노랑하니 예뻐요~ 잘 사용하겠습니다😊","h":0,"b":true,"s":"6958144331","p":["photos/546/ee1aaafa49fc.jpg","photos/546/5a874f0af972.jpg","photos/546/8d6c0cf1ea83.jpg"]}]