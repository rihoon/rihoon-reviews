[{"r":5,"d":"2023-08-08","a":"ness****","t":"구성이 좋아요 아직 무슨말을 써야할지 모르겠는데 질문형식으로 적혀있어서 좋아요!","h":0,"b":true,"s":"6958144331","p":["photos/546/5aa138436785.jpg"]},{"r":4,"d":"2023-08-06","a":"hyel******","t":"패키징이 고급져서 선물받는 느낌이었어요!\n다이어리 내용에 질문이 없는게 조금 더 깔끔하고 예뻤을 것 같네요!","h":1,"b":false,"s":"6958144331","p":["photos/546/65cf7ff5cbde.jpg"]},{"r":5,"d":"2023-08-04","a":"yoon****","t":"다이어리 잘쓰고있습니다~","h":0,"b":false,"s":"6958144331"},{"r":5,"d":"2023-08-03","a":"wkfu****","t":"게을러서 예쁘게 꾸미면서 쓰고 있진 못하지만 초음파 사진이랑 중요한 병원 기록들은 상세하게 쓰고 있어요~ 나중에 아기가 태어나고 자라면 보여줘야겠습니다!","h":0,"b":false,"s":"6958144331","p":["photos/546/9a149fdf98d5.jpg"]},{"r":5,"d":"2023-08-02","a":"nank****","t":"쌍둥이들한테 주려고 샀어용 좋아용","h":0,"b":false,"s":"6958144331"},{"r":4,"d":"2023-07-27","a":"gej9***","t":"각자 하나씩도 팔면 좋겠어요. 한번에 3종 다 사야되서 사용하지 않는 것도 있는데 좀 아깝네요. 다이어리만 잘 쓰고 있습니다. 초음파앨범 종이도 조금 꾸겨져서 와서 기분이 별로였어요. 패키지 자체는 예쁘게 잘 만들었는데 전체적인 만족도는 떨어지네요ㅠㅠ","h":0,"b":false,"s":"6958144331","p":["photos/546/b2e0b18954a7.jpg"]},{"r":4,"d":"2023-07-26","a":"gusr******","t":"빨리배송됐어요~ 리훈 가계부 쓰고있는데 임신다이어리가있어서 구입해봤어요. 잘쓸게요","h":0,"b":false,"s":"6958144331","p":["photos/546/1f05a9d973b7.jpg","photos/546/18aac74b7924.jpg"]},{"r":4,"d":"2023-07-25","a":"so****","t":"좋은 구성이고 다양한 편이에요. 다만 디자인이 좀 정적이라서 아쉬워요,","h":0,"b":false,"s":"6958144331"},{"r":4,"d":"2023-07-04","a":"hohy****","t":"사실 생각보다 잘 안 써져요ㅠㅠ 그래도 예뻐용","h":1,"b":false,"s":"6958144331","p":["photos/546/6423c2bb5d0f.jpg","photos/546/a86cdb0744bf.jpg"]},{"r":5,"d":"2023-07-03","a":"nank****","t":"원하는 상품 빠른 배송!","h":0,"b":false,"s":"6958144331"}]