[{"r":5,"d":"2023-10-08","a":"dusg******","t":"24년도 다이어리 미리 구매했어요\n저렴하게 잘구매했어요~","h":0,"b":false,"s":"9159740580","p":["https://phinf.pstatic.net/checkout.phinf/20231008_235/16967472557977IRrA_JPEG/KakaoTalk_20231008_153935615.jpg"]},{"r":5,"d":"2023-10-08","a":"jym2***","t":"매년 구입하는 리훈ㅠㅠ 점점 더 퀄리티도 좋아져서 다른건 못써요ㅠㅠ","h":0,"b":false,"s":"9159740580"},{"r":5,"d":"2023-10-08","a":"l_be***","t":"매년 다이어리만 사다가 달력도 사봤는데\n깔끔하고 칸이 커서 너무 좋네요!","h":0,"b":false,"s":"9159740580","p":["https://phinf.pstatic.net/checkout.phinf/20231009_42/1696808464502Hhkkq_JPEG/424139DC-2DBF-4BEA-A8B1-D9A1561BFD26.jpeg"]},{"r":5,"d":"2023-10-07","a":"shcw****","t":"2024년을 편안한 기분으로 맞이하기 위해\n다이어리를 구매했어요.\n다이어리 꾸밀수 있는 스티커까지 같이 구매했는데 잘 사용할수 있겠죠?ㅎ\n내년에는 계획했던거 많이 이루고 스스로 뿌듯한 한해가 되길 바라며 잘 기록해보려구요ㅎ","h":0,"b":true,"s":"9159740580","p":["https://phinf.pstatic.net/checkout.phinf/20231007_255/1696636697705dGuaf_JPEG/1000008821.jpg"]},{"r":5,"d":"2023-10-07","a":"oxjy*****","t":"작년 리훈 알고 난 후 내년도 리훈 다이어리 사용합니다. 2023 나의 이야기 다이어리 너무나 잘 쓰고 있는중인데 가죽느낌의 케이스와 고무밴딩 너~~~~~무 맘에 들었거든요. 올해는 제가 못 찾은건지 없는건지는 몰라도 그것이 조~~~~금 아쉽더라구요.그래도 밑줄이 있는것이 너무 맘에 들어요. 내년엔 꼭 행복해질 시간을 가져야겠습니다.","h":0,"b":false,"s":"9159740580","p":["https://phinf.pstatic.net/checkout.phinf/20231007_159/1696642055969e89V5_JPEG/1696642032514.jpg"]},{"r":5,"d":"2023-10-07","a":"jsaa****","t":"색상이 예쁜 파랑색이라 너무 좋아요","h":0,"b":false,"s":"9159740580"},{"r":5,"d":"2023-10-07","a":"fl****","t":"수년째 사용하고 있어요~다이어리에 대해 말해 무엇해요!!","h":0,"b":true,"s":"9159740580","p":["https://phinf.pstatic.net/checkout.phinf/20231007_136/1696647471146C7oAY_JPEG/20231007_115609.jpg","https://phinf.pstatic.net/checkout.phinf/20231007_91/1696647471158chpdJ_JPEG/20231007_115554.jpg","https://phinf.pstatic.net/checkout.phinf/20231007_275/1696647471615a5jDs_JPEG/20231007_115510.jpg","https://phinf.pstatic.net/checkout.phinf/20231007_78/1696647471581Yg2WG_JPEG/20231007_115515.jpg","https://phinf.pstatic.net/checkout.phinf/20231007_243/1696647471455eQdjI_JPEG/20231007_115527.jpg","https://phinf.pstatic.net/checkout.phinf/20231007_92/1696647471707n3dW1_JPEG/20231007_115503.jpg"]},{"r":5,"d":"2023-10-07","a":"dail*****","t":"깔끔하고 이뻐요.\n다만 재질이 조금 후반기 가면 때탈거 같기도 하네요^^;;\n그래도 마음에 듭니다. 데일리 나와서 좋아요.","h":0,"b":false,"s":"9159740580","p":["https://phinf.pstatic.net/checkout.phinf/20231007_227/1696648756735TYb5c_JPEG/1000013663.jpg","https://phinf.pstatic.net/checkout.phinf/20231007_10/1696648756783RAykQ_JPEG/1000013661.jpg"]},{"r":5,"d":"2023-10-07","a":"phk1*****","t":"예쁜 색깔이예요.\n이번에 처음 써볼텐데 기대됩니다.\n우리나라 국산이라 더 좋아요.\n추천합니다.","h":0,"b":true,"s":"9159740580","p":["https://phinf.pstatic.net/checkout.phinf/20231007_275/1696654242967D8Q0k_JPEG/1696653996333.jpg"]},{"r":5,"d":"2023-10-07","a":"ksw2***","t":"다이어리 깔끔하고 감성적이고 좋아요 ㅎㅎ\n다만 쓸 수 있는 칸이 적어서 다음에는 데일리로 사야겠어요 ㅠㅠ","h":0,"b":false,"s":"9159740580","p":["https://phinf.pstatic.net/checkout.phinf/20231007_148/1696658593487R28Tt_JPEG/KakaoTalk_20231007_150225708.jpg"]}]