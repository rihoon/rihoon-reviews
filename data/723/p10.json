[{"r":5,"d":"2025-08-05","a":"ehdt******","t":"초등 아이들 방학동안 사용하기 딱 좋은 구성입니다. 디자인도 깔끔하고 귀여워서 좋네요~ 아이가 앞에 스티커 붙이는 목표 달성 부분을 제일 좋아해요! 리훈은 좋은 제품이 많아서 애용하게 되네요!","h":0,"b":true,"s":"6826867677","p":["photos/723/cee91e6f542b.jpg"]},{"r":4,"d":"2025-08-05","a":"oran******","t":"남아이긴하지만 고학년이라 살까말까하다 재밌을듯해 샀어요. 채우는 재미가 있을듯합니다!\n다만 글씨나 칸 간격이 크기가 좀 크다 싶어 아무래도 저학년용이 맞는듯해요. 더 써야할때 줄이 몇줄안되니 모자르다더라구요","h":0,"b":false,"s":"6826867677","p":["photos/723/5dd36548b0cd.jpg","photos/723/d9f846c9428b.jpg"]},{"r":5,"d":"2025-08-04","a":"chil*******","t":"여름방학을 알차게 보내기위해 구매했어요","h":0,"b":true,"s":"6826867677","p":["photos/723/8fba1c45fe2e.jpg"]},{"r":4,"d":"2025-08-04","a":"sdr4***","t":"아이 쓰려고 샀는데요 제가 써야 할꺼 깉아요~구성은 너무 좋아요~초3이지만 아직도 글쓰기 연습중입니다~","h":0,"b":false,"s":"6826867677"},{"r":5,"d":"2025-08-04","a":"jiae*****","t":"방학동안 알차게 보내고 싶어서 스스로 계획표도 짜보고 실천하게 해보고 있어요~\n이런 풍성한 구성 넘나 감사합니다 ㅎㅎ","h":0,"b":false,"s":"6826867677"},{"r":5,"d":"2025-08-02","a":"luck*******","t":"아이 방학맞이 주문.ㅎㅎ\n하루 시작을 요거 쓰는걸로 하자했는데, 이것또한 숙제로 느껴지는 초딩인가봅니다 ㅋㅋ","h":0,"b":false,"s":"6826867677","p":["photos/723/f623cea6ed60.jpg"]},{"r":4,"d":"2025-08-02","a":"joya******","t":"안에 다이어리 구성이 좋아서 맘에 들어요~","h":0,"b":false,"s":"6826867677"},{"r":4,"d":"2025-08-02","a":"sjyp****","t":"아이들이 방학이 짧아서 아쉬움","h":0,"b":false,"s":"6826867677","p":["photos/723/bb27cbc3bb3d.jpg"]},{"r":5,"d":"2025-08-01","a":"arch*****","t":"방학동안 할일계획세우는데 도움 많이됐어요~","h":0,"b":false,"s":"6826867677"},{"r":4,"d":"2025-08-01","a":"skfn****","t":"아이가 좋아합니다. 친구와 함께 사용하라고 2개!!!","h":0,"b":false,"s":"6826867677"}]