[{"r":5,"d":"2023-07-20","a":"cass******","t":"초등 1~3학년 아이들한테 딱 좋은 플래너 같아요. 재미있는 내용들이 많고, 방학때 알차게 지낼 수 있게 도와주는 초등학생 여름방학 계획표네요! 안에 많이 채워주려면 열심히 아이와 방학을 보내봐야겠어요~~~","h":0,"b":true,"s":"6826867677","p":["https://phinf.pstatic.net/checkout.phinf/20230720_41/1689856734989fgfs6_JPEG/KakaoTalk_20230720_213818489.jpg","https://phinf.pstatic.net/checkout.phinf/20230720_125/1689856735062UFslB_JPEG/KakaoTalk_20230720_213818489_02.jpg","https://phinf.pstatic.net/checkout.phinf/20230720_182/1689856735042GsYho_JPEG/KakaoTalk_20230720_213818489_01.jpg"]},{"r":5,"d":"2023-07-20","a":"seok****","t":"여름방학을 알차게 보내기 위해 준비했어요.\n일일 계획에서 독서활동지까지 구성이 알차네요.\n아이와 함께 작성하면 즐거울 것 같아요.\n블로그 협찬으로 증정받아 사용했지만 너무 만족스러워요.\n이번 겨울방학 부터는 내돈내산 할 계획입니다.","h":0,"b":false,"s":"6826867677","p":["https://phinf.pstatic.net/checkout.phinf/20230720_100/1689858414898GHeYa_JPEG/20230720_213129.jpg","https://phinf.pstatic.net/checkout.phinf/20230720_77/1689858422981VcAwe_JPEG/20230720_211314.jpg"]},{"r":5,"d":"2023-07-20","a":"oliv****","t":"리훈 제품이 점점 많아지고 있어서 행복해요.\n한번 사용해보면 퀄리티와 구성들이 하나같이 좋아서 믿고 구입하게 되는데요.\n이번 초등학교 여름방학 계획표도 너무 구성이 좋아서\n보자마자 아이와 보내는 1학년 첫 여름방학은\n리훈과 함께하다보면 알찬 시간을 보낼 수 있을것 같아 망설임없이 선택해보았습니다.\n전체 페이지를 다 완성하진 못하겠지만\n하나씩 채워가다보면 아이와 저도 추억도 쌓고 성취감도 높일 수 있을것 같아요.","h":1,"b":false,"s":"6826867677","p":["https://phinf.pstatic.net/checkout.phinf/20230720_153/1689862340565h8F4B_JPEG/IMG_2478.JPG","https://phinf.pstatic.net/checkout.phinf/20230720_76/1689862359371yOaEs_JPEG/IMG_2492.JPG","https://phinf.pstatic.net/checkout.phinf/20230720_67/1689862389054Cc6r1_JPEG/IMG_2499.JPG","https://phinf.pstatic.net/checkout.phinf/20230720_19/1689862406206Mm6eg_JPEG/IMG_2486.JPG"]},{"r":5,"d":"2023-07-20","a":"rsh1***","t":"스티커도주시고\n너무이쁘네요","h":0,"b":false,"s":"6826867677"},{"r":4,"d":"2023-07-19","a":"supi*****","t":"라이브방송에 1+1일때 아이 친구도 하나 줄겸 구했어요. 내용이 뭔가 많긴 한데 굳이 다 필요하진 않은 내용들이 일부 있어요.\n채워나가는 재미는 있긴하겠어요.\n독서노트를 따로 쓰는데 다른 리훈 스케줄러에도 독서제목 쓰는 게 있고 여기도 또 있어서 중복되는게 많네요.\n일주일 계획이 다 보이게 하는것도 좋던데...\n일단 한 번 써볼게요~","h":0,"b":false,"s":"6826867677","p":["https://phinf.pstatic.net/checkout.phinf/20230719_177/1689752911386Q1rDk_JPEG/20230719_164542.jpg"]},{"r":5,"d":"2023-07-19","a":"jjki****","t":"쓰고있는데 알차고 다양해서 좋아요","h":0,"b":false,"s":"6826867677","p":["https://phinf.pstatic.net/checkout.phinf/20230719_70/1689768115940YsG9K_JPEG/1689768093105.jpg"]},{"r":4,"d":"2023-07-19","a":"gusa******","t":"방학동안 계획세워서 잘 지켜보려고합니다.\n아무것도 없이 방학동안의 목표를 잡기는 어려운데 책자속 내용들을 보며 하니 아이도 어려워 하지않네요","h":0,"b":false,"s":"6826867677"},{"r":4,"d":"2023-07-18","a":"soon****","t":"초등 저학년부터 스케줄러 쓰는거 연습 하기 좋은거 같아요","h":0,"b":false,"s":"6826867677"},{"r":5,"d":"2023-07-18","a":"ruga***","t":"빠른 배송 감사합니다!!","h":0,"b":false,"s":"6826867677"},{"r":5,"d":"2023-07-18","a":"page****","t":"방학때 애가 잘 사용 하면 좋겠네요","h":0,"b":true,"s":"6826867677","p":["https://phinf.pstatic.net/checkout.phinf/20230718_156/1689678875148MfOrU_JPEG/20230718_200912.jpg"]}]