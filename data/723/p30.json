[{"r":4,"d":"2024-07-19","a":"noav*****","t":"구성은 좋아뇨. \n\n한자쓰기에서 일백 백 자를  한자가 흰 백자가 프린트 되어있네요. 나중에 정정해서 판매하세요","h":1,"b":false,"s":"6826867677","p":["photos/723/cd687f8b8e87.jpg"]},{"r":5,"d":"2024-07-19","a":"llsk******","t":"아이가 택배 뜯어보고는 너~무 좋아해서 오늘 방학식 하고 오자마자 계획표 완성 했어요! 구성도 알차고 디자인도 직관적으로 이어서 너무 마음에 들ㅇㅓ요! 개학하면 공부플래너 구입하고 겨울방학엔 또 방학플래너 구입하고 싶어요^^","h":0,"b":true,"s":"6826867677","p":["photos/723/22a9c8c47b0d.jpg","photos/723/e71fd5e6504e.jpg"]},{"r":5,"d":"2024-07-19","a":"alic*****","t":"아이의 신나는 방학일지가 될거같아요","h":0,"b":true,"s":"6826867677","p":["photos/723/fd56464b368f.jpg"]},{"r":5,"d":"2024-07-19","a":"nanj*******","t":"딸아이가 맘에들어해요. 내용도 알차네요.","h":0,"b":true,"s":"6826867677","p":["photos/723/cba6c0b6e620.jpg"]},{"r":5,"d":"2024-07-19","a":"nanj*******","t":"딸아이가 좋아해요. 내용도 풍성해서 빨리하고싶다고 하네요.","h":0,"b":false,"s":"6826867677","p":["photos/723/6d3f505a9dc9.jpg"]},{"r":5,"d":"2024-07-19","a":"ma****","t":"🥰🥰🥰🥰🥰🥰🥰","h":0,"b":false,"s":"6826867677"},{"r":5,"d":"2024-07-18","a":"shyo***","t":"인스타 광고보고 들어왔는데 \n뭐에 홀린듯 일하다가 구매를 했네요 ㅎㅎ\n\n방학때 아들 한권 채우기를 목표로 하면 너무 좋을것 같아 샀고요.\n내용 보면 아주 알차네요. \n곧 방학인데 하나씩 같이 얘기나누며 방학중엔 뭐할지 고민을 좀 해봐야겠어요.\n\n이번 방학은 요걸로 잘 채워볼게요!!","h":0,"b":true,"s":"6826867677","p":["photos/723/70a64fb97b8d.jpg","photos/723/cdb953c60b8a.jpg","photos/723/922bc61cec19.jpg","photos/723/4ca179372147.jpg","photos/723/30b953eb8f4b.jpg","photos/723/5d97f56f71c7.jpg"]},{"r":5,"d":"2024-07-18","a":"shyo***","t":"선물주려고 한권 더 구매했어요!","h":0,"b":true,"s":"6826867677","p":["photos/723/e605f3608985.jpg"]},{"r":5,"d":"2024-07-17","a":"jina******","t":"아이 첫방학을 좀 잘보내고 싶어서 사봤어요 \n너무 알차게\n잘되어있네오^^","h":0,"b":false,"s":"6826867677"},{"r":5,"d":"2024-07-16","a":"alwl****","t":"리훈제품은 정말 너무 좋은거 같아요.\n배송 되자마자 아이하고 확인했는데\n너무 행복하다고 아이가 말해주네요.\n올 여름 방학 알차게 잘 보낼거 같아요.","h":0,"b":true,"s":"6826867677","p":["photos/723/386b920de9b4.jpg"]}]