[{"r":5,"d":"2025-11-24","a":"wate*******","t":"디자인도 깔끔하고, 메모 공간도 넉넉.\n무엇보다 뜯지 않고 넘기는 일력이라 좋아요.","h":0,"b":false,"s":"12570087061","p":["photos/1461/289fa0205089.jpg"]},{"r":5,"d":"2025-11-24","a":"supe****","t":"생각했던 사이즈보다 약간 큰데 숫자가 큼직하니 눈이 시원한 느낌이에요. 디자인은 레트로한 느낌이 강하고 종이 재질이 양면사용이라 그런지 두께가 있어서 좋아요. 26년 1월 1일부터라 아쉽지만 잠시 넣어놔야되요. ㅎㅎㅎ","h":0,"b":true,"s":"12570087061","p":["photos/1461/ad70d2f3dccd.jpg"]},{"r":5,"d":"2025-11-23","a":"ilov********","t":"올 한해가 기대됩니다~","h":0,"b":false,"s":"12570087061","p":["photos/1461/221e4f0841ee.jpg"]},{"r":5,"d":"2025-11-23","a":"sang****","t":"크기,색상이넘 맘에드네요~~간단한 메모로쓰기 좋은것같아요","h":0,"b":false,"s":"12570087061"},{"r":5,"d":"2025-11-21","a":"kazz*****","t":"멀리 있는 동생에게 선물하고 싶어서 구매했는데 다행이 동생이 받아보고 너무 마음에 들어했어요~ 매년마다 달력사서 동그라미 치는 재미로 보냈는데 내년에는 더 기대되는 해입니다.","h":0,"b":true,"s":"12570087061","p":["photos/1461/2cd41a1afc98.jpg","photos/1461/840a09f6a5c6.jpg"]},{"r":5,"d":"2025-11-21","a":"hhs8***","t":"25년도에 일력 구입해서 잘 사용해서 26년도에도 구입","h":0,"b":false,"s":"12570087061","p":["photos/1461/1732cf66e2e8.jpg"]},{"r":5,"d":"2025-11-21","a":"eh-k******","t":"맘에 들어요\n메모하는 습관이 있어서\n매년 달력에 기록했는데 일일달력이라\n보기도 쉽고 알차게  메모 할 수 있겠어요","h":0,"b":false,"s":"12570087061","p":["photos/1461/dff73a439ad4.jpg"]},{"r":5,"d":"2025-11-21","a":"suni*****","t":"넘 귀엽고 쓰기 좋은 달력이에요~\n컬러도 이쁘고 맘에들어요!!","h":0,"b":false,"s":"12570087061","p":["photos/1461/2f13c37a2207.jpg","photos/1461/c9e1bd1f6e9a.jpg"]},{"r":4,"d":"2025-11-20","a":"gu20***","t":"바람핀 전여친으로 알게 된 리훈.\n헤어지고 나서도 리훈이랑은 안헤어질려구요..","h":0,"b":false,"s":"12570087061"},{"r":5,"d":"2025-11-20","a":"ej****","t":"다다일력으로 2026년을 미리 준비했어요. 매일 기록하며 스케줄 정리하기 좋을 것 같고 디자인도 예뻐서 테이블 위에 놓아두니 인테리어 효과까지 나네요 :)","h":0,"b":true,"s":"12570087061","p":["photos/1461/553d96bfe059.jpg","photos/1461/d3c9e3be9b45.jpg"]}]