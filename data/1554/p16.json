[{"r":5,"d":"2026-04-12","a":"s120***","t":"색감도너무예쁘고\n마음 에쏙들어요","h":0,"b":false,"s":"5482012680","p":["photos/1554/d765f9fcdb93.jpg"]},{"r":5,"d":"2026-04-12","a":"arum****","t":"구성이 마음에드네요 크기도적당해서 쓰기편해요","h":0,"b":false,"s":"5482012680"},{"r":5,"d":"2026-04-08","a":"aleg*****","t":"처음사용하는데 너무 좋네요","h":0,"b":false,"s":"5482012680","p":["photos/1554/cfb7289dfe36.jpg"]},{"r":5,"d":"2026-04-07","a":"drli*****","t":"종이 질이 깔끔합니다. 체계적으로 기록하기 좋아요","h":0,"b":false,"s":"5482012680","p":["photos/1554/f9cc96243149.jpg"]},{"r":5,"d":"2026-04-06","a":"sy****","t":"종이질도 그렇고, 구성의 자유도도 높아서 좋아요.","h":0,"b":false,"s":"5482012680"},{"r":5,"d":"2026-04-06","a":"sara****","t":"독서템으로 매일 독서 체크리스트, 독서 기간 기록 메모지 등 추천받은 게 많았는데 이거 한 권 사니까 다 해결되네요~리뉴얼 꾸준히 되는 제품 같은데 50권 채우고 다음 50권 기록할 때 또 구매하겠습니다~","h":1,"b":false,"s":"5482012680","p":["photos/1554/b87f855eb65a.jpg"]},{"r":5,"d":"2026-04-06","a":"laal****","t":"어제읽은 책 제목이.생각안나는 충격을 받고 독서기록이 필요하단생각에 주문해봅니다.50권정도 정리할수있다고하니 당분간 잘 써볼께요.","h":0,"b":false,"s":"5482012680"},{"r":5,"d":"2026-04-05","a":"yahw****","t":"도서관에서 책 빌려 읽는데 기록해놓으면 좋을것같아 구매했는데 총알배송에 구성도 너무 알차 매우 만족해요","h":0,"b":false,"s":"5482012680","p":["photos/1554/7151fb13ad8a.jpg"]},{"r":5,"d":"2026-04-04","a":"st****","t":"독서모임이 있어서 구매하게 됐는데 받은 분들이 좋아하셨어요^^","h":0,"b":false,"s":"5482012680","p":["photos/1554/e51c885b33bd.jpg"]},{"r":5,"d":"2026-04-03","a":"inte*******","t":"만년필 기록용으로 생각보다 모조지가 매끄럽네요. \n전체적인 구성이 독서를 기록하기 재미있게 구성되어 있어 좋았습니다.\n각 책을 구분할 수 있는 인덱스 스티커 등이 있으면 더 완벽할듯 합니다.","h":0,"b":false,"s":"5482012680"}]