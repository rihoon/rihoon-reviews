[{"r":5,"d":"2026-08-03","a":"jens*****","t":"좋아요 \n가계부 적기 너무 편하고 좋아요\n한달을 한페이지에 다 적을수 있어서 나의 한달살이를 알수 있어서 샀어요 잘 쓸게요","h":0,"b":false,"s":"13165293253","p":["photos/519/93159875c9b7.jpg"]},{"r":5,"d":"2026-08-03","a":"crys********","t":"엑셀로 가계부 작성 하다가 수시로 작성할려고\n주문 했어요\n한눈에 한달 내용이 파악이 되어\n좋아요","h":0,"b":true,"s":"13165293253","p":["photos/519/d69dcaa15dbf.jpg"]},{"r":5,"d":"2026-08-03","a":"dkst*******","t":"월단위로 내용을 한눈에 파악할 수 있어 좋아요.","h":0,"b":false,"s":"13165293253","p":["photos/519/a782d46749d5.jpg"]},{"r":5,"d":"2026-08-03","a":"10****","t":"가계부 열심히 써보려고 구매했어오! 간단해 보이고 직관적이라좋은거같아요","h":0,"b":false,"s":"13165293253","p":["photos/519/b7fd1883cf53.jpg"]},{"r":5,"d":"2026-08-03","a":"alwj*****","t":"혼자서 글 적기에 좋아요","h":0,"b":false,"s":"13165293253"},{"r":5,"d":"2026-08-02","a":"happ*******","t":"가계부의 핵심만 들어있는 것 같아요. 잘써볼게요","h":0,"b":false,"s":"13165293253","p":["photos/519/dde6a8eeec3b.jpg"]},{"r":5,"d":"2026-08-02","a":"jhyo****","t":"한달 내용을 한 번에 보기 좋게 되어 있어서 좋아요. 앱으로 가계부를 작성해보기도 했지만 전 직접 펜을 잡고 쓰는 가계부가 더 좋더라고요. 여러 가계부를 써봤는데 이번 가계부가 최고네요.","h":0,"b":false,"s":"13165293253","p":["photos/519/1046dd08bae1.jpg"]},{"r":5,"d":"2026-08-02","a":"cinn*****","t":"커서 좋아요 꾸준히 쓰길","h":0,"b":false,"s":"13165293253","p":["photos/519/6ac84d416f20.jpg"]},{"r":4,"d":"2026-08-02","a":"wlau***","t":"사이즈가 크다 보니 작성하기는 편하지만 휴대성은 조금 떨어지는 편입니다. 해당 디자인이 작은 사이즈로 나와도 괜찮을 거 같아요","h":0,"b":false,"s":"13165293253","p":["photos/519/5d312fb2e686.jpg"]},{"r":5,"d":"2026-08-02","a":"vt****","t":"편하면서도 필요한 내용이 다 잘 구성이 되있어서 좋아요 돈 아끼면서 잘 써보겠습니다","h":0,"b":true,"s":"13165293253","p":["photos/519/f23024a7d053.jpg"]}]