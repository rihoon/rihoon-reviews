[{"r":5,"d":"2026-08-19","a":"baek*****","t":"딱 필요한 구성만 있어서 가계부 쓰기 편할 것 같아요~ 😊\n구성도 깔끔하고 복잡하지 않아서 마음에 들어요!\n\n단, 상품 포장이 조금 아쉬웠어요ㅠㅠ\n상자에 넣을 때 사이즈가 맞지 않았는지 살짝 접힌 상태로 배송이 왔더라고요🥲\n사용하는 데는 크게 문제 없지만 개봉하고 나니 접힌 부분이 자꾸 신경 쓰이네요ㅠㅠ\n\n다음에 주문할 때는 상품 사이즈에 맞는 상자에 잘 포장해서 보내주시면 좋을 것 같아요~!","h":0,"b":false,"s":"13165293253","p":["photos/519/4a2e28412e0f.jpg"]},{"r":5,"d":"2026-08-19","a":"win_******","t":"쉽고 오래 쓸 수 있는 가계부를 찾았는데 잘 찾은 것 같아요. 열심히 써볼게요.","h":0,"b":true,"s":"13165293253","p":["photos/519/1aecd7345266.jpg"]},{"r":4,"d":"2026-08-18","a":"ro****","t":"한달 상황을 한눈에 볼수있어서 좋을것같아요. 겉표지 싸고있는 투명색이 너무 쭈글거려서 보기에 예쁘진않아요","h":0,"b":false,"s":"13165293253","p":["photos/519/7cc2152afb6c.jpg","photos/519/cee087a7b86a.jpg"]},{"r":3,"d":"2026-08-18","a":"zldz*****","t":"만족합니다만족합니다 만족합니다","h":0,"b":false,"s":"13165293253","p":["photos/519/5008ebb55392.jpg"]},{"r":4,"d":"2026-08-18","a":"hsm8***","t":"크기도 크고 월별로 쓸수있도록 되어있어 좋습니다","h":0,"b":false,"s":"13165293253","p":["photos/519/1cca548c10f5.jpg"]},{"r":5,"d":"2026-08-18","a":"dltj********","t":"넘나깔끔하고 쓰잘데기없는 구성이 없어서 조아요 잘쓸게요! 크기도 별로안커요!","h":0,"b":false,"s":"13165293253","p":["photos/519/db476b99e478.jpg"]},{"r":5,"d":"2026-08-18","a":"tn****","t":"얇은데 안에 내용은 꽉차서 좋아요.","h":0,"b":false,"s":"13165293253","p":["photos/519/fe70c745a47b.jpg"]},{"r":5,"d":"2026-08-18","a":"tn****","t":"안에 구성이 깔끔해서 마음에 들어요","h":0,"b":false,"s":"13165293253","p":["photos/519/706076d9e0f6.jpg"]},{"r":5,"d":"2026-08-18","a":"rlek*****","t":"간편하고 깔끔해서 복잡한거싫어하는 분들은 \n쓰기좋을꺼같아요","h":0,"b":false,"s":"13165293253"},{"r":4,"d":"2026-08-18","a":"ne****","t":"배송이 무척 빨랐습니다. 한 달을 두 페이지로 볼 수 있어 좋아보였는데, 막상 쓰려니 세로로 노트를 두고 써야해서 조금 불편하네요. 그리고 큰 지장은 없지만 비닐 커버가 주름이 져서 지저분해보여요. pc 앱으로 넘어가지 않고 수기로 오래 쓰게 되기를 바랍니다.","h":0,"b":false,"s":"13165293253","p":["photos/519/f12518d7633f.jpg","photos/519/78e3261134ca.jpg"]}]