[{"r":5,"d":"2026-07-01","a":"jaef****","t":"가계부를 써야할 거 같아서 여러 제품 비교하고 구성이\n괜찮어서 구매했어요. 사이즈가 생각보다 크지만 한달을 전체적으로 확인할 수 있어서 좋네요. 잘 써볼게요.","h":0,"b":false,"s":"13165293253","p":["photos/519/a78bcc9b81da.jpg"]},{"r":5,"d":"2026-07-01","a":"po****","t":"사이즈가 조금 크긴한데 마음에 들어용","h":0,"b":false,"s":"13165293253","p":["photos/519/94aa621611d7.jpg"]},{"r":5,"d":"2026-07-01","a":"sun0****","t":"생각했던것보다 사이즈가 크네요\n잘 쓰도록 하겠습니다","h":0,"b":false,"s":"13165293253","p":["photos/519/b1b1e9cbb020.jpg"]},{"r":5,"d":"2026-07-01","a":"csh9******","t":"아직은 나만의 방식을 못찾아 구매해봤어요. 쓰임도 제 것으로 잘 만들어 사용하면 좋겠어요! 마음에 들어요","h":0,"b":false,"s":"13165293253","p":["photos/519/618399213d21.jpg"]},{"r":4,"d":"2026-07-01","a":"soom******","t":"커서 작성이나 보기는 편해서 좋아요.달에 사용내역을 품목별로 적을 수 있는 칸이 있으면 더 좋을것 같아요.","h":0,"b":false,"s":"13165293253","p":["photos/519/7a6df693987e.jpg"]},{"r":4,"d":"2026-07-01","a":"soom******","t":"간단하게 사용하기 좋아요!","h":0,"b":false,"s":"13165293253","p":["photos/519/89815213f483.jpg"]},{"r":5,"d":"2026-07-01","a":"shin****","t":"돈이 어디로 새는지 몰라서 가계부 구매했어요~\n이상하게 저는 어플로 정리하면 눈에 안들어오고 기억도 안나더라구요 ㅋㅋ\n먼슬리 가계부라 딱 제가 찾던 제품입니다~","h":0,"b":false,"s":"13165293253"},{"r":5,"d":"2026-06-30","a":"kim0****","t":"깔끔하고 좋아요 크기도 마음에 들어요","h":0,"b":false,"s":"13165293253","p":["photos/519/a0c7dcaa5142.jpg"]},{"r":5,"d":"2026-06-30","a":"sowy*****","t":"가계부 써보려고 주문했어요 인생 첫 가계분데 꼭 성공해볼게오!!","h":0,"b":false,"s":"13165293253","p":["photos/519/b2b294457718.jpg"]},{"r":5,"d":"2026-06-29","a":"jang*******","t":"크기가 커서 좋아요. \n이것저것 복잡하게 쓰지 않고 중요한것만 심플하게 적을수 있어서 저한테 딱이네요.","h":0,"b":false,"s":"13165293253","p":["photos/519/6bafd0dddb2f.jpg"]}]