[{"r":5,"d":"2026-04-23","a":"cj****","t":"대만족이에요:)\n디자인이 너무 이뻐서 손이 자꾸 쳐다보게되어요 ㅎㅎ\n톤다운캄다운하이라이터는 글을 돋보이게\n해주어서 마음에들어요!","h":0,"b":false,"s":"12258419892","p":["photos/1400/ec38c8a74663.jpg"]},{"r":4,"d":"2026-04-22","a":"wngu***","t":"할인하길래 궁금해서 구매했어요.","h":0,"b":false,"s":"12258419892","p":["photos/1400/9c0216b42ab3.jpg"]},{"r":5,"d":"2026-04-22","a":"wngu***","t":"연해서 은은하게 마킹할 수 있네요.","h":0,"b":false,"s":"12258419892","p":["photos/1400/3723432a52ca.jpg"]},{"r":5,"d":"2026-04-22","a":"iran***","t":"리훈 거는 모두 만족하며 쓰고 있습니다☺️","h":0,"b":false,"s":"12258419892","p":["photos/1400/df712a304eab.jpg"]},{"r":5,"d":"2026-04-22","a":"iran***","t":"많다많아… 산 게 여러게면 쓸 것도 많네요. 아무튼 만족합니다 ㅎㅎ","h":0,"b":false,"s":"12258419892","p":["photos/1400/f9a63665ace1.jpg"]},{"r":5,"d":"2026-04-22","a":"zokk***","t":"분홍색을 좋아하는 편이 아닌데\n연한 분홍색이 벚꽃잎 색 같아요~\n예쁘고 180도 시원하게 쫙 펼쳐져서\n필기하기도 좋습니다!","h":0,"b":false,"s":"12258419892","p":["photos/1400/604712bc724d.jpg","photos/1400/d1ce64233cfd.jpg"]},{"r":5,"d":"2026-04-22","a":"zokk***","t":"주문할 땐 원색의 도트인 줄 알았어요!~\n실물로 받아보니 흰 색을 톡! 하고 한 방울씩\n섞은 듯한 색들인데 오히려 산뜻해 보여요.\n이 예쁜 도트들이 옆면까지 꽉 차 있어서\n볼 때마다 기분도 산뜻해진답니다ㅎㅎ\n예쁘고 딱 원하던 내지 구성 (줄 칸, 빈 칸)이어서\n사진도 붙이고 글도 쓸 수 있어서 좋아요~","h":0,"b":false,"s":"12258419892","p":["photos/1400/88ba5c65d16a.jpg","photos/1400/69de54923445.jpg","photos/1400/781934d34f78.jpg"]},{"r":5,"d":"2026-04-21","a":"youj*****","t":"리훈 3개월 다이어리 구매해봤어요. 1년 다이어리 구입하고 못 쓰는 경우가 많았는데, 3개월이라 끝까지 다 쓸 수 있을 것 같아요. 월별 일정 및 생각/감정 정리할 수 있는 구성이라 진짜 데일리로 잘 쓰고 있어요. 가볍고 휴대하기 좋아서, 기록의 즐거움을 누릴 수 있어요.","h":0,"b":false,"s":"12258419892","p":["photos/1400/b6288792f367.jpg","photos/1400/19d33f27a25b.jpg","photos/1400/0c7823ffaace.jpg","photos/1400/3b8a6b864ec0.jpg","photos/1400/2f8d0fbfe824.jpg"]},{"r":5,"d":"2026-04-21","a":"si****","t":"써보고 한달 후기 올릴게요.","h":0,"b":false,"s":"12258419892"},{"r":5,"d":"2026-04-20","a":"ming***","t":"넘 이뻐요~~~~~","h":0,"b":false,"s":"12258419892","p":["photos/1400/caa180eb34e3.jpg"]}]