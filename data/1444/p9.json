[{"r":5,"d":"2026-02-03","a":"myna********","t":"기록러에게 기록템이란 늘 욕심나는것. 특히 절대 만족할수없던 아이템으로 날짜를 적는 숫자스티커와 요일과 달, 날짜를 기록하는 스티커라면 무조건 겟해야하는 중요한 것. 물론 그럼에도 여태껏 완벽한 아이템으로 정착못한것도 사실 \n\n기록러라면 당연코 애정하는 리훈브랜드의 스티커는 확실히 남다르다. 365일을 다담은 일력스티커와(노랑이,가로버전) 캘린더를 담고 트래커와 날자숫자와 달과 요일을 담은 스티커가 담긴 월력스티커(핑크,세로버전)까지\n\n역시 기록디테일변태(?) 리훈답게 다양한 디자인과 컬러로 담은 스티커가 하나같이 아름답다. 얇아서 두께감 걱정도 없고 스티커 하나로 오늘하루가 완벽하게 생성됬다.","h":0,"b":false,"s":"12374323608","p":["photos/1444/6856170f002d.jpg","photos/1444/7681e823f6e0.jpg","photos/1444/1fd678857ebe.jpg","photos/1444/d7e9fc014578.jpg","photos/1444/5b250f75e7af.jpg","photos/1444/cc444f4651ed.jpg","photos/1444/f64ca9a52b1a.jpg","photos/1444/d76af98f20d7.jpg","photos/1444/79ef0a3a2e3a.jpg"]},{"r":5,"d":"2026-02-02","a":"sail***","t":"꼼꼼하고 유용해요!!","h":0,"b":false,"s":"12374323608"},{"r":5,"d":"2026-02-02","a":"sail***","t":"스티커북처럼 되어 있어서 넘 편하네요","h":0,"b":false,"s":"12374323608"},{"r":5,"d":"2026-02-01","a":"stor*****","t":"종이가 엄청 얇아요","h":0,"b":false,"s":"12374323608","p":["photos/1444/04a6a11ef7de.jpg","photos/1444/a1905764bd32.jpg"]},{"r":5,"d":"2026-02-01","a":"stor*****","t":"종이가 무척 얇고, 잘못 붙여서 한번 떼었다 붙였는데 잘 붙어요","h":0,"b":false,"s":"12374323608","p":["photos/1444/6b2d0cf33893.jpg"]},{"r":5,"d":"2026-02-01","a":"sool*******","t":"좋아요 다꾸 하지\n좋아욭","h":0,"b":false,"s":"12374323608","p":["photos/1444/c0dcee1d7d83.jpg"]},{"r":5,"d":"2026-02-01","a":"sool*******","t":"다꾸하기 좋아용 베송도 하루맘에왓어옅","h":0,"b":false,"s":"12374323608","p":["photos/1444/fb3e7d8c0882.jpg"]},{"r":5,"d":"2026-02-01","a":"gree*******","t":"잘 받았습니다. 일일이 숫자 쓰기 귀찮을 때 붙여주면 되니까 좋네요.","h":0,"b":false,"s":"12374323608","p":["photos/1444/95e5a1956abe.jpg"]},{"r":5,"d":"2026-02-01","a":"dnlg***","t":"26년도는 다시 다이어리 꾸미기에 집중해서 해보려고 구매했습니다! 다양한 숫자 스티커 워낙 많지만, 자연스러우면서 색도 이쁘고 붙였을 때 폰트도 너무 예쁜거 같아서 참지 못하고 구매했어요? 생각보다 접착력이 있어서 날짜 스티커는 핀셋으로 잘 배치하고 붙이면 좋을거 같아요! ☺️💓","h":0,"b":false,"s":"12374323608","p":["photos/1444/ec1e496bba60.jpg","photos/1444/adc375c4759e.jpg","photos/1444/cede1b73666a.jpg"]},{"r":5,"d":"2026-01-31","a":"hyjp****","t":"다양한 종류의 달력 스티커 너무 마음에 들어요.\n리훈 제품 늘 만족하며 사용중입니다","h":0,"b":false,"s":"12374323608"}]