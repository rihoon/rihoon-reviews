[{"r":5,"d":"2026-02-10","a":"dldp*******","t":"달마다 느낌이 달라서 더 좋아요","h":0,"b":false,"s":"12374323608"},{"r":5,"d":"2026-02-09","a":"jhee****","t":"하루 할 일, 월 별로 할 일을 체크 할 수 있어서 좋습니다","h":0,"b":false,"s":"12374323608","p":["photos/1444/ab0f9fabc417.jpg"]},{"r":5,"d":"2026-02-08","a":"lsm3****","t":"챌린지 체크하기에 좋습니다","h":0,"b":false,"s":"12374323608"},{"r":5,"d":"2026-02-06","a":"aris*******","t":"깔끔해서 좋아요. 독서기록할 때 사용하려고요.","h":0,"b":false,"s":"12374323608","p":["photos/1444/aedae3d38f9e.jpg"]},{"r":5,"d":"2026-02-06","a":"hiph*****","t":"작년에 일력 스티커 잘 써서 올해도 주문했어요.","h":0,"b":false,"s":"12374323608","p":["photos/1444/2d56986eff07.jpg"]},{"r":5,"d":"2026-02-04","a":"ggya****","t":"두께도 얇고 색상도 예뻐요","h":0,"b":true,"s":"12374323608","p":["photos/1444/290f850b674b.jpg","photos/1444/20b57bc0a9d3.jpg"]},{"r":5,"d":"2026-02-04","a":"ggya****","t":"날짜별로 다 있어서 좋네요~","h":0,"b":true,"s":"12374323608","p":["photos/1444/2f541dd38a7a.jpg"]},{"r":5,"d":"2026-02-04","a":"glor*****","t":"다채롭게 들어 있어서 활용도가 매우 좋습니다.","h":0,"b":false,"s":"12374323608","p":["photos/1444/a89c9fc22eaa.jpg"]},{"r":5,"d":"2026-02-04","a":"gomm***","t":"필요했던거라 망설임없이 구매했어요","h":0,"b":false,"s":"12374323608"},{"r":5,"d":"2026-02-03","a":"myna********","t":"기록러에게 기록템이란 늘 욕심나는것. 특히 절대 만족할수없던 아이템으로 날짜를 적는 숫자스티커와 요일과 달, 날짜를 기록하는 스티커라면 무조건 겟해야하는 중요한 것. 물론 그럼에도 여태껏 완벽한 아이템으로 정착못한것도 사실 \n\n기록러라면 당연코 애정하는 리훈브랜드의 스티커는 확실히 남다르다. 365일을 다담은 일력스티커와(노랑이,가로버전) 캘린더를 담고 트래커와 날자숫자와 달과 요일을 담은 스티커가 담긴 월력스티커(핑크,세로버전)까지\n\n역시 기록디테일변태(?) 리훈답게 다양한 디자인과 컬러로 담은 스티커가 하나같이 아름답다. 얇아서 두께감 걱정도 없고 스티커 하나로 오늘하루가 완벽하게 생성됬다.","h":0,"b":true,"s":"12374323608","p":["photos/1444/0d3d0a856a30.jpg","photos/1444/c6588c9f344c.jpg","photos/1444/39e58a36039e.jpg","photos/1444/fcc56470e70e.jpg","photos/1444/57c588c7f9d9.jpg","photos/1444/a351504dde79.jpg","photos/1444/a238c19392b2.jpg","photos/1444/8f3de5413426.jpg"]}]