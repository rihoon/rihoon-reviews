[{"r":5,"d":"2025-12-02","a":"gksw****","t":"크기도 딱 좋고 마음에 들어요!","h":0,"b":false,"s":"12629011395","p":["photos/1475/667659979a45.jpg"]},{"r":4,"d":"2025-12-02","a":"rlac***","t":"아이가 너무 좋아합니다 예뻐요","h":0,"b":false,"s":"12629011395","p":["photos/1475/02f93b76571e.jpg"]},{"r":5,"d":"2025-12-02","a":"mi****","t":"몇년째 식단 일기로 쓰고 있어요. 올해도 바로 구매해서 12월 되자마자 새걸로 갈아탔습니다. 기분탓인지 뭔지 종이가 좀 더 좋은 느낌이고 작년엔 모눈이 너무 연하다는 느낌이었는데 올해는 모눈이 딱 적당한 농도라 좋네요. 가끔 포맷 아주 약간 바뀌는 것도 넘 좋아요. 덕분에 안 질리고 쓰는 것 같아요.","h":0,"b":false,"s":"12629011395","p":["photos/1475/6542c3b3dc77.jpg"]},{"r":5,"d":"2025-12-02","a":"kang******","t":"색이 너무이뻐요\n구성은 생각햏던 그대로이고 사용하기 편리해요.  형광펜의 색이 너무 이뻐요","h":0,"b":false,"s":"12629011395"},{"r":5,"d":"2025-12-02","a":"pian******","t":"생각하던대로 제품이 왔네요. 종이 질감이 두텁고 좋습니다. 만년필을 많이 사용하는데, 뒤로 비치지가 않아서 좋을 것 샅아요. 색깔도 이쁩니다. 잘 쓸께요!","h":0,"b":false,"s":"12629011395","p":["photos/1475/dfe3bd8544ee.jpg","photos/1475/57ca946839f9.jpg"]},{"r":5,"d":"2025-12-02","a":"sung*******","t":"다이어리 색이 맘에 들어요 볼펜 품질은 막 뛰어난 그런건 아니고 적당합니다","h":0,"b":false,"s":"12629011395","p":["photos/1475/b483d3d00304.jpg"]},{"r":5,"d":"2025-12-02","a":"la****","t":"26년도에도 리훈으로 시작하려 합니다","h":0,"b":false,"s":"12629011395","p":["photos/1475/900eacaab821.jpg"]},{"r":5,"d":"2025-12-02","a":"park****","t":"일년의 시작은 리훈이죠","h":0,"b":false,"s":"12629011395"},{"r":5,"d":"2025-12-02","a":"ice_********","t":"4년인아요 5년인가요... 암튼 리훈과 함께하는 시간들이 늘어나고 있네요. 다양한 색으로 나의 이야기를 채워갑니다. 고맙습니다.","h":0,"b":false,"s":"12629011395","p":["photos/1475/15e5d1ada3b0.jpg"]},{"r":5,"d":"2025-12-02","a":"ljyl******","t":"매년 이거 쓰고 있어요","h":0,"b":false,"s":"12629011395","p":["photos/1475/524acb9a0828.jpg"]}]