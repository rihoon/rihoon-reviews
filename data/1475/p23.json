[{"r":5,"d":"2026-03-26","a":"1004*****","t":"육아일기 쓰려구 샀어요 \n구성이 제일 제 스타일이라서 샀는데 시작이 힘드네요^^..계속 폰에 적어두기만 하고 옮겨쓰질 못하는중이에요\n펜은 얇아서 제스탈은 아니라 다른걸로 쓰려구용","h":0,"b":false,"s":"12629011395","p":["photos/1475/7fd10a6768cc.jpg"]},{"r":5,"d":"2026-03-26","a":"lj****","t":"매년 잘 구매해서 쓰고 있습니다\n선물용으로 또 구매했는데 맘에 들어해서 좋네요","h":0,"b":false,"s":"12629011395","p":["photos/1475/4b03717d0849.jpg"]},{"r":5,"d":"2026-03-26","a":"jy_7***","t":"디자인도 귀엽고 좋아요. 잘 쓰고 있습니다","h":0,"b":false,"s":"12629011395","p":["photos/1475/163d10aa5900.jpg"]},{"r":5,"d":"2026-03-25","a":"oops****","t":"배송이 빨랐습니다 그리고 딱 필요한 구성으로만\n되어있어 마음에 듭니다","h":0,"b":false,"s":"12629011395"},{"r":5,"d":"2026-03-25","a":"ashe******","t":"2024년부터 쓰기 시작한 리훈.\n이 번엔 좀 늦어서 원하는 건 품절되어 만년형으로 구매했어요.\n역시나 깔끔한 구성과 군더더기 없는 디자인이 마음에 쏙 드네요.\n실버컬러는 정말 신의 한수!\n너무나 고급스럽고 멋스러워요.\n다른 분들 말씀처럼 베이직하고 톤다운된 컬러도 제작해주시면 색상을 더더 좋을 것 같아요.\n감사합니다.","h":0,"b":false,"s":"12629011395","p":["photos/1475/211a0df7e12d.jpg","photos/1475/7a7f960d640c.jpg"]},{"r":5,"d":"2026-03-25","a":"ejh9*****","t":"색감도 내지도 마음에 들어요!","h":0,"b":false,"s":"12629011395"},{"r":5,"d":"2026-03-24","a":"sjh2***","t":"종이 비침 없고 좋아요^^","h":0,"b":false,"s":"12629011395","p":["photos/1475/59bd8b797b2f.jpg"]},{"r":5,"d":"2026-03-23","a":"ggom******","t":"몇년째사용중인지...저는 앞으로도 리훈것만 쓸겁니다:)","h":0,"b":false,"s":"12629011395"},{"r":5,"d":"2026-03-23","a":"h_sy*****","t":"색도이쁘도 딱 가지고다니기 조은 사이즈 입니다","h":0,"b":false,"s":"12629011395","p":["photos/1475/55c8f7b4ac8c.jpg"]},{"r":5,"d":"2026-03-23","a":"dbwo*****","t":"핑크핑크 잘사용하고있어요. 일기쓰기 매일 실천은 못해도, 글쓰고싶을때 중요한일 있을때 사용하고있어요.","h":0,"b":false,"s":"12629011395","p":["photos/1475/22ee28a56abb.jpg"]}]