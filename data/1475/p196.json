[{"r":5,"d":"2025-12-27","a":"hima***","t":"색상도 구성도 좋습니다","h":0,"b":false,"s":"12629011395","p":["photos/1475/c9859c2495c9.jpg"]},{"r":5,"d":"2025-12-27","a":"ahj7***","t":"실버색인것이 고급지게 좋았고, 종이 재질도 만족스러워요. 같이 온 펜은 예쁘긴한데 글씨 쓸 때 조금 불편하더라구요. 상반기 써보고 만족스러우면 하반기도 구매하러 오려구요~","h":0,"b":false,"s":"12629011395","p":["photos/1475/bb2d235c2469.jpg"]},{"r":5,"d":"2025-12-27","a":"hehe******","t":"재질좋고 사이즈도좋고 맘에들어요","h":0,"b":false,"s":"12629011395"},{"r":5,"d":"2025-12-27","a":"haes******","t":"잘받앗고 잘쓰겠습니다","h":0,"b":false,"s":"12629011395","p":["photos/1475/b10b64a85402.jpg"]},{"r":5,"d":"2025-12-27","a":"ar****","t":"두꺼운 다이어리는  가지고 다니기가  부담스러워싀  상반기꺼로 주문했어요.너무 맘에들어요 감사하게  잘 써보도록할께요.딸아이들이  리훈다이어리 매니아라서   저도  구입했어요","h":0,"b":false,"s":"12629011395","p":["photos/1475/1dc3f1b0adcd.jpg","photos/1475/ae3d2ab16d1e.jpg","photos/1475/0dd25970a504.jpg","photos/1475/b2e5772de7bd.jpg"]},{"r":4,"d":"2025-12-27","a":"pink*******","t":"열심히 써 볼게요.","h":0,"b":false,"s":"12629011395"},{"r":5,"d":"2025-12-27","a":"wlgp****","t":"일단 결제하고 바로 다음날 배송와서 너무 좋아요 ㅠ\n다이어리 고민하다가 우연히 보고 구매했는데 일단 가격 배송 속지 모든 부분에서 나쁘지 않아요!!","h":0,"b":false,"s":"12629011395","p":["photos/1475/c991417fffb9.jpg"]},{"r":5,"d":"2025-12-27","a":"au****","t":"좋은상품 저렴하게 구입했습니다 감사합니다","h":0,"b":false,"s":"12629011395","p":["photos/1475/16c2c9c19d48.jpg"]},{"r":5,"d":"2025-12-27","a":"euge******","t":"크 은색 영롱하고 넘 예쁘네요\n적당히 휴대도 가능한 크기에 내용물도 딱 제가 찾던 구성이라 구매했습니다\n디자인이며 구성이며 군더더기 없이 깔끔하게 잘 나와서 정말 유용하게 잘 쓸 것 같아요","h":0,"b":false,"s":"12629011395","p":["photos/1475/aa70c091b32a.jpg"]},{"r":5,"d":"2025-12-27","a":"ssy6***","t":"4년만에 다시 다이어리를 쓰려고 보니 \n너무 많은 브랜드와 디자인들이 많아서 \n고민하다가 제가 첫 다이어리를 쓰기시작했던 \n리훈 다이어리를 9년만에 다시 구매해보았습니다.\n두꺼운 속지와 깔끔한 디자인 \n그리고 폭신한 겉 케이스까지 \n여전히 마음에 쏙 들었습니당 다쓰면 내년에도 여기서 재주문 할려고요❤️","h":0,"b":false,"s":"12629011395","p":["photos/1475/beacf52a9fd8.jpg","photos/1475/e44982e41456.jpg","photos/1475/dce491bf797d.jpg"]}]