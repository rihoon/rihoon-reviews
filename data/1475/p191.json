[{"r":4,"d":"2025-12-28","a":"kyun*******","t":"3-4년째 리훈 다이어리를 사용해왔어요. 속지도 좋고 취향껏 골라쓸 수 있어서 특히 좋았어요. 항상 색이 고민이 많았었는데 이번엔 실버가 있어서 선택했는데 조금 아쉬웠어요. 반짝반짝 이런 걸 생각했는데 아니여서 그게 조금 아쉬웠다... 그것 말고는 다 만족합니다! 완전 추천이요!","h":0,"b":false,"s":"12629011395"},{"r":5,"d":"2025-12-28","a":"thdu*****","t":"내년에 또 적을려구 올해 샀습니다!!! 짧은 말들적을려고 샀는데 이번에는 좀더 짧고 효울성있는게필요해서 다른거로 사봤어요 ㅎㅎ 만족합니다","h":0,"b":false,"s":"12629011395","p":["photos/1475/fc0051f17d4f.jpg"]},{"r":5,"d":"2025-12-28","a":"baej*****","t":"색도 넘이쁘구 생각보다 야무지네용","h":0,"b":false,"s":"12629011395","p":["photos/1475/02be4cb983eb.jpg"]},{"r":5,"d":"2025-12-28","a":"st****","t":"만족합니다. 깔끔하고 예뻐요.","h":0,"b":false,"s":"12629011395","p":["photos/1475/814604464b5a.jpg"]},{"r":5,"d":"2025-12-28","a":"miri****","t":"종이 재질도 좋고 칸도 적당해요. 디자인이 귀엽습니다. 의외로 같이 온 볼펜이 좋아서 또 사러구요.","h":0,"b":false,"s":"12629011395","p":["photos/1475/2e0c32509b64.jpg"]},{"r":5,"d":"2025-12-28","a":"chu0***","t":"주말인데\n배송이 왔어요\n빨리 받을수 있어서 더 좋네요👍","h":0,"b":false,"s":"12629011395","p":["photos/1475/98c23d7f83e8.jpg"]},{"r":5,"d":"2025-12-28","a":"swar****","t":"색깔이 화사하게 너무 예쁘네요~\n작은 점하나가 있어서 아쉽지만\n그냥 쓰려구요~ㅎㅎ","h":0,"b":false,"s":"12629011395","p":["photos/1475/e15ea976d812.jpg","photos/1475/7f90a11371d2.jpg"]},{"r":5,"d":"2025-12-28","a":"hksk*****","t":"휴일에도 빠른배송 감사합니다","h":0,"b":false,"s":"12629011395","p":["photos/1475/2a63a1cac418.jpg"]},{"r":5,"d":"2025-12-28","a":"alsx*****","t":"2021년~2026까지 일기용 다이어리로 매년 구매하고 있어요!! 항상 만족합니다","h":0,"b":false,"s":"12629011395","p":["photos/1475/094eb10666b1.jpg"]},{"r":5,"d":"2025-12-28","a":"mu****","t":"작년에 사서 잘 쓰고 이번에는 다른 색깔도 샀어요. 라벤더 색이 굉장히 예쁘게 나왔어요. 마음에 듭니다.","h":0,"b":false,"s":"12629011395"}]