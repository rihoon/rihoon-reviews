[{"r":5,"d":"2026-01-03","a":"gime****","t":"우선 구성이 너무 좋아요. 너무 크지도 작지도 않아서 날마다 쓸 게 있는 저한텐 딱인것 같아요. 컬러도 실버 너무 유니크해서 맘에 들구요. 무엇보다 펜이 왜이렇게 좋죠? 부드럽고 슥슥 써지는게 완전 취향저격. 펜만 또 사고 싶어요\n다만 기존에 쓰고 있는 스티커들을 파우치에 넣고 싶은데 생각보다 다이어리 크기가 작아서 파우치안에 쏙 들어가진 않네요. 스티커를 잘라서 넣음 되니까 문제 없어요 !","h":0,"b":false,"s":"12629011395","p":["photos/1475/6bf70a1c1157.jpg"]},{"r":5,"d":"2026-01-03","a":"free****","t":"포장 잘되있고 정말 빠른배송 만족합니다. 추가로 몇개 더 구입하려합니다","h":0,"b":false,"s":"12629011395","p":["photos/1475/6940d60dca68.jpg"]},{"r":5,"d":"2026-01-03","a":"free****","t":"빠르게 배송해 주셔서 매우 만족합니다 !!","h":0,"b":false,"s":"12629011395"},{"r":5,"d":"2026-01-03","a":"free****","t":"여러개 구매 했는데 리뷰는 하나씩해야되네요 ㅎㅎ 상품은 매우 만족합니다","h":0,"b":false,"s":"12629011395"},{"r":5,"d":"2026-01-03","a":"free****","t":"빠른배송 매우 만족 포장상태도 매우 좋습니다 잘쓰겠습니다","h":0,"b":false,"s":"12629011395"},{"r":5,"d":"2026-01-03","a":"hee_*****","t":"매년 나오는 다이어리라 좋고 배송이 빨라서 더 좋아요!!","h":0,"b":false,"s":"12629011395","p":["photos/1475/3e364be360fb.jpg"]},{"r":5,"d":"2026-01-03","a":"kikk******","t":"색상도 쓰기도 좋게 되어있어요","h":0,"b":false,"s":"12629011395"},{"r":5,"d":"2026-01-03","a":"ys****","t":"배송이 빨라서 좋아요","h":0,"b":false,"s":"12629011395"},{"r":5,"d":"2026-01-03","a":"mins********","t":"사이즈도 마음에 들고 다이어리 색상이 너무 예뻐염","h":0,"b":false,"s":"12629011395","p":["photos/1475/634bbdaf1755.jpg"]},{"r":5,"d":"2026-01-03","a":"taew******","t":"잘 사용했던 제품이라 올해도 구매해요\n증정용 펜이 돌려쓰는 식으로 되어서 더 편해졌어요!","h":0,"b":false,"s":"12629011395","p":["photos/1475/818d794537ba.jpg"]}]