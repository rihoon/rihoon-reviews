[{"r":5,"d":"2026-01-07","a":"ksye*****","t":"작년엔 잠깐 다른 다이어리 썼는데 결국 리훈으로 돌아왔어요\n심플한데 구성도 좋고 크기도 딱이고\n쓰는 사람 생각해주는 다이어리 찾기 쉽지 않거등요~~\n올해는 귀여운 노란색으로 픽해봤는데\n예상대로 쌍콤하구요\n때탈까 걱정되긴하는데 저만 관리 잘하면 되는거니까 당장의 예쁨으로 뭐든게 다 오케이구요!\n올해도 예쁘게 써보겠습니다~~","h":0,"b":false,"s":"12629011395","p":["photos/1475/e33e018d99de.jpg","photos/1475/e11b9fce309f.jpg"]},{"r":5,"d":"2026-01-07","a":"wlsd*******","t":"마음에 꼭 들어용^^","h":0,"b":false,"s":"12629011395"},{"r":5,"d":"2026-01-07","a":"eric****","t":"디자인이 예쁘고 작성할 수 있는 컨텐츠가 다양합니다","h":0,"b":false,"s":"12629011395"},{"r":5,"d":"2026-01-07","a":"dpgp****","t":"몇 년 째 쓰는거라 벌써 6권이나 모였어요","h":0,"b":false,"s":"12629011395","p":["photos/1475/5421fc146541.jpg","photos/1475/b409c5102cfb.jpg"]},{"r":5,"d":"2026-01-07","a":"redd*******","t":"표지 색상도 사랑스럽고 예쁩니다. 다이어리 구성도 마음에 듭니다.","h":0,"b":false,"s":"12629011395","p":["photos/1475/00c314849409.jpg"]},{"r":5,"d":"2026-01-07","a":"lsh0***","t":"항상 이용하는 제품으로 만족합니다.","h":0,"b":false,"s":"12629011395"},{"r":5,"d":"2026-01-07","a":"dldy******","t":"회사에서 매우 잘 쓰고 있습니다","h":0,"b":false,"s":"12629011395","p":["photos/1475/a1876aa573ea.jpg"]},{"r":5,"d":"2026-01-07","a":"moon******","t":"배송도빠르고 깔끔하개 포장와서 좋았어요","h":0,"b":false,"s":"12629011395","p":["photos/1475/181e88de621c.jpg"]},{"r":5,"d":"2026-01-07","a":"supe****","t":"해마다 사용하는 나의 일부입니다^^\n만족해용^^","h":0,"b":false,"s":"12629011395","p":["photos/1475/7081e10f871c.jpg"]},{"r":5,"d":"2026-01-07","a":"suni*****","t":"리훈제품은 믿고 쓰죠~~\n달력도 다이어리도 넘 맘에들어요!!","h":0,"b":false,"s":"12629011395","p":["photos/1475/7dd39e508a16.jpg"]},{"r":5,"d":"2026-01-07","a":"aa99*****","t":"사실 지난번에 이걸 사고 싶었어요. ㅎ\n그때 파란색은 집에 두고 일기장으로 씁니다.\n성당+학부모회 활동을 하는지라\n하나는 더 있어야지 싶어 또 샀어요.\n사실 천주교 서점에서 살까 싶었는데,\n쓰기 시작했으니 하나 더 써보려고요.\n지난번 파란색은 스티커가 접혀 와서ㅠ\n올해 초딩 입학하는 딸 몫으로 줬는데\n이번에는 제가 잘 써볼게요.","h":0,"b":false,"s":"12629011395","p":["photos/1475/95e62cc9bb5c.jpg","photos/1475/58c837fa4663.jpg","photos/1475/1aeab04365a4.jpg","photos/1475/6e07c1de3e31.jpg","photos/1475/e8c490f44ce5.jpg","photos/1475/7397ec8535e2.jpg","photos/1475/af27f0d74bfe.jpg"]},{"r":5,"d":"2026-01-07","a":"1994****","t":"맘에들어요 두께가 조금있지만 하루 한페이지 쓰고싶어 구매했어요 \n\n내년엔 그리드 없는거나 도트연하게로 변경없나요","h":0,"b":false,"s":"12629011395","p":["photos/1475/29ca811ca3f4.jpg"]},{"r":5,"d":"2026-01-07","a":"le****","t":"이번엔 파스텔이 별로 안끌려서 실버 색상 샀는데 맘에 들어요 깔끔하고 예뻐요","h":0,"b":false,"s":"12629011395","p":["photos/1475/7d007621737d.jpg"]},{"r":5,"d":"2026-01-07","a":"hny0***","t":"작년에이어 구입한 다이어리입니다. 일기를 쓰니 언제 무슨 일이 있었는지 나중에 보면 그날의 일이 떠오르더라구요. 올해는 분홍색으로 구입했는데 약간 진한 색입니다.","h":0,"b":false,"s":"12629011395","p":["photos/1475/b1544624c4f2.jpg"]},{"r":3,"d":"2026-01-07","a":"free*****","t":"사이즈가 넘 작네요 좀 컸으면 좋겠습니다","h":0,"b":false,"s":"12629011395","p":["photos/1475/97422dc741f0.jpg"]},{"r":5,"d":"2026-01-07","a":"ny****","t":"구성 너무 맘에 들어요","h":0,"b":false,"s":"12629011395","p":["photos/1475/3f782db6d925.jpg"]},{"r":5,"d":"2026-01-07","a":"smil*****","t":"하늘색 색감 넘 이쁘고 구성도 깔끔해요\n같이 오는 펜도 깔맞춤이라 이쁜데 잘써서 좋네요!","h":0,"b":false,"s":"12629011395","p":["photos/1475/1d17f60754f3.jpg"]},{"r":5,"d":"2026-01-07","a":"win2***","t":"너무 너무 너무 너무 너무 좋아요","h":0,"b":false,"s":"12629011395","p":["photos/1475/1640be7d981f.jpg"]},{"r":5,"d":"2026-01-07","a":"win2***","t":"너무 너무 너무 너무 좋아요","h":0,"b":false,"s":"12629011395","p":["photos/1475/dbba0cbb837f.jpg"]},{"r":5,"d":"2026-01-07","a":"94****","t":"데일리로 쓰다가 위클리 처음 써 보는데 구성이 너무 마음에 들어요. 막 많이 채워야한다는 강박이 없어져서 좋습니다.","h":0,"b":false,"s":"12629011395"}]