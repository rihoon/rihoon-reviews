[{"r":4,"d":"2025-12-04","a":"yd****","t":"볼펜 잘써지고 다이어리 잘써볼게요","h":0,"b":false,"s":"12629011395","p":["photos/1475/e88f269a5431.jpg"]},{"r":5,"d":"2025-12-04","a":"sd****","t":"22년부터 꾸준히 매년 쓰고있어요 내년에도 또 살꺼에요 톨 위클리 단종되면 안되요 너무 슬플것같아용 ㅋㅋ","h":0,"b":false,"s":"12629011395","p":["photos/1475/f2ba320b8356.jpg"]},{"r":5,"d":"2025-12-04","a":"heen***","t":"다이어리는 리훈이 종류도 많고 다양한 것 같아요, 연말되면 리훈 다이어리부터 찾아본답니다. 이번에도 예쁜 걸로 잘 구매한 것 같아서 기분이 좋네요! 배송도 빨라서 좋아요!!잘 쓰겠습니다.","h":0,"b":false,"s":"12629011395"},{"r":5,"d":"2025-12-04","a":"ekgm*****","t":"조아욧 굿굿ㅎㅎ ~","h":0,"b":false,"s":"12629011395"},{"r":5,"d":"2025-12-04","a":"2260***","t":"매년 쓰고 있어요, 6년째ㅎㅎ","h":0,"b":false,"s":"12629011395","p":["photos/1475/ca4348d63e28.jpg"]},{"r":5,"d":"2025-12-04","a":"name****","t":"은색이 새롭게 나와서 샀는데 마음에들어요\n매번 12월에 리훈 다이어리만 삽니다","h":0,"b":false,"s":"12629011395","p":["photos/1475/8772434cc9a4.jpg"]},{"r":5,"d":"2025-12-04","a":"eomh*********","t":"작년뺘고 매년 리훈에서 비슷한제품으로 구매했는데 이번에는 실버가 나와서 구매햤어요.\n겉표지가?다른느낌인데 좀 아쉬웠어오ㅜㅜ\n\n그리고 속지가 반딱하니 이쁘고 내용은 쓰던거라\n뭐 만족해요오.\n\n새로나온 캘린더들도 같잋구매했는데\n독서기록장하기 딱좋은거갗아요 ㅎㅎ\n저는 1월주터 새로쓴느걸 좋아해서\n지금다이어리 다쓰고 빨리 넘어갈날만기더리고있어용ㅋㅋㅋ","h":0,"b":false,"s":"12629011395","p":["photos/1475/911182df8635.jpg","photos/1475/6e3d9fbe1ac8.jpg","photos/1475/eb3098ecae64.jpg","photos/1475/dcd90a7c025f.jpg","photos/1475/67cbbe742e4c.jpg","photos/1475/66c93e6a0f95.jpg","photos/1475/190a5b9e0426.jpg","photos/1475/95ba618e365f.jpg","photos/1475/dd2026994230.jpg","photos/1475/976e8498dd48.jpg"]},{"r":5,"d":"2025-12-04","a":"ilhw******","t":"이제 4년째 사용하네요. \n이제 안쓰면 허전한 느낌입니다.\n해마다 신상 색깔은 꼭  사는데 한정판 느낌이라 너무 좋아요.","h":0,"b":false,"s":"12629011395","p":["photos/1475/794d09225335.jpg","photos/1475/48fce962af65.jpg"]},{"r":5,"d":"2025-12-04","a":"rena******","t":"늘 쓰는 제품 입니다","h":0,"b":false,"s":"12629011395"},{"r":5,"d":"2025-12-04","a":"rena******","t":"늘쓰던 제품. 맘에들어요","h":0,"b":false,"s":"12629011395"},{"r":5,"d":"2025-12-04","a":"hyde****","t":"원래 쓰던 다이어리가 이번 년도엔 안 팔아서 다른거 찾아보고 내년 다이어리 미리 사놨는데 웬걸. 너무 커서 컴팩트 하지 않고 종이 재질이 너무 맨들맨들해서 기분 나빳음. 다이어리 외부 재질이 가죽 느낌이 아니라 두꺼운 종이에 코팅지 붙여놓은 느낌.\n\n그래서 다시 제대로 알아보고 여기서 샀는데 사이즈 한 손 크기 합격. 재질 가죽 합격. 내부 레이아웃 복잡하지 않고 깔끔한 구성 합격. 다이어리 구성 이것저것 있어봐야 귀찮고, 꾸미기용보단 중요한 일들 까먹지 않기 위해 쓰는 나는 구성이 단순해서 좋았음.\n\n내년에도 쓰게 이대로 똑같이 나와줬음 좋겠어요,,,","h":0,"b":false,"s":"12629011395","p":["photos/1475/d5daf14ed335.jpg","photos/1475/c1e0a0e1e71a.jpg","photos/1475/3116f461dc02.jpg","photos/1475/6f02a5bc0822.jpg","photos/1475/eb3270ae45dc.jpg","photos/1475/8f8acaf9e453.jpg","photos/1475/92c0a188a9fe.jpg","photos/1475/86d9090107ff.jpg","photos/1475/5cedd996e7fd.jpg"]},{"r":5,"d":"2025-12-04","a":"jk****","t":"예쁜 다이어리를 찾고 있었는데 마음에 들어요! 배송도 엄청 빠르네요 ㅎㅎ 감사합니다!","h":0,"b":false,"s":"12629011395","p":["photos/1475/6239d2a4ae31.jpg"]},{"r":4,"d":"2025-12-04","a":"pian******","t":"우연히 알게된 다이어리인데 종이 질이 좋고 1년간 든든하네요. 잘 쓸게요.","h":0,"b":false,"s":"12629011395","p":["photos/1475/ac1942288be0.jpg"]},{"r":5,"d":"2025-12-04","a":"yang***********","t":"항상 재구매하는 제품입니다 좋아요","h":0,"b":false,"s":"12629011395","p":["photos/1475/b1c1e2fbd5f7.jpg"]},{"r":4,"d":"2025-12-04","a":"crui********","t":"빠른 배송이 너무 좋네요.","h":0,"b":false,"s":"12629011395","p":["photos/1475/3aa1c1c3f7ee.jpg"]},{"r":5,"d":"2025-12-04","a":"eoeo****","t":"와~ 26년에도 열심히 일해야징!^^","h":0,"b":false,"s":"12629011395","p":["photos/1475/b584b3acacdd.jpg"]},{"r":4,"d":"2025-12-04","a":"juof*****","t":"디자인, 배송 좋음.\n모눈 형태로 되어 있어서.\n조금불편.\n줄 형태로 조정되면 좋을 것 같음.","h":0,"b":false,"s":"12629011395","p":["photos/1475/d4da855e4406.jpg","photos/1475/dd4c78a26774.jpg"]},{"r":5,"d":"2025-12-04","a":"youn******","t":"생각보다 작은 느낌은 드는데\n구성과 색감이 너무 좋아요","h":0,"b":false,"s":"12629011395","p":["photos/1475/d1c285eb21b4.jpg"]},{"r":5,"d":"2025-12-04","a":"jhj9*****","t":"어제 주문했는데 오늘 와서 바로 쓸 수 있네요\n주절주절 쓰는 타입이라 한페이지 샀는데 아주 맘에 듭니다.\n깔끔하니 좋아요","h":0,"b":false,"s":"12629011395","p":["photos/1475/e231a8fcf88d.jpg"]},{"r":5,"d":"2025-12-04","a":"swee*****","t":"좋아하는 색으로 골랐어요. 12월 부터 바로 사용중입니다~","h":0,"b":false,"s":"12629011395","p":["photos/1475/8d5ca62184cf.jpg"]}]