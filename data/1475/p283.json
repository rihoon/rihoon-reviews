[{"r":4,"d":"2025-12-04","a":"yd****","t":"볼펜 잘써지고 다이어리 잘써볼게요","h":0,"b":false,"s":"12629011395","p":["photos/1475/e88f269a5431.jpg"]},{"r":5,"d":"2025-12-04","a":"sd****","t":"22년부터 꾸준히 매년 쓰고있어요 내년에도 또 살꺼에요 톨 위클리 단종되면 안되요 너무 슬플것같아용 ㅋㅋ","h":0,"b":false,"s":"12629011395","p":["photos/1475/f2ba320b8356.jpg"]},{"r":5,"d":"2025-12-04","a":"heen***","t":"다이어리는 리훈이 종류도 많고 다양한 것 같아요, 연말되면 리훈 다이어리부터 찾아본답니다. 이번에도 예쁜 걸로 잘 구매한 것 같아서 기분이 좋네요! 배송도 빨라서 좋아요!!잘 쓰겠습니다.","h":0,"b":false,"s":"12629011395"},{"r":5,"d":"2025-12-04","a":"ekgm*****","t":"조아욧 굿굿ㅎㅎ ~","h":0,"b":false,"s":"12629011395"},{"r":5,"d":"2025-12-04","a":"2260***","t":"매년 쓰고 있어요, 6년째ㅎㅎ","h":0,"b":false,"s":"12629011395","p":["photos/1475/ca4348d63e28.jpg"]},{"r":5,"d":"2025-12-04","a":"name****","t":"은색이 새롭게 나와서 샀는데 마음에들어요\n매번 12월에 리훈 다이어리만 삽니다","h":0,"b":false,"s":"12629011395","p":["photos/1475/8772434cc9a4.jpg"]},{"r":5,"d":"2025-12-04","a":"eomh*********","t":"작년뺘고 매년 리훈에서 비슷한제품으로 구매했는데 이번에는 실버가 나와서 구매햤어요.\n겉표지가?다른느낌인데 좀 아쉬웠어오ㅜㅜ\n\n그리고 속지가 반딱하니 이쁘고 내용은 쓰던거라\n뭐 만족해요오.\n\n새로나온 캘린더들도 같잋구매했는데\n독서기록장하기 딱좋은거갗아요 ㅎㅎ\n저는 1월주터 새로쓴느걸 좋아해서\n지금다이어리 다쓰고 빨리 넘어갈날만기더리고있어용ㅋㅋㅋ","h":0,"b":false,"s":"12629011395","p":["photos/1475/911182df8635.jpg","photos/1475/6e3d9fbe1ac8.jpg","photos/1475/eb3098ecae64.jpg","photos/1475/dcd90a7c025f.jpg","photos/1475/67cbbe742e4c.jpg","photos/1475/66c93e6a0f95.jpg","photos/1475/190a5b9e0426.jpg","photos/1475/95ba618e365f.jpg","photos/1475/dd2026994230.jpg","photos/1475/976e8498dd48.jpg"]},{"r":5,"d":"2025-12-04","a":"ilhw******","t":"이제 4년째 사용하네요. \n이제 안쓰면 허전한 느낌입니다.\n해마다 신상 색깔은 꼭  사는데 한정판 느낌이라 너무 좋아요.","h":0,"b":false,"s":"12629011395","p":["photos/1475/794d09225335.jpg","photos/1475/48fce962af65.jpg"]},{"r":5,"d":"2025-12-04","a":"rena******","t":"늘 쓰는 제품 입니다","h":0,"b":false,"s":"12629011395"},{"r":5,"d":"2025-12-04","a":"rena******","t":"늘쓰던 제품. 맘에들어요","h":0,"b":false,"s":"12629011395"}]