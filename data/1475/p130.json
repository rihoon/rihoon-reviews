[{"r":5,"d":"2026-01-08","a":"x930***","t":"다이어리 쓰기 좋아요.^^","h":0,"b":false,"s":"12629011395"},{"r":5,"d":"2026-01-08","a":"hann*****","t":"사진에 물자국은 무시해주시길\n\n우선 페이지 불량이 있어 교환 요청드렸는데 재배송이 빨라 빠른 시일에 받을 수 있었어요! 날짜형 다이어리는 시작하는 날짜가 연초로부터 빠를수록 깔끔해서 좋으니까 대응이 마음에 들었습니다.\n\n다이어리를 찾아보다가 일상적으로 쓰기 좋은 내지 구성, 고정 끈, 펜 주는 게 마음에 들어 선택했고 받아보니 가지고 다니기 좋은 사이즈에 색상이 깔끔하게 고급져 보여서 더 마음에 들었습니다\n\n잘 쓸게요!","h":0,"b":false,"s":"12629011395","p":["photos/1475/ece6563a5c3c.jpg","photos/1475/d680c15012cb.jpg","photos/1475/fba03e9e75b0.jpg"]},{"r":5,"d":"2026-01-08","a":"ycho****","t":"걱정했던거보다 사이즈가 작아서 좋았고 종이 재질도 뻣뻣하지 않고 적당해서 마음에 들었어요!","h":0,"b":false,"s":"12629011395","p":["photos/1475/484c63aeb6cd.jpg"]},{"r":5,"d":"2026-01-08","a":"wngu*****","t":"생각보다 쓰다보면 작은가 싶기도 해요","h":0,"b":false,"s":"12629011395"},{"r":5,"d":"2026-01-08","a":"yuju******","t":"잘 사용할게요. 올해는 꾸준히 쓰기를…","h":0,"b":false,"s":"12629011395","p":["photos/1475/33076cc939ab.jpg"]},{"r":5,"d":"2026-01-08","a":"bbom*****","t":"배송도 빠르고  만족스럽습니다\n잘쓸꺼밭아요","h":0,"b":false,"s":"12629011395","p":["photos/1475/869d6cee7652.jpg"]},{"r":5,"d":"2026-01-08","a":"go****","t":"생각보단 직았는데 제가 딱 원하는 구성이었습니다","h":0,"b":false,"s":"12629011395","p":["photos/1475/c9c6c3b0de8f.jpg"]},{"r":5,"d":"2026-01-08","a":"hjky******","t":"다이어리 너무 사랑스럽네요.\n1년내내 행복할듯요","h":0,"b":false,"s":"12629011395","p":["photos/1475/854337f0c410.jpg"]},{"r":5,"d":"2026-01-08","a":"jkhi****","t":"넘 맘에 들어여!!","h":0,"b":false,"s":"12629011395"},{"r":5,"d":"2026-01-08","a":"tong******","t":"라벤더가 유치하지 않고 색감이 곱습니다.  구성도 안내와 동일하고 배송도 전날 저녁에  주문했는데 담날 낮 도착!! 🌞 넘 맘에 듭니다. 올해 잘쓸수 있을것 같아요.","h":0,"b":false,"s":"12629011395","p":["photos/1475/aac7f6bebe28.jpg","photos/1475/048d0831ebf3.jpg"]}]