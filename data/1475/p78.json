[{"r":5,"d":"2026-01-25","a":"atom***","t":"월-주간으로 구성되어있어 사용하기 딱 좋아요.\n펜은 촉감이 부드러워 자꾸 쓰고 싶어지네요.","h":0,"b":false,"s":"12629011395"},{"r":5,"d":"2026-01-25","a":"seoy******","t":"그란데 이틀 한 페이지 구성이라 하루 기록하기 딱 좋아요.\n상반기용이라 부담 없이 시작하기 좋고, 종이 질이 좋아서 펜 번짐도 거의 없네요.\n사이즈도 큼직해서 글씨 크게 써도 답답하지 않아요.\n깔끔한 디자인이라 오래 써도 질리지 않을 것 같아요.","h":0,"b":false,"s":"12629011395","p":["photos/1475/4ce8137e37ea.jpg"]},{"r":5,"d":"2026-01-25","a":"jewe*****","t":"한번 사보고 만족해서 딸래미 줄려고 추가로 구매했어요","h":0,"b":false,"s":"12629011395","p":["photos/1475/25677b862612.jpg"]},{"r":5,"d":"2026-01-25","a":"maca******","t":"한달 사용 후기임. 마음에 든다","h":0,"b":false,"s":"12629011395","p":["photos/1475/c8e7b5551859.jpg"]},{"r":5,"d":"2026-01-24","a":"yang***********","t":"재구매해요 배송도빠르고좋아오","h":0,"b":true,"s":"12629011395","p":["photos/1475/0ac73fb5fa3c.jpg"]},{"r":5,"d":"2026-01-24","a":"shpa******","t":"다이어리에 펜까지 있어서 편하고 좋아요","h":0,"b":false,"s":"12629011395"},{"r":5,"d":"2026-01-24","a":"0712********","t":"사이즈도 원했던 사이즈고 종이가 엄청 부드러워요! 만년필도 잘 써집니다.\n비침이 아주없지는 않은데 뒷장을 쓰는덴 지장없습니다! 잘쓰겠습니다","h":0,"b":false,"s":"12629011395","p":["photos/1475/415dbb64f2d3.jpg"]},{"r":5,"d":"2026-01-24","a":"yjy9***","t":"표지 디자인이 예쁘고 종이 질감도 좋아서 쓰는 재미가 있어요. 날짜 구성도 깔끔해서 일정 정리와 일기 쓰기 모두 만족스럽습니다.","h":0,"b":true,"s":"12629011395","p":["photos/1475/9bdf15929636.jpg"]},{"r":5,"d":"2026-01-24","a":"hoji****","t":"무거울까봐 상하 나눠서 샀어요! 무게감 딱 좋고 구성도 좋아서 다이어리 쓸맛 날것같아요 ㅎㅎ","h":0,"b":false,"s":"12629011395","p":["photos/1475/f6b8f24e4a60.jpg"]},{"r":5,"d":"2026-01-24","a":"hoji****","t":"무거울까봐 상하 나눠서 샀어요! 무게감 딱 좋고 구성도 좋아서 다이어리 쓸맛 날것같아요 ㅎㅎ","h":0,"b":true,"s":"12629011395","p":["photos/1475/289b8f54a566.jpg"]}]