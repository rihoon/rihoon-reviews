[{"r":5,"d":"2026-01-28","a":"saym***","t":"다이어리에 숫자 쓰는것보다 이렇게 스티커 붙이니 깔끔하고 좋아요ㅎㅎ","h":0,"b":false,"s":"12374323608","p":["photos/1582/3578cec9042a.jpg","photos/1582/a1e890a8ac0a.jpg","photos/1582/213b73c5fa7b.jpg"]},{"r":5,"d":"2026-01-28","a":"saym***","t":"만족해요 예쁘고 양 많아요","h":0,"b":false,"s":"12374323608","p":["photos/1582/0074271eb96f.jpg"]},{"r":5,"d":"2026-01-28","a":"gold******","t":"친구들에게 다이어리 선물과 함께 하려고 구입했어요.","h":0,"b":false,"s":"12374323608","p":["photos/1582/7e44fa2ec659.jpg"]},{"r":5,"d":"2026-01-28","a":"2b****","t":"완전 로켓배송이더라고요!! 일력 스티커 진짜 당장 쓰고 싶었는데 배송이 정말 빨라서 밤에 주문했는데도 다음날 오후에 받아서 바로 사용하게 됐어요","h":0,"b":false,"s":"12374323608","p":["photos/1582/1f6504280f63.jpg","photos/1582/fdd4fe8c500b.jpg"]},{"r":5,"d":"2026-01-27","a":"nana*******","t":"너무 아름답습니다...\n고민하다가 막판에 할인할때 업어왔어요\n일단 제본이 되어있어 보관이 편하고 (투명스티커는 제본에서 쉽게 떨어지긴하던데 저는 애초에 따로 들고다니려고 뜯어둠)\n일단 여러무드의 스티커가 있어서 불렛저널, 플래너, 일기 등 쓰기에 너무 실용적입니다... 직접 그려쓰시거나 만년형 쓰시는 분들의 필수템이에요\n그리고 스티커들이 얇아서 엄청 뚱뚱해지지 않아요 스티커 달력 쓰고싶은데 노트 두꺼워지기는 싫은분들 꼭 쓰시길\n명조체는 한장밖에 없어서 약간 아쉽긴한데 볼드한 고딕체가 깔끔한 플래너에 딱이라 너무 좋아요 ㅎㅎ\n컬러도 튀지않고 딱 녹아드는 색이라 좋습니다 대부분 차분한 색이라 질리지는 않아요\n12장이나 있어서 다양하게 적용하기 좋습니다 무엇보다 플래너가 정돈되어 보여서 강추...","h":0,"b":false,"s":"12374323608","p":["photos/1582/965c48917017.jpg","photos/1582/778acfed222e.jpg","photos/1582/f9ba544489a7.jpg","photos/1582/839a533e955e.jpg","photos/1582/3be8aeac7d22.jpg","photos/1582/38788d8baf82.jpg"]},{"r":5,"d":"2026-01-26","a":"znlf***","t":"숫자쓰기 싫어 하는 저한테 최고의 스티커입니다.","h":0,"b":false,"s":"12374323608","p":["https://phinf.pstatic.net/checkout.phinf/20260126_219/1769389937330dnNdf_JPEG/1000030864.jpg"]},{"r":5,"d":"2026-01-26","a":"znlf***","t":"크기별로 있고 색도 이쁘고 두루두루 사용할거같아요","h":0,"b":false,"s":"12374323608","p":["https://phinf.pstatic.net/checkout.phinf/20260126_10/1769389986931cYCYB_JPEG/1000030864.jpg"]},{"r":5,"d":"2026-01-25","a":"yuju*******","t":"매일매일 할일 적을때 쓰려고 샀고 아직 잘 지키진 못했지만 매일 써보려고요","h":0,"b":false,"s":"12374323608","p":["https://phinf.pstatic.net/checkout.phinf/20260125_262/1769319418629dFCEm_JPEG/image.jpg"]},{"r":5,"d":"2026-01-25","a":"co****","t":"캘린더 스티커가 많이 필요했는데\n너무 만족해요!","h":0,"b":false,"s":"12374323608","p":["https://phinf.pstatic.net/checkout.phinf/20260125_142/1769334371967ViTzQ_JPEG/image.jpg"]},{"r":5,"d":"2026-01-25","a":"mina****","t":"하나하나 붙일때 시간이 좀 걸리긴한데 붙여놓으니 깔끔합니다.\n좀 더 다양한 디자인 고를 수 있음 좋겠어요","h":0,"b":false,"s":"12374323608","p":["https://phinf.pstatic.net/checkout.phinf/20260125_109/1769337900961ycVfQ_JPEG/1769337890662.jpg"]}]