[{"r":5,"d":"2026-03-31","a":"mn****","t":"마음에 들어요. 노트도 단단하고 무엇보다 3년 동안 사용할 수 있다는 게 참 좋네요. 오타라는 것 때문에 가격 혜자인 것도 짱이고. 새로운 계획을 세우고 이번에는 정말 잘 지내보고 싶어요. 모두들 화이팅","h":0,"b":true,"s":"13154676922","p":["photos/1466/ad3e228a7db9.jpg"]},{"r":5,"d":"2026-03-31","a":"mn****","t":"구성이 마음에 들어서 샀어요. 아무 날짜나 쓸 수 있고 3년이라는 긴 기간 동안도 사용할 수 있고\n하루 한쪽이지만 3개로 나눠 있어서\n종류별로 나눠 쓸 수 있는 것도 좋고 열심히 써볼랍니다. 저렴하게 주셔서 감사해요.","h":0,"b":true,"s":"13154676922","p":["photos/1466/97a6ed353b5a.jpg"]},{"r":5,"d":"2026-03-31","a":"khj9****","t":"깔끔하고 쓰기 정말 좋아요!","h":0,"b":false,"s":"13154676922"},{"r":5,"d":"2026-03-31","a":"babu*****","t":"맘에들어요 잘쓸거같아요","h":0,"b":false,"s":"13154676922","p":["photos/1466/a43eba111e30.jpg"]},{"r":5,"d":"2026-03-30","a":"bobe****","t":"매일을 기록하는데 좋은 브랜드 제품을 사용하고 싶었는데 딱 입니다. \n튼튼하고 손때 묻어도 멋스러울 것 같아요.\n앞으로 3년 잘 사용하겠습니다.","h":0,"b":true,"s":"13154676922","p":["photos/1466/e6e3b0516be9.jpg"]},{"r":4,"d":"2026-03-30","a":"kh****","t":"생각지못한질문들도 있어서 좋았어요","h":0,"b":false,"s":"13154676922"},{"r":4,"d":"2026-03-30","a":"kh****","t":"쓸거리 고민은 안할듯요","h":0,"b":false,"s":"13154676922"},{"r":5,"d":"2026-03-30","a":"ekek******","t":"3년일기 잘 쓰는 중이라 반값이길래 바로 내년꺼 구매했습니다! 더 표지가 예뻐졌어요 이것까지 하면 다음번은 5년일기 도전해보고싶어요!","h":0,"b":false,"s":"13154676922"},{"r":5,"d":"2026-03-30","a":"rmaw******","t":"잘 받았어요. 색상,재질,사이즈 모두 마음에 들어요.","h":0,"b":false,"s":"13154676922","p":["photos/1466/808df8edcd01.jpg"]},{"r":5,"d":"2026-03-30","a":"flut*****","t":"오타제품 구입했지만 나름 만족ㅎ","h":0,"b":false,"s":"13154676922","p":["photos/1466/72bdcd0f54ba.jpg"]}]