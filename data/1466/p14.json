[{"r":5,"d":"2026-03-24","a":"hapi***","t":"디자인이 깔끔하고 표지도 고급스럽고 만족합니다.\n암투병을 시작하며 일상반경이 줄어들고, 기록이 하고 싶어져서 구입하게 되었습니다. 3년이란 시간 기록할 수 있으니 병이 나아가는 걸 기록할 수 있고 딸에게 저의 기록을 남길 수 있어서 3년 다이어리 좋은 거 같아요. 그 동안의 저를 보면 꾸준히 쓸 자신은 없지만 도전해 봅니다.","h":0,"b":false,"s":"13154676922","p":["photos/1466/77080b3234e9.jpg"]},{"r":5,"d":"2026-03-24","a":"kuns*****","t":"일단 저는 보라색 샀는데 너무나 예쁜 보라고요 질감하고도 너무 잘 어울려서 잘 골랐다고 자부! 3년 다이어리는 처음인데 구성도 만족하고 독서노트나 일반 다이어리로도 쓸 수 있어서 좋았어요 그리고 오타 제품이지만 찾을 수가 없었습니다ㅎ","h":0,"b":false,"s":"13154676922"},{"r":5,"d":"2026-03-24","a":"i-ha****","t":"색도 이쁘고 좋아요~","h":0,"b":false,"s":"13154676922","p":["photos/1466/988fb2c234ed.jpg"]},{"r":5,"d":"2026-03-24","a":"beny***","t":"매일 있었던일 간단하게 기록하기 좋은거같아요","h":0,"b":false,"s":"13154676922","p":["photos/1466/de74f2bf4535.jpg"]},{"r":5,"d":"2026-03-23","a":"gh****","t":"디자인도 마음에 들고 심플하고 좋아요","h":0,"b":false,"s":"13154676922","p":["photos/1466/d9b5797caa80.jpg"]},{"r":5,"d":"2026-03-23","a":"toyo*****","t":"빠르게 배송을 해주셔서 금방 받았어요\n속지가 두껍고 좋아서 필기감 기대돼요\n표지 방수도 되고 튼튼해서 3년 동안 잘 사용할 수 있을 것 같아요. 오타는 전혀 신경쓰이지 않고 좋은 가격에 구매할 수 있어 좋아요","h":0,"b":false,"s":"13154676922","p":["photos/1466/a8256bf0c7ad.jpg","photos/1466/a9ab6ee79932.jpg"]},{"r":5,"d":"2026-03-23","a":"br****","t":"좋아요 퀄리티도 좋고 만족합니다","h":0,"b":false,"s":"13154676922","p":["photos/1466/116fcfc414b7.jpg"]},{"r":5,"d":"2026-03-23","a":"wndu******","t":"일요일배송 으로 배송도 빠르고 저렴하게 구입해서 좋아요 잘 쓰겠습니다","h":0,"b":false,"s":"13154676922","p":["photos/1466/5d07a388c264.jpg"]},{"r":5,"d":"2026-03-23","a":"br****","t":"하나 사고 마음에 들어서 바로 하나 더 구입햇어요","h":0,"b":false,"s":"13154676922","p":["photos/1466/3632fdafaccd.jpg"]},{"r":5,"d":"2026-03-23","a":"shin*******","t":"가성비좋은제품배송도빨라요","h":0,"b":false,"s":"13154676922","p":["photos/1466/ba2343ef02bc.jpg"]}]