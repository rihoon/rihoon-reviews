[{"r":5,"d":"2026-02-20","a":"jmy2***","t":"제품은 사이즈,색상 다 마음에 들어요.\n다만 주문한 다음날 도착 보장이라고 알고 있는데 이틀만에 왔네요.","h":0,"b":false,"s":"13098578167","p":["photos/1547/5f270f1874c6.jpg"]},{"r":5,"d":"2026-02-20","a":"jngh****","t":"써봤는데 잉크파인 종이가 아주 만족스러워서 또 구매합니다~","h":0,"b":false,"s":"13098578167","p":["photos/1547/9142fe5961f8.jpg"]},{"r":5,"d":"2026-02-20","a":"smil*****","t":"사이즈 아담해요\n생가보다 작지만 휴대하기 좋을듯합니다","h":0,"b":false,"s":"13098578167","p":["photos/1547/8262b4df9dcd.jpg"]},{"r":5,"d":"2026-02-20","a":"dhan***","t":"큰 손 아니에요. 그래도, 한 손에 딱 잡히는 사이즈에요. 180도로 쫙 펼쳐지니까 작성하기에 편할 것 같아요. 둘이 같은 색을 골라서 같은색 2권이네요. 하루하루 감정쓰기나, 좋은 글귀 작성하거나, 필사할 때도♡ 다양하게 활용하기에 좋은 노트에요! 잘 사용 해 볼게요.","h":0,"b":false,"s":"13098578167","p":["photos/1547/1673a7cf218a.jpg","photos/1547/27556ab1b09e.jpg","photos/1547/c7a71a10124a.jpg","photos/1547/c6c20b5eefe5.jpg","photos/1547/93b5e06f132b.jpg","photos/1547/dc716a0f328e.jpg"]},{"r":5,"d":"2026-02-20","a":"epil******","t":"4권 중 한 권에 띠지가 손상되서 좀 아쉽긴 하지만, 유용할 것 같아요","h":0,"b":false,"s":"13098578167","p":["photos/1547/180f9ef15486.jpg","photos/1547/3fb8b48c57fb.jpg"]},{"r":5,"d":"2026-02-20","a":"lrh4***","t":"빠른배송에 만족합니다","h":0,"b":false,"s":"13098578167","p":["photos/1547/1e2d91ac9038.jpg"]},{"r":5,"d":"2026-02-20","a":"epil******","t":"4권 중 한 권에 띠지가 손상되서 좀 아쉽긴 하지만, 유용할 것 같아요","h":0,"b":false,"s":"13098578167","p":["photos/1547/a34805a8dec7.jpg","photos/1547/dcbc910a16eb.jpg"]},{"r":5,"d":"2026-02-20","a":"jean****","t":"맘에 들어요! 기록하는 습관을 위하여!","h":0,"b":false,"s":"13098578167"},{"r":5,"d":"2026-02-20","a":"oi****","t":"종이 질이 좋네요. 색깔도 맘에 듭니다.  사이즈도 적당하고 좋습니다.","h":0,"b":false,"s":"13098578167","p":["photos/1547/2741998a7fe3.jpg"]},{"r":5,"d":"2026-02-20","a":"j690***","t":"소지하고 다니기 좋은 사이즈 입니다! 속지도 심플합니다~","h":0,"b":false,"s":"13098578167"}]