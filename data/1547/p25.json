[{"r":5,"d":"2026-02-14","a":"mo****","t":"휴대하기 좋은 사이즈의 노트 입니다.\n뒷 비침이 없어 좋아요","h":0,"b":false,"s":"13098578167"},{"r":5,"d":"2026-02-14","a":"sy****","t":"손에 딱 들어오는 사이즈에 만년필 쓰기 좋은 노트입니다.","h":0,"b":false,"s":"13098578167","p":["photos/1547/0349f4238010.jpg"]},{"r":5,"d":"2026-02-14","a":"anfa********","t":"미니한 사이즈가 좋아요 컬러도 예뻐요👍","h":0,"b":false,"s":"13098578167","p":["photos/1547/61011ee1c94f.jpg"]},{"r":5,"d":"2026-02-14","a":"neue********","t":"가지고 다니면서 사용하기 좋아요.","h":0,"b":false,"s":"13098578167"},{"r":5,"d":"2026-02-14","a":"neue********","t":"가니고다니기 너무 좋아요.","h":0,"b":false,"s":"13098578167"},{"r":5,"d":"2026-02-13","a":"a446***","t":"가지고 다니기 편한 노트가 필요했는데 어떻게 제마음을 아시고 만드셨는지...  거기다 색깔도 다이뻐요~ 이야기노트랑 크기비교해보세요! 리훈은 다양한제품이 많아 매달 새로운제품 구입하는재미로 삽니다!","h":2,"b":false,"s":"13098578167","p":["photos/1547/a6093dfbbb9d.jpg","photos/1547/bcf05a8c268e.jpg","photos/1547/89c99f682f2c.jpg","photos/1547/6521a86019a2.jpg","photos/1547/73c77954774f.jpg"]},{"r":5,"d":"2026-02-13","a":"chom***","t":"배송도 빠르고 표지 색깔이 마음에 들어요","h":0,"b":false,"s":"13098578167","p":["photos/1547/d2192b7eabc7.jpg"]},{"r":5,"d":"2026-02-13","a":"nb****","t":"오우~\n역시나 실물을보니 사이즈가 앙증스럽고 좋네요~\n책장 한줄 가득 채우고 싶은 비주얼입니다~😍\n아까워서 아직 비닐은 못 뜯었어요.\n이러다 또 1년지나서 신상품 나오는건 아닐지 모르겠네요~🤣\n하고싶은말 다이어리  데일리와 깔맞춤~🩷","h":3,"b":true,"s":"13098578167","p":["photos/1547/9476bd2c0319.jpg","photos/1547/2cfc4da1f543.jpg","photos/1547/08c3fd61fb36.jpg","photos/1547/a75c7bd5ba1a.jpg","photos/1547/f6be19f8a5a3.jpg","photos/1547/2335ada835b0.jpg","photos/1547/043c6992a71e.jpg"]},{"r":5,"d":"2026-02-13","a":"ju****","t":"받자마자 상자 열고 입이 귀에 걸렸어요. 들고 다니기 간편한 사이즈에 커버도 튼튼하고 어떻게 사용할지 행복한 고민을 했어요. 일단은 필사노트로 사용하려고 합니다. \n노트를 좋아해서 이것저것 사봤는데 휴대하기엔 사이즈가 크거나 아니면 장수가 너무 적은게 항상 아쉬웠는데 제 니즈를 모두 만족하는 노트에요~","h":1,"b":false,"s":"13098578167","p":["photos/1547/79fe77d2319f.jpg","photos/1547/3d182c693cf5.jpg"]},{"r":5,"d":"2026-02-13","a":"ju****","t":"라인+A6+적당한 페이지수+쉽게 망가지지 않는 튼튼한 커버 \n제가 원하는 조건을 다 만족하는 제품를 만났어요. \n알차게 의미있게 내용을 채울 생각을 하니 쓰기 전인데 설레요.","h":0,"b":false,"s":"13098578167","p":["photos/1547/5294e51e8614.jpg","photos/1547/553a7babe77f.jpg"]}]