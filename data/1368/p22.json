[{"r":5,"d":"2026-02-05","a":"wows*********","t":"필사 노트로 쓸려고 구매 했는데 생각 보다 작아서 남편 아이디까지 해서 추가로 구매 했네요ㅋ 젤 기대 했던 버터가 상세페이지 보다 더 색이 빠진 노랑이라 살짝 아쉬워요ㅠㅠ 슈가핑크랑 라벤터가 오히려 더 맘에 드네요ㅋ","h":0,"b":false,"s":"11456950089","p":["photos/1368/af0258329cb7.jpg","photos/1368/91afcc176206.jpg","photos/1368/03c774918f24.jpg"]},{"r":5,"d":"2026-02-05","a":"da****","t":"표지가 유연하면서도 단단한 느낌. 사이즈다 꽉한 A5사이즈입니다. 페이지번호와 1/2표시가 보이네요. 옆면에 색상이있는게 꽤 포인트됩니다.\n기본적으로 180펼침이 되는 제본이지만 펼친채로 있으려면 문진을 쓰는게 좋겠네요.","h":0,"b":false,"s":"11456950089","p":["photos/1368/348e87332eb2.jpg","photos/1368/d5f60792072b.jpg"]},{"r":5,"d":"2026-02-05","a":"dais*****","t":"아주 야무지게 포장이 된채로 너무나 빠르게 배송되어 잘 받았습니다. 너무 예뻐요. 독서노트로 잘 쓸게요. 감사합니다^^","h":0,"b":false,"s":"11456950089","p":["photos/1368/609422c90bcc.jpg","photos/1368/27fad922518f.jpg","photos/1368/75600c17406f.jpg"]},{"r":5,"d":"2026-02-04","a":"hotl****","t":"작년에 이어 올해도 주문했어요. 작년에 산건 실제본 부분이 금방 벌어져서 뜯어지면 어쩌나 걱정했는데, 다행히 잘 버텼어요. 올해는 그 부분이 개선됐다고 하니 기대하고 씁니다.","h":0,"b":false,"s":"11456950089"},{"r":5,"d":"2026-02-04","a":"gold******","t":"만년필 사용하기 좋은 것 같아요. 필사용으로 샀는데 포기하지 않고 잘 사용할게요.","h":1,"b":false,"s":"11456950089","p":["photos/1368/bd09cc9352b0.jpg"]},{"r":3,"d":"2026-02-04","a":"yesk******","t":"선물용이라 부디 불량이 아니길 바랍니다.","h":2,"b":false,"s":"11456950089","p":["photos/1368/1a632a46c026.jpg"]},{"r":5,"d":"2026-02-04","a":"soyo******","t":"미니랑 세뚜로 소장할수 있어서 좋아요~","h":0,"b":false,"s":"11456950089","p":["photos/1368/478ed36966d5.jpg"]},{"r":5,"d":"2026-02-04","a":"ourl****","t":"일기를 다시 써볼까 고민중이었는데 좋은 노트가 원플원딜로 떠서 사봤어요\n\n만년필이나 일반 볼펜 다 사용 가능하다해서 기대되네요.","h":0,"b":false,"s":"11456950089","p":["photos/1368/9b0182c428bd.jpg"]},{"r":5,"d":"2026-02-04","a":"ca****","t":"1+1으로 저렴하게 구입했어요","h":0,"b":false,"s":"11456950089","p":["photos/1368/bcfdb0691242.jpg"]},{"r":5,"d":"2026-02-04","a":"ca****","t":"1+1으로 저렴하게 구입했어요","h":0,"b":false,"s":"11456950089","p":["photos/1368/f85babf9ff38.jpg"]}]