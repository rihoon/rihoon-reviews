[{"r":5,"d":"2025-12-08","a":"cdeb****","t":"모눈 공책 시절부터 믿고 잘 쓰던 리훈이에요. 다른 브랜드는 보지도 않고 리훈부터 찾습니다. 더 나이 먹기 전에 일기 쓰는 습관을 가져보려 삽니다. 올해 한 줄도 쓰지 못했던 것을 반성하면서 뭐라도 꾸준히 써보려 해요.","h":0,"b":false,"s":"11834410494","p":["photos/1382/62a49beb3952.jpg"]},{"r":5,"d":"2025-12-08","a":"cdeb****","t":"납작하고 커야 가지고 다니기 편하더라고요. 다른 책이나 태블릿이랑 다르게 작고 두꺼우면 혼자 돌출돼서 가방에 넣을 때 불편했는데 크기가 딱 좋습니다.","h":0,"b":false,"s":"11834410494","p":["photos/1382/0296f138dafd.jpg"]},{"r":5,"d":"2025-12-07","a":"djdu******","t":"깔끔하니 좋습니다\n평소 지출이 별로 없어서 가계부로 쓰려고 샀어요\n칸 크기가 딱 적당해서 좋네오","h":0,"b":false,"s":"11834410494","p":["photos/1382/3859c390b5de.jpg","photos/1382/70dd346e6a33.jpg"]},{"r":5,"d":"2025-12-07","a":"euny******","t":"딱 보이는 그대로 입니다. 깔끔하고 얇아서 좋아요","h":0,"b":false,"s":"11834410494","p":["photos/1382/4b22c3b3c581.jpg"]},{"r":5,"d":"2025-12-04","a":"kyun******","t":"빠른배송감사합니다 ~~^^","h":0,"b":false,"s":"11834410494"},{"r":5,"d":"2025-12-02","a":"mich***","t":"ㅋㅋ 어쩌다보니 찍혀서 걍 올렸어요\n표지질감 좋고 항상 들고다닙니다. 키보드 밑에 놓고 바로바로 일정확인후 일정 적고요 넘 좋습니다","h":0,"b":false,"s":"11834410494","p":["photos/1382/7126ec2855e4.jpg"]},{"r":5,"d":"2025-12-01","a":"nari***","t":"월별로 간단하게 중요일정들 기록하는 용도로만 사용하는편이에요\n타브랜드꺼 사용하다가 여기꺼 사봤어요\n심플하니 갠춘하네요","h":0,"b":false,"s":"11834410494","p":["photos/1382/55faba8f7d15.jpg","photos/1382/35af1ac2dedd.jpg"]},{"r":5,"d":"2025-11-30","a":"bode****","t":"원하는시간에 감사드립니다\n원하는 상태여서 좋습니다\n\n감사합니다","h":0,"b":false,"s":"11834410494","p":["photos/1382/082284d988b9.jpg"]},{"r":5,"d":"2025-11-30","a":"cds1***","t":"사진앨범으로 쓰려고 삼","h":0,"b":false,"s":"11834410494","p":["photos/1382/b6bf55034f1a.jpg"]},{"r":5,"d":"2025-11-28","a":"peac*****","t":"편리하고 좋아요굿굿굿","h":0,"b":false,"s":"11834410494"}]